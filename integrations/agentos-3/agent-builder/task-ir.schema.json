{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-foundry.invalid/schemas/task-ir/v0.1",
  "title": "Agent Foundry Typed Task IR / Task Packet",
  "description": "Typed task contract with explicit field ownership, conditional constraints, required-before milestones, and fail-closed compilation state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskPacket",
    "fieldLedger",
    "constraints",
    "compilation",
    "provenance",
    "lifecycle"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "task-ir.v0.1"
    },
    "taskPacket": {
      "$ref": "#/$defs/taskPacket"
    },
    "fieldLedger": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "constraints": {
      "$ref": "#/$defs/constraints"
    },
    "compilation": {
      "$ref": "#/$defs/compilation"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,127}$"
    },
    "requiredBefore": {
      "type": "string",
      "enum": [
        "routing",
        "seed_compile",
        "tool_use",
        "side_effect",
        "acceptance",
        "closure"
      ]
    },
    "fieldClass": {
      "type": "string",
      "enum": [
        "owner_supplied",
        "registry_resolved",
        "compiler_derived",
        "agent_discoverable",
        "prohibited_to_infer"
      ]
    },
    "fieldStatus": {
      "type": "string",
      "enum": [
        "unresolved",
        "resolved",
        "blocked",
        "superseded"
      ]
    },
    "inferencePolicy": {
      "type": "string",
      "enum": [
        "accept_owner_value",
        "resolve_registry",
        "derive_deterministically",
        "research_agent",
        "ask_owner",
        "observe_runtime",
        "must_not_infer"
      ]
    },
    "taskPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "objective",
        "scope",
        "exclusions",
        "currentState",
        "acceptanceCriteria",
        "requiredOutputs",
        "requiredEvidence",
        "preservedInvariants",
        "stopConditions",
        "escalationConditions",
        "handoff",
        "closureRequirements"
      ],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "taskId",
            "requester",
            "taskFamily"
          ],
          "properties": {
            "taskId": {
              "$ref": "#/$defs/identifier"
            },
            "requester": {
              "type": "string",
              "minLength": 1
            },
            "taskFamily": {
              "$ref": "#/$defs/identifier"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "include",
            "exclude"
          ],
          "properties": {
            "include": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "project": {
              "type": "string"
            },
            "jurisdictions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "technologies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "versions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "currentState": {
          "type": "string"
        },
        "desiredState": {
          "type": "string"
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "requiredOutputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "requiredEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "preservedInvariants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "stopConditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "escalationConditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "handoff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recipient",
            "requiredFields",
            "closure"
          ],
          "properties": {
            "recipient": {
              "$ref": "#/$defs/identifier"
            },
            "requiredFields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "closure": {
              "type": "string"
            }
          }
        },
        "closureRequirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldId",
        "name",
        "type",
        "sourceClass",
        "status",
        "requiredBefore",
        "inferencePolicy",
        "protected"
      ],
      "properties": {
        "fieldId": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "sourceClass": {
          "$ref": "#/$defs/fieldClass"
        },
        "status": {
          "$ref": "#/$defs/fieldStatus"
        },
        "requiredBefore": {
          "$ref": "#/$defs/requiredBefore"
        },
        "inferencePolicy": {
          "$ref": "#/$defs/inferencePolicy"
        },
        "protected": {
          "type": "boolean"
        },
        "value": {},
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owner": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "conditionalRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "when",
        "then"
      ],
      "properties": {
        "ruleId": {
          "$ref": "#/$defs/identifier"
        },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fieldId"
          ],
          "properties": {
            "fieldId": {
              "$ref": "#/$defs/identifier"
            },
            "equals": {},
            "notEquals": {},
            "exists": {
              "type": "boolean"
            }
          },
          "oneOf": [
            {
              "required": [
                "equals"
              ]
            },
            {
              "required": [
                "notEquals"
              ]
            },
            {
              "required": [
                "exists"
              ]
            }
          ]
        },
        "then": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requireFields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/identifier"
              }
            },
            "forbidFields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/identifier"
              }
            },
            "requireApprovals": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "forbidActions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "requireBlocks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        },
        "else": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requireFields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/identifier"
              }
            },
            "forbidFields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/identifier"
              }
            },
            "requireApprovals": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "forbidActions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "requireBlocks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        }
      }
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contradictionId",
        "leftRef",
        "rightRef",
        "status"
      ],
      "properties": {
        "contradictionId": {
          "$ref": "#/$defs/identifier"
        },
        "leftRef": {
          "type": "string"
        },
        "rightRef": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "unresolved",
            "resolved",
            "accepted_conflict",
            "rejected"
          ]
        },
        "resolution": {
          "type": "string",
          "enum": [
            "owner_decision",
            "official_precedence",
            "constraint_intersection",
            "qualified_review",
            "not_applicable"
          ]
        },
        "resolutionRef": {
          "type": "string"
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredFields",
        "forbiddenActions",
        "conditionalRules",
        "contradictions",
        "authorityCeiling"
      ],
      "properties": {
        "requiredFields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "forbiddenActions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conditionalRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conditionalRule"
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contradiction"
          }
        },
        "authorityCeiling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowedActions",
            "forbiddenActions",
            "maxContextTokens"
          ],
          "properties": {
            "allowedActions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "forbiddenActions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowedOutputPaths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "maxContextTokens": {
              "type": "integer",
              "minimum": 1
            },
            "approvalRefs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "selectedBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockId",
        "blockDigest",
        "status",
        "sourceStatus",
        "authorityEffectGrants"
      ],
      "properties": {
        "blockId": {
          "$ref": "#/$defs/identifier"
        },
        "blockDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "current",
            "stale",
            "superseded",
            "missing",
            "quarantined"
          ]
        },
        "sourceStatus": {
          "type": "string",
          "enum": [
            "current",
            "superseded",
            "withdrawn",
            "unverified",
            "unresolved"
          ]
        },
        "authorityEffectGrants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "projectedTokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "compilation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "stage",
        "selectedBlocks",
        "projectedContextTokens",
        "maxContextTokens",
        "requestedActions",
        "unresolvedFields"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "blocked",
            "compile_ready",
            "quarantined",
            "rejected"
          ]
        },
        "stage": {
          "type": "string",
          "enum": [
            "routing",
            "seed_compile",
            "tool_use",
            "side_effect",
            "acceptance",
            "closure"
          ]
        },
        "selectedBlocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selectedBlock"
          }
        },
        "projectedContextTokens": {
          "type": "integer",
          "minimum": 0
        },
        "maxContextTokens": {
          "type": "integer",
          "minimum": 1
        },
        "requestedActions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolvedFields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "constraintResolutionRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compiledAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerIntentRef",
        "sourceRefs",
        "compilerVersion",
        "taskDigest"
      ],
      "properties": {
        "ownerIntentRef": {
          "type": "string"
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "compilerVersion": {
          "type": "string"
        },
        "taskDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "derivationRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "admission",
        "activation",
        "refreshTriggers",
        "archiveConditions"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "candidate",
            "evaluated",
            "quarantined",
            "admitted",
            "suspended",
            "retired",
            "archived"
          ]
        },
        "admission": {
          "type": "string",
          "enum": [
            "not_admitted",
            "recommended",
            "admitted",
            "rejected"
          ]
        },
        "activation": {
          "type": "string",
          "enum": [
            "not_activated",
            "prepared",
            "active",
            "suspended",
            "retired"
          ]
        },
        "refreshTriggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "archiveConditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
