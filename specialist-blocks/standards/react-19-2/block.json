{
  "schema": "agentos.specialist_block.v1",
  "version": 1,
  "block_id": "specialist.standard.react-19-2",
  "revision": "1.0.0",
  "priority": "P1",
  "role_kind": "STANDARD_BLOCK",
  "family": "software-language-runtime",
  "title": "React 19.2 Runtime Authority",
  "lifecycle": "CANDIDATE",
  "activation": "OFF",
  "purpose": "Provide reusable, version-bound normalized requirements for React 19.2 Runtime Authority; do not certify applicability or compliance.",
  "scope": {
    "included": [
      "exact edition identity",
      "exceptions and supersession",
      "external applicability overlay",
      "normalized requirement mappings",
      "source/effective-date lock"
    ],
    "non_goals": [
      "automated certification",
      "consumer Product writing",
      "legal advice",
      "provider activation",
      "silently selecting a different edition"
    ],
    "smallest_sufficient_rule": "Reference this exact edition once and route unrelated or version-different authority to a separate block."
  },
  "atomic_scope_statement": "One immutable standard edition: React 19.2 Runtime Authority; no unrelated standard, jurisdiction, or certification authority.",
  "permitted_decisions": [
    "issue a typed evidence obligation",
    "map a typed requirement to the exact locked edition",
    "return NOT_APPLICABLE when the external overlay proves the standard is irrelevant",
    "return UNKNOWN when applicability or evidence is incomplete"
  ],
  "forbidden_decisions": [
    "activate, deploy, publish, or self-accept",
    "automated certification",
    "broaden into a different standard",
    "claim another edition or publisher",
    "infer jurisdiction/entity/activity/data applicability",
    "legal advice"
  ],
  "maximum_authority": "NO_PRODUCT_WRITE;_NO_CERTIFICATION;_NO_LEGAL_ADVICE;_NO_ACTIVATION;_NO_SELF_ACCEPTANCE;_TYPED_HANDOFF_ONLY",
  "required_upstream_router": null,
  "sibling_conflicts": [],
  "composition_rules": [
    "UNKNOWN closes only the dependent requirement mapping",
    "evaluate applicability only in the external overlay",
    "new edition, material erratum, or gate correction creates a new block version",
    "reuse exact ID/version/hash rather than copying requirements"
  ],
  "escalation_target": "specialist.foundation.authority-jurisdiction-gate",
  "split_required_when": [
    "edition or material erratum differs",
    "jurisdiction or applicability rule differs",
    "publisher differs",
    "requirement authority differs",
    "tool or evidence custody differs"
  ],
  "required_knowledge": [
    "React 19.2 Runtime Authority",
    "external applicability and exception overlay",
    "publisher/effective/supersession metadata",
    "versioned requirement identifiers"
  ],
  "routing": {
    "signals": [
      "React component",
      "component runtime",
      "react"
    ],
    "deny_if": [
      "certification request",
      "missing jurisdiction/entity/activity/data applicability",
      "missing publisher/version/effective identity",
      "stale or superseded source"
    ],
    "selection_rule": "SELECT_SMALLEST_SUFFICIENT_SET;_ATOMIC_SPECIALISTS_BEAT_UMBRELLA_ROUTERS"
  },
