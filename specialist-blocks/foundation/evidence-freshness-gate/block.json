  "scope": {
    "included": [
      "evidence digest binding",
      "source lock validation",
      "staleness denial"
    ],
    "non_goals": [
      "accepting an opaque citation",
      "declaring domain truth without a source",
      "refreshing external sources automatically"
    ],
