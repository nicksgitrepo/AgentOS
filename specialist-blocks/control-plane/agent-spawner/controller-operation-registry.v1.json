{
  "schema": "agentos.controller_operation_registry.v1",
  "version": 1,
  "operations": [
    {
      "event_type": "REDISTRIBUTION_RECEIVED",
      "issuer_role": "AGENT_SPAWNER",
      "adapters": [
        "dispatchRedistribution"
      ],
      "authority": "REDISTRIBUTION_DISPATCH_ONLY"
    },
    {
      "event_type": "SPAWNER_LIVENESS_RECONCILE_REQUESTED",
      "issuer_role": "AGENTOS_CONTROLLER",
      "adapters": [
        "reconcileLiveness"
      ],
      "authority": "OBSERVE_AND_RECONCILE_ONE_SPAWNER"
    },
    {
      "event_type": "SPAWNER_OBSERVE_REQUESTED",
      "issuer_role": "AGENTOS_CONTROLLER",
      "adapters": [
        "observeAgentSpawner"
      ],
      "authority": "OBSERVE_ONE_SPAWNER"
    },
    {
      "event_type": "SPAWNER_START_REQUESTED",
      "issuer_role": "AGENTOS_CONTROLLER",
      "adapters": [
        "validateControllerGovernance",
        "validateSpawnerHandoff",
        "startAgentSpawner"
      ],
      "authority": "START_EXACTLY_ONE_SPAWNER"
    },
    {
      "event_type": "SPAWNER_WAKE_REQUESTED",
