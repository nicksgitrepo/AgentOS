      "adapters": [
        "wakeAgentSpawner"
      ],
      "authority": "WAKE_EXACTLY_ONE_SPAWNER"
    }
  ],
  "forbidden_adapter_classes": [
    "ORDINARY_AGENT_LIFECYCLE",
    "ROLE_COMPILATION",
    "ROSTER_MUTATION",
    "SEED_LIFECYCLE",
    "HANDOFF_APPROVAL"
