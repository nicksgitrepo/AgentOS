{
  "schema": "agentos.atomic_specialist_inventory.v1",
  "version": 1,
  "status": "PLANNED_ATOMIC_BACKLOG",
  "activation": "OFF",
  "atomicity_rule": "Routers classify and assemble context only. Atomic specialists own one narrow failure mode or evidence domain. Control-plane blocks own governance mechanics. None may self-admit or receive Product-writing authority from a family label.",
  "source_lock_rule": "Every atomic package owns a sources.lock containing publisher, identifier, version, effective/publication/supersession status, scope, retrieved date, immutable identity, and content digest when obtainable.",
  "atomic_defaults": {
    "role_kind": "ATOMIC_SPECIALIST",
    "lifecycle": "PLANNED",
    "gate_status": "PLANNED",
    "package_status": "UNPACKAGED",
    "evaluator_status": "NOT_RUN",
    "maximum_authority": "ADVISORY_ANALYSIS_AND_TYPED_HANDOFF_ONLY;_NO_PRODUCT_WRITE;_NO_ACCEPTANCE;_NO_CERTIFICATION_OR_LEGAL_ADVICE",
    "permitted_decisions": [
      "classify the named atomic concern",
      "return evidence-bounded findings",
      "return NOT_APPLICABLE when the atomic concern is absent",
      "escalate missing authority or conflicting evidence"
    ],
    "forbidden_decisions": [
      "broaden to a family or sibling concern",
      "write Product or consumer state",
      "self-admit or accept a release",
      "claim another provider, standard, or version",
      "invent missing evidence"
    ],
    "composition_rules": [
      "must be selected by the required upstream router",
      "compose only with explicitly named sibling blocks",
      "select the smallest sufficient atomic set",
      "UNKNOWN closes only the dependent action"
    ],
    "escalation_target": "specialist.foundation.evaluation-admission-gate",
    "split_required_when": [
      "required knowledge differs",
      "authority or source lock differs",
      "tool/data custody differs",
      "failure mode differs",
      "provider or standard version differs"
    ]
  },
