    "global_governance_bootstrap_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compact_model_policy": {"type": "object", "additionalProperties": false, "required": ["model_id", "reasoning_effort", "capability_floor", "context_floor_tokens", "input_usd_per_million", "output_usd_per_million", "max_concurrency", "max_heavyweight_processes", "fallback_models", "escalation_triggers"], "properties": {"model_id": {"type": "string"}, "reasoning_effort": {"type": "string"}, "capability_floor": {"type": "number"}, "context_floor_tokens": {"type": "integer"}, "input_usd_per_million": {"type": "number"}, "output_usd_per_million": {"type": "number"}, "max_concurrency": {"type": "integer"}, "max_heavyweight_processes": {"type": "integer"}, "fallback_models": {"type": "array"}, "escalation_triggers": {"type": "array"}}},
