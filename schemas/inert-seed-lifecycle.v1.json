{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.inert_seed_lifecycle.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "seed_id", "state", "immutable", "work_authority", "execution_authority", "network_authority", "mutation_authority", "admission_sha256", "context_sha256", "roster_sha256", "model_policy_snapshot_sha256", "model_policy_projection_sha256", "global_governance_ledger_head_sha256", "global_governance_bootstrap_sha256", "compact_model_policy", "predecessor_seed_sha256", "created_at_utc", "invalidated_at_utc", "invalidation_reason", "allowed_transitions", "seed_sha256"],
