{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.layered_governance_contract.v1",
  "title": "AgentOS layered governance contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "project_id",
    "project_contract_sha256",
    "layer_order",
    "precedence_rule",
    "library_digests",
    "migration",
    "activation",
    "digest"
  ],
  "properties": {
    "schema": {"const": "agentos.layered_governance_contract.v1"},
    "version": {"const": 1},
    "status": {"enum": ["PREPARED_NOT_ACTIVATED", "ACTIVE"]},
    "project_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]*$"},
    "project_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "layer_order": {
      "const": ["SHARED_GENERAL", "BASE_ROLE", "PERSISTENT_PROJECT", "GENERATED_TASK_ROLE"]
    },
    "precedence_rule": {
      "const": "MORE_SPECIFIC_PROJECT_AUTHORITY_MAY_ADD_RESTRICTIONS_ONLY"
    },
    "library_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_general", "base_role", "project_general", "generated_project_role"],
      "properties": {
        "base_general": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "base_role": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "project_general": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "generated_project_role": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controller", "modes", "source_preserved", "old_binding_remains_active_until_checked"],
      "properties": {
        "controller": {"const": "control/four-library-operations.mjs"},
        "modes": {
          "const": ["KEEP_PROJECT_GOVERNANCE", "RESET_GOVERNANCE_CLEAN"]
        },
        "source_preserved": {"const": true},
        "old_binding_remains_active_until_checked": {"const": true}
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "owner_decision_required", "independent_check_required"],
      "properties": {
        "active": {"type": "boolean"},
        "owner_decision_required": {"const": true},
        "independent_check_required": {"const": true}
      }
    },
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

