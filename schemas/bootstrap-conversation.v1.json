{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.bootstrap_conversation.v1",
  "title": "AgentOS Bootstrap conversation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "project_ref",
    "question_map",
    "answers",
    "answer_order",
    "reassessment_required",
    "prior_contract_sha256",
    "disposition",
    "disposition_reason",
    "next_action",
    "session_sha256"
  ],
  "properties": {
    "schema": {"const": "agentos.bootstrap_conversation.v1"},
    "version": {"const": 1},
    "status": {"enum": ["QUESTION_PENDING", "READY_FOR_CONTRACT"]},
    "project_ref": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
    "question_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "questions", "map_sha256"],
      "properties": {
        "schema": {"const": "agentos.bootstrap_question_map.v1"},
        "version": {"const": 1},
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "prompt", "choices", "required", "default_value"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"},
              "kind": {"enum": ["TEXT", "BOOLEAN", "CHOICE"]},
              "prompt": {"type": "string", "minLength": 2, "maxLength": 160},
              "choices": {
                "type": "array",
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["value", "label"],
                  "properties": {
                    "value": {},
                    "label": {"type": "string", "minLength": 2, "maxLength": 120}
                  }
                }
              },
              "required": {"type": "boolean"},
              "default_value": {}
            }
          }
        },
        "map_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "answers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "version", "question_id", "value", "certainty", "provenance", "answer_sha256"],
        "properties": {
          "schema": {"const": "agentos.bootstrap_answer.v1"},
          "version": {"const": 1},
          "question_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"},
          "value": {},
          "certainty": {"enum": ["CONFIRMED", "INFERRED", "RECOMMENDED", "UNKNOWN"]},
          "provenance": {"enum": ["OWNER", "DISCOVERY", "COMPILER", "UNRESOLVED_OWNER"]},
          "answer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "answer_order": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"}},
    "reassessment_required": {"type": "boolean"},
    "prior_contract_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "disposition": {"enum": ["ACTIVE", "UNAVAILABLE", "HARD_STOP"]},
    "disposition_reason": {"type": ["string", "null"], "maxLength": 500},
    "next_action": {"type": "string", "pattern": "^[A-Z][A-Z0-9_:-]{1,95}$"},
    "session_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
