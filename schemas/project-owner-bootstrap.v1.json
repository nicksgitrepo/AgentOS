{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.project_owner_bootstrap.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "authority_status", "status", "agentos_home_ref", "sibling_project_refs", "environment_summary_ref", "discovery_complete", "interview_complete", "bootstrap_role_before", "bootstrap_role_after", "bootstrap_sequence", "owner_display_name", "human_facing_role", "default_explanation_level", "spawner_start_request_template_sha256", "spawner_start_receipt_ref", "bootstrap_may_spawn_again", "spawner_roster_request", "development_workflow", "project_owner_monitor_minutes", "controller_progress_monitor_minutes", "bootstrap_sha256"],
  "properties": {
    "schema": {"const": "agentos.project_owner_bootstrap.v1"}, "version": {"const": 1},
    "authority_status": {"const": "NON_AUTHORITATIVE_PLAN"},
    "status": {"enum": ["WAITING_FOR_WORKFLOW_CHOICE", "READY_FOR_GOVERNED_BOOTSTRAP_EXECUTION"]},
    "agentos_home_ref": {"type": "string", "pattern": "^opaque:agentos-home:"},
    "sibling_project_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^opaque:sibling-project:"}},
    "environment_summary_ref": {"type": "string", "pattern": "^opaque:environment:"},
    "discovery_complete": {"const": true}, "interview_complete": {"const": true},
    "bootstrap_role_before": {"const": "AGENTOS.BOOTSTRAP"}, "bootstrap_role_after": {"const": "AGENTOS.PRODUCT_OWNER"},
    "bootstrap_sequence": {"const": ["DISCOVERY_AND_INTERVIEW_COMPLETE", "START_EXACTLY_ONE_SPAWNER", "REQUEST_PERMANENT_ROSTER_FROM_SPAWNER", "TRANSITION_BOOTSTRAP_TO_PRODUCT_OWNER"]},
    "owner_display_name": {"type": "string", "minLength": 15}, "human_facing_role": {"const": "AGENTOS.PRODUCT_OWNER"}, "default_explanation_level": {"const": "SIMPLE"},
    "spawner_start_request_template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "spawner_start_receipt_ref": {"type": "null"}, "bootstrap_may_spawn_again": {"const": false},
    "spawner_roster_request": {
      "type": "object", "additionalProperties": false,
      "required": ["existing_roles", "requested_roles", "bootstrap_transitions_to_product_owner_after_request", "exactly_one_spawner", "creation_authority", "ordinary_agent_spawn_authority", "all_despawn_authority"],
      "properties": {
        "existing_roles": {"const": ["AGENTOS.BOOTSTRAP", "AGENTOS.SPAWNER"]},
        "requested_roles": {"const": ["AGENTOS_CONTROLLER", "AGENTOS.MEMORY", "AGENTOS.ORCHESTRATOR", "AGENTOS.RUNTIME", "AGENTOS.SCHEDULER"]},
        "bootstrap_transitions_to_product_owner_after_request": {"const": true}, "exactly_one_spawner": {"const": true},
        "creation_authority": {"const": "AGENTOS.SPAWNER"}, "ordinary_agent_spawn_authority": {"const": "AGENTOS.SPAWNER"}, "all_despawn_authority": {"const": "AGENTOS.SPAWNER"}
      }
    }, "development_workflow": {"type": ["string", "null"], "enum": ["PYRAMID", "COLLABORATIVE_AUDIT", null]},
    "project_owner_monitor_minutes": {"const": 15}, "controller_progress_monitor_minutes": {"const": 15}, "bootstrap_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
