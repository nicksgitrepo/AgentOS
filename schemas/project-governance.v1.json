{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.project_governance.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "project_id", "source_revision", "graph_bindings", "default_graph_ids", "role_overlays", "digest"],
  "properties": {
    "schema": { "const": "agentos.project_governance.v1" },
    "version": { "const": 1 },
    "status": { "const": "PREPARED_NOT_ACTIVATED" },
    "project_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9._:-]*$" },
    "source_revision": { "type": "string", "minLength": 1 },
    "graph_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["graph_id", "path", "graph_sha256"],
        "properties": {
          "graph_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9._:-]*$" },
          "path": { "type": "string", "minLength": 1 },
          "graph_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "default_graph_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "role_overlays": { "type": "array", "items": { "type": "object" } },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
