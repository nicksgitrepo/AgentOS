{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.liveness_sentinel.v1",
  "type": "object",
  "required": ["schema", "version", "state", "classification", "signature", "duplicate", "lifecycle_action_taken", "custody_mutated"],
  "properties": {
    "schema": {"const": "agentos.liveness_sentinel.v1"},
    "version": {"const": 1},
    "state": {"enum": ["ACTIVE_MONITORING", "QUIESCENT"]},
    "classification": {"type": "string"},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "duplicate": {"type": "boolean"},
    "lifecycle_action_taken": {"const": false},
    "custody_mutated": {"const": false},
    "projection_liveness": {"$ref": "#/$defs/projectionLiveness"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "projectionLiveness": {
      "type": "object",
      "required": ["schema", "version", "task_id", "lane_id", "projection", "sources", "source_state", "signals", "recovery", "classification", "stalled", "replacement_allowed", "receipt_sha256"],
      "properties": {
        "schema": {"const": "agentos.scheduler_projection_liveness.v1"},
        "version": {"const": 1},
        "task_id": {"type": "string", "minLength": 1},
        "lane_id": {"type": "string", "minLength": 1},
        "projection": {"type": "object", "required": ["items", "items_count"], "properties": {"items": {"type": "array"}, "items_count": {"type": "integer", "minimum": 0}}},
        "sources": {"type": "object", "required": ["durable_session", "receipts", "results", "processes", "leases"]},
        "source_state": {"type": "object", "required": ["durable_ordinal", "durable_mtime_key", "durable_activity_sha256", "source_state_sha256"]},
        "signals": {"type": "object"},
        "recovery": {"type": "object", "required": ["attempt", "maximum_attempts", "bounded", "same_task_only"]},
        "classification": {"enum": ["ACTIVE_OR_PROJECTION_LAG", "MATERIAL_LIVENESS_ACTIVE", "SAME_TASK_RECOVERY_REQUIRED", "MATERIAL_LIVENESS_STAGNANT"]},
        "stalled": {"type": "boolean"},
        "replacement_allowed": {"const": false},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": true
    },
    "permanentSessionRollover": {
      "type": "object",
      "required": ["schema", "version", "status", "task_id", "role_id", "old_session", "old_session_sha256", "successor_session", "successor_session_sha256", "supersedes_session_id", "successor_session_id", "continuity", "continuity_sha256", "retained_old_session", "exactly_one_successor", "rollover_sha256"],
      "properties": {
        "schema": {"const": "agentos.permanent_session_rollover.v1"},
        "version": {"const": 1},
        "status": {"const": "ROLLOVER_ADMITTED"},
        "task_id": {"type": "string", "minLength": 1},
        "role_id": {"type": "string", "minLength": 1},
        "old_session": {"type": "object"},
        "old_session_sha256": {"$ref": "#/$defs/sha256"},
        "successor_session": {"type": "object"},
        "successor_session_sha256": {"$ref": "#/$defs/sha256"},
        "supersedes_session_id": {"type": "string", "minLength": 1},
        "successor_session_id": {"type": "string", "minLength": 1},
        "continuity": {"type": "object", "required": ["queue", "custody", "incident", "stopping_point", "owner"]},
        "continuity_sha256": {"$ref": "#/$defs/sha256"},
        "retained_old_session": {"const": true},
        "exactly_one_successor": {"const": true},
        "rollover_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
