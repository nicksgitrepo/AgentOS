{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/specialist-proof-matrix.v1.json",
  "title": "AgentOS Generated Proof Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "package_hash", "rows", "acceptance_authority", "unknown_rule"],
  "properties": {
    "schema": {"const": "agentos.proof_matrix.v1"},
    "version": {"const": 1},
    "package_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rows": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["row_id", "block_id", "requirement", "evidence", "acceptance", "dependent_action", "outcome"], "properties": {"row_id": {"type": "string", "minLength": 1}, "block_id": {"type": "string", "minLength": 1}, "requirement": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "acceptance": {"const": "INDEPENDENT_AUTHORITY_ONLY"}, "dependent_action": {"type": "string", "minLength": 1}, "outcome": {"enum": ["YES", "NO", "UNKNOWN", "NOT_APPLICABLE"]}}}, "minItems": 1},
    "acceptance_authority": {"const": "INDEPENDENT_AUTHORITY_ONLY"},
    "unknown_rule": {"const": "UNKNOWN_CLOSES_ONLY_DEPENDENT_ACTION;_UNRELATED_WORK_CONTINUES"}
  }
}
