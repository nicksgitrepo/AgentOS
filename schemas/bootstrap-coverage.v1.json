{
  "schema": "agentos.bootstrap_coverage_contract.v1",
  "version": 1,
  "governance_version": "2.1rc",
  "status": "PREPARED_NOT_ACTIVATED",
  "purpose": "Keep every material Bootstrap creation, trust, data, delivery-target, life-contract, boundary, recovery, and activation obligation visible without turning derived outputs into extra user questions.",
  "controller": "control/bootstrap-coverage.mjs",
  "coverage_result": "agentos.bootstrap_coverage.v1",
  "question_rule": "Ask only the earliest material gap that cannot be settled by exact discovery, a portable safe default, derivation from already bound intent, or an existing owner input.",
  "answer_boundary": "Coverage status is separate from Product question answer values and from execution lifecycle. A coverage row may be OWNER_REQUIRED while its question has no answer, and it may be DERIVED or DEFAULTED without asking a new question.",
  "status_values": [
    "DISCOVERED",
    "OWNER_CONFIRMED",
    "DEFAULTED",
    "DERIVED",
    "DEFERRED_NONBLOCKING",
    "NOT_APPLICABLE_WITH_PROOF",
    "OWNER_REQUIRED",
    "DEPENDENCY_PENDING",
    "CONFLICT"
  ],
  "blocking_statuses": ["OWNER_REQUIRED", "DEPENDENCY_PENDING", "CONFLICT"],
  "source_kinds": [
    "DISCOVERY",
    "OWNER_INPUT",
    "PORTABLE_DEFAULT",
    "DERIVED_OUTPUT",
    "NOT_APPLICABLE_PROOF",
    "DEPENDENCY",
    "UNRESOLVED_OWNER_BOUNDARY"
  ],
  "row_required_fields": [
    "output_id",
    "category",
    "required",
    "applicability",
    "source_kind",
    "source_refs",
    "discovery_inputs",
    "status",
    "safe_default",
    "probe_required",
    "owner_decision_required",
    "unavailable_behavior",
    "reopen_triggers",
    "dependency_output_ids",
    "question_ids",
    "compiled_field_paths",
    "blocking",
    "reason"
  ],
  "required_output_groups": [
    "PROJECT_DEFINITION",
    "PROJECT_IMPORT",
    "SOURCE_PRESERVATION",
    "NORMALIZATION_POLICY",
    "STANDARDS_REGISTRY",
    "NORTH_STAR",
    "FIRST_USEFUL_WORKFLOW",
    "PROJECT_LIFE_CONTRACT",
    "FUNCTION_REQUIREMENTS",
    "TECHNICAL_BASELINE",
    "DELIVERY_POLICY",
    "DELIVERY_TARGET",
    "DESIGN_BIBLE",
    "SECURITY_BASELINE",
    "AUTHORITY_BOUNDARIES",
    "BOUNDARY_CONTRACT",
    "AUTHORITY_CORPUS",
    "MODEL_POLICY",
    "GLOBAL_POLICY_STATE",
    "OWNER_REVIEW",
    "PERSISTENT_RUNTIME",
    "FIRST_CAMPAIGN",
    "EXACT_CREATION_PLAN"
  ],
  "coverage_outputs": [
    {"output_id": "DISCOVERY_PERMISSION", "category": "TRUST", "question_ids": ["bootstrap.discovery.mode"]},
    {"output_id": "PROJECT_DEFINITION", "category": "CREATION", "question_ids": ["project.boundary"]},
    {"output_id": "PROJECT_IMPORT", "category": "CREATION", "question_ids": ["project.import"], "applicability": "CONDITIONAL"},
    {"output_id": "SOURCE_PRESERVATION", "category": "RECOVERY", "question_ids": [], "applicability": "CONDITIONAL"},
    {"output_id": "NORMALIZATION_POLICY", "category": "CREATION", "question_ids": []},
    {"output_id": "STANDARDS_REGISTRY", "category": "TRUST", "question_ids": []},
    {"output_id": "NORTH_STAR", "category": "INTENT", "question_ids": ["project.north_star"]},
    {"output_id": "FIRST_USEFUL_WORKFLOW", "category": "INTENT", "question_ids": ["project.first_workflow"]},
    {"output_id": "PROJECT_LIFE_CONTRACT", "category": "INTENT", "question_ids": ["project.life_contract"]},
    {"output_id": "AUTHORITY_BOUNDARIES", "category": "TRUST", "question_ids": ["project.protected_boundaries"]},
    {"output_id": "AUTHORITY_CORPUS", "category": "CREATION", "question_ids": ["authority-corpus.source"]},
    {"output_id": "DESIGN_BIBLE", "category": "PRODUCT_PROOF", "question_ids": ["project.design"], "applicability": "CONDITIONAL"},
    {"output_id": "SECURITY_BASELINE", "category": "TRUST", "question_ids": []},
    {"output_id": "TECHNICAL_BASELINE", "category": "CREATION", "question_ids": ["project.technical_baseline"]},
    {"output_id": "DATA_AND_MIGRATION_POLICY", "category": "DATA", "question_ids": ["project.technical_baseline"], "applicability": "CONDITIONAL"},
    {"output_id": "AUTHENTICATION_AND_ACCESS", "category": "TRUST", "question_ids": ["project.technical_baseline"], "applicability": "CONDITIONAL"},
    {"output_id": "DELIVERY_POLICY", "category": "DELIVERY", "question_ids": ["project.delivery_policy"]},
    {"output_id": "DELIVERY_TARGET", "category": "DELIVERY", "question_ids": []},
    {"output_id": "BOUNDARY_CONTRACT", "category": "TRUST", "question_ids": []},
    {"output_id": "DELIVERY_PROBES", "category": "DELIVERY", "question_ids": []},
    {"output_id": "MODEL_POLICY", "category": "CREATION", "question_ids": ["project.model_economics"]},
    {"output_id": "GLOBAL_POLICY_STATE", "category": "TRUST", "question_ids": []},
    {"output_id": "OWNER_REVIEW", "category": "INTENT", "question_ids": ["review.user_review_mode"]},
    {"output_id": "PERSISTENT_RUNTIME", "category": "RUNTIME", "question_ids": ["project.runtime"]},
    {"output_id": "FUNCTION_REQUIREMENTS", "category": "PRODUCT_PROOF", "question_ids": []},
    {"output_id": "FIRST_CAMPAIGN", "category": "CAMPAIGN", "question_ids": []},
    {"output_id": "RECOVERY_AND_ROLLBACK", "category": "RECOVERY", "question_ids": []},
    {"output_id": "OBSERVABILITY_AND_RETENTION", "category": "RECOVERY", "question_ids": []},
    {"output_id": "LEGACY_PRESERVATION", "category": "RECOVERY", "question_ids": [], "applicability": "CONDITIONAL"},
    {"output_id": "BOOTSTRAP_PROOF", "category": "TRUST", "question_ids": []},
    {"output_id": "PROJECT_CONTEXT_SEPARATION", "category": "TRUST", "question_ids": []},
    {"output_id": "ACTIVATION_BOUNDARY", "category": "TRUST", "question_ids": []},
    {"output_id": "EXACT_CREATION_PLAN", "category": "CREATION", "question_ids": []}
  ],
  "binding": {
    "discovery": "coverage.discovery_digest_sha256 must equal the exact plan discovery digest",
    "answers": "coverage.answers_sha256 must equal the canonical normalized Bootstrap answers digest",
    "plan": "exact_creation_plan.bootstrap_coverage_sha256 must equal coverage.coverage_sha256",
    "context": "typed project context carries the complete coverage result and its digest",
    "readiness": "READY_TO_COMPILE is valid only when material_gaps is empty; a partial or merely absent row cannot be approved"
  },
  "extension_boundary": "Project-specific extensions may add stricter rows and facts, but cannot remove a portable output, change blocking semantics, weaken unavailable behavior, or replace the canonical controller."
}
