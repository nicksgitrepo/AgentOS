{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.spawner_external_review_consumption_head.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "binding_sha256", "sequence", "head_event_sha256", "ledger_sha256"],
  "properties": {
    "schema": {"enum": ["agentos.spawner_external_review_consumption_head.v1", "agentos.spawner_external_review_global_consumption.v1"]},
    "version": {"const": 1},
    "binding_sha256": {"$ref": "#/$defs/sha"},
    "sequence": {"type": "integer", "minimum": 1},
    "head_event_sha256": {"$ref": "#/$defs/sha"},
    "ledger_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
