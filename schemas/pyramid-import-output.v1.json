{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/pyramid-import-output.v1.json",
  "title": "AgentOS Pyramid Import Output",
  "description": "The source-preserving output of a project audit/repair pyramid. It names clean candidate repositories, preserves the old repositories as untouched legacy evidence, and prepares—but never performs—the Git repoint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "project_id", "status", "legacy", "source_coverage", "candidate_repositories", "pyramid", "git_repoint", "output_sha256"],
  "properties": {
    "schema": {"const": "agentos.pyramid_import_output.v1"},
    "version": {"const": 1},
    "project_id": {"$ref": "#/$defs/projectId"},
    "status": {"enum": ["READY_FOR_GIT_REPOINT", "GIT_REPOINTED"]},
    "legacy": {"$ref": "#/$defs/legacy"},
    "source_coverage": {"$ref": "#/$defs/sourceCoverage"},
    "candidate_repositories": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidateRepository"}},
    "pyramid": {"$ref": "#/$defs/pyramid"},
    "git_repoint": {"$ref": "#/$defs/gitRepoint"},
    "output_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "reference": {"type": "string", "pattern": "^(opaque:|ref:)[A-Za-z0-9._:/-]+$"},
    "projectId": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"},
    "repositoryId": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,191}$"},
    "legacy": {
      "type": "object", "additionalProperties": false,
      "required": ["source_root_ref", "source_commit", "source_tree", "source_content_sha256", "source_observation_sha256", "preservation_ref", "preservation_receipt_sha256", "immutable", "untouched", "read_only", "retention"],
      "properties": {
        "source_root_ref": {"$ref": "#/$defs/reference"},
        "source_commit": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/gitObject"}]},
        "source_tree": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/gitObject"}]},
        "source_content_sha256": {"$ref": "#/$defs/sha256"},
        "source_observation_sha256": {"$ref": "#/$defs/sha256"},
        "preservation_ref": {"$ref": "#/$defs/reference"},
        "preservation_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "immutable": {"const": true},
        "untouched": {"const": true},
        "read_only": {"const": true},
        "retention": {"const": "LEGACY_REPOSITORY_UNTOUCHED"}
      }
    },
    "candidateRepository": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_id", "source_repository_ids", "repository_ref", "branch_ref", "commit", "tree", "candidate_sha256", "source_content_sha256", "source_observation_sha256", "pyramid_candidate_sha256", "rollback_ref", "clean", "status"],
      "properties": {
        "repository_id": {"$ref": "#/$defs/repositoryId"},
        "source_repository_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/repositoryId"}, "uniqueItems": true},
        "repository_ref": {"$ref": "#/$defs/reference"},
        "branch_ref": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "commit": {"$ref": "#/$defs/gitObject"},
        "tree": {"$ref": "#/$defs/gitObject"},
        "candidate_sha256": {"$ref": "#/$defs/sha256"},
        "source_content_sha256": {"$ref": "#/$defs/sha256"},
        "source_observation_sha256": {"$ref": "#/$defs/sha256"},
        "pyramid_candidate_sha256": {"$ref": "#/$defs/sha256"},
        "rollback_ref": {"$ref": "#/$defs/reference"},
        "clean": {"const": true},
        "status": {"const": "INDEPENDENT_REAUDITED_CANDIDATE"}
      }
    },
    "sourceCoverage": {
      "type": "object", "additionalProperties": false,
      "required": ["required_repository_ids", "candidate_source_repository_ids", "opaque_exclusion_repository_ids", "source_mapping_sha256", "coverage_sha256"],
      "properties": {
        "required_repository_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/repositoryId"}, "uniqueItems": true},
        "candidate_source_repository_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/repositoryId"}, "uniqueItems": true},
        "opaque_exclusion_repository_ids": {"type": "array", "items": {"$ref": "#/$defs/repositoryId"}, "uniqueItems": true},
        "source_mapping_sha256": {"$ref": "#/$defs/sha256"},
        "coverage_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "pyramid": {
      "type": "object", "additionalProperties": false,
      "required": ["specialist_audit_repair_sha256", "platform_review_sha256", "central_integration_sha256", "independent_reaudit_sha256", "audit_repair_complete", "platform_review_complete", "central_integration_complete", "independent_reaudit_complete", "wave_count"],
      "properties": {
        "specialist_audit_repair_sha256": {"$ref": "#/$defs/sha256"},
        "platform_review_sha256": {"$ref": "#/$defs/sha256"},
        "central_integration_sha256": {"$ref": "#/$defs/sha256"},
        "independent_reaudit_sha256": {"$ref": "#/$defs/sha256"},
        "audit_repair_complete": {"const": true},
        "platform_review_complete": {"const": true},
        "central_integration_complete": {"const": true},
        "independent_reaudit_complete": {"const": true},
        "wave_count": {"type": "integer", "minimum": 1}
      }
    },
    "gitRepoint": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "operation", "target_repository_ids", "legacy_policy", "source_recheck_required", "candidate_recheck_required", "rollback_receipt_required", "legacy_delete_forbidden", "source_mutation_forbidden", "destructive_work_forbidden", "authorization_ref", "rollback_ref", "next_action"],
      "properties": {
        "status": {"enum": ["READY_FOR_PROTECTED_CUTOVER", "AUTHORIZED_PENDING_RUNTIME_EXECUTION", "EXECUTED"]},
        "operation": {"const": "ATOMIC_REPOINT_PROJECT_GIT_TO_NEW_REPOSITORIES"},
        "target_repository_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/repositoryId"}},
        "legacy_policy": {"const": "RETAIN_LEGACY_REPOSITORIES_UNTOUCHED"},
        "source_recheck_required": {"const": true},
        "candidate_recheck_required": {"const": true},
        "rollback_receipt_required": {"const": true},
        "legacy_delete_forbidden": {"const": true},
        "source_mutation_forbidden": {"const": true},
        "destructive_work_forbidden": {"const": true},
        "authorization_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reference"}]},
        "rollback_ref": {"$ref": "#/$defs/reference"},
        "next_action": {"enum": ["WAIT_FOR_GIT_REPOINT_AUTHORIZATION", "RUNTIME_ATOMIC_GIT_REPOINT", "GIT_REPOINT_COMPLETE"]}
      }
    }
  }
}
