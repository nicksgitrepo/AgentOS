{
  "schema": "governance.dynamic_bootstrap_contract.v1",
  "version": 1,
  "status": "RETAINED_COMPATIBILITY_DISCOVERY_ONLY_NOT_SETUP_AUTHORITY",
  "bootstrap_role": {
    "display_name": "Bootstrap 2.1rc",
    "mode": "USER_FACING_RESUMABLE_CONFIGURATOR",
    "question_cardinality": 1,
    "discovery_before_questions": true,
    "ask_discoverable_facts": false
  },
  "separation": {
    "governance_kernel": "STABLE_PORTABLE_BEHAVIOR",
    "project_configuration": "MUTABLE_USER_PREFERENCES_AND_ENVIRONMENT_BINDINGS",
    "project_context": "PRODUCT_GOALS_FEATURES_ARCHITECTURE_AND_TERMINOLOGY",
    "campaign_state": "WORK_IN_PROGRESS_AND_CURRENT_HANDOFF",
    "release_snapshot": "IMMUTABLE_CONFIGURATION_AND_CONTEXT_IDENTITY"
  },
  "authority_corpus_choices": [
    "IMPORT",
    "REFACTOR_PREVIOUS_GOVERNANCE",
    "CREATE_NEW"
  ],
  "design_bible_choices": [
    "IMPORT",
    "REFACTOR_PREVIOUS_GOVERNANCE",
    "CREATE_NEW",
    "DEFER_WITH_EXPLICIT_UNAVAILABLE_STATE"
  ],
  "preference_provenance": [
    "DETECTED",
    "RECOMMENDED",
    "USER_SELECTED",
    "IMPORTED"
  ],
  "change_effects": [
    "IMMEDIATE",
    "NEXT_HANDOFF",
    "NEXT_CAMPAIGN",
    "REQUIRES_MIGRATION",
    "OWNER_CONFIRMATION"
  ],
  "discovery": {
    "root_containment": "CANONICAL_PROJECT_ROOT_NO_SYMLINK_ESCAPE",
    "repository_boundary": "GIT_TOP_LEVEL_MUST_EQUAL_ADMITTED_PROJECT_ROOT",
    "detected_sources": "READ_ONLY_CANDIDATES_NEVER_AUTOMATIC_USER_CHOICES",
    "states": [
      "TOOL_INSTALLED",
      "CREDENTIAL_MATERIAL_PRESENT_UNREAD",
      "AUTHENTICATED_IDENTITY_VERIFIED",
      "REQUIRED_PERMISSION_VERIFIED"
    ],
    "secret_retention": "FORBIDDEN",
    "remote_url": "REJECT_CREDENTIAL_QUERY_OR_FRAGMENT_MATERIAL; NORMALIZE_STANDARD_GIT_SSH_WITHOUT_USERINFO",
    "provider_check": "READ_ONLY_COMMON_FIXED_COMMAND_ALLOWLIST_PLUS_TYPED_USER_PROVIDER_LIST"
  },
  "question_flow": {
    "one_at_a_time": true,
    "card_fields": [
      "question_id",
      "detected_fact",
      "prompt",
      "recommended_choice",
      "choices",
      "answer_type",
      "allow_custom",
      "consequences"
    ],
    "skip_known_or_irrelevant": true,
    "checkpoint_after_answer": true,
    "choice_provenance": "TYPED_PREFERENCE_WITH_ACTOR_UTC_CONFIDENCE_EFFECT_AND_REVALIDATION",
    "resume": "NEXT_UNRESOLVED_QUESTION"
  },
  "configuration_groups": [
    "project",
    "authority_corpus",
    "design_bible",
    "version_control",
    "models",
    "agents",
    "evidence",
    "hosting",
    "workflow"
  ],
  "minimum_question_variables": [
    "project_name",
    "authority_corpus_choice",
    "authority_corpus_source",
    "versioning",
    "version_control_providers",
    "repository_visibility",
    "merge_strategy",
    "release_strategy",
    "authority_location",
    "authority_relative_path",
    "deployment_enabled",
    "deployment_mode",
    "deployment_providers",
    "evidence_retention_days",
    "orchestrator_model_policy",
    "specialist_model_policy",
    "pin_campaign_agents",
    "archive_completed_agents",
    "campaign_topology_default",
    "progress_interval_minutes",
    "design_bible_choice",
    "design_bible_source"
  ],
  "preference_schema": {
    "value_type": "STABLE_PER_GROUP_AND_KEY",
    "type_change": "REQUIRES_SEPARATELY_ADMITTED_SCHEMA_MIGRATION"
  },
  "provider_auth": {
    "choices": [
      "CONFIGURE_NOW",
      "SKIP_PROVIDER",
      "CHANGE_PROVIDER"
    ],
    "browser": "CONFIGURATION_SNAPSHOT_SELECTED",
    "persisted_url": "PUBLIC_HTTPS_ORIGIN_AND_PATH_ONLY",
    "sensitive_link": "RUNTIME_ONLY",
    "resume": "SAME_BOOTSTRAP_GOAL_AFTER_IDENTITY_AND_PERMISSION_CHECK"
  },
  "setup_execution": {
    "normative_controller": "control/guided-bootstrap.mjs",
    "legacy_controller_authority": "DISCOVERY_PREFERENCE_HISTORY_AND_SNAPSHOT_COMPATIBILITY_ONLY",
    "sole_writer": "BOUND_BOOTSTRAP_SESSION",
    "separate_authority_corpus_worker": false,
    "separate_design_bible_worker": false,
    "separate_intent_worker": false,
    "phase_outputs": "APPEND_ONLY_VERIFIED_CONTENT_ADDRESSED",
    "optional_guidance": "CHATGPT_MARKDOWN_PROMPT_PLUS_CANONICAL_JSON_NO_CUSTODY",
    "independent_audit": "DISTINCT_FRESH_PINNED_AUDITOR_PLUS_REPORT_SHA256_AFTER_FINDINGS_RECONCILIATION",
    "launch": "OWNER_PROCEED_THEN_MODEL_RESOLVED_FIRST_AUDITOR_ACTIVE_PROOF_THEN_BOOTSTRAP_UNPIN"
  },
  "history": {
    "current_preferences_mutable": true,
    "preference_history": "APPEND_ONLY_CANONICAL_SHA256_CHAIN",
    "sealed_campaign_snapshots_mutable": false,
    "sealed_release_snapshots_mutable": false,
    "snapshot_transition": "APPEND_ONLY_PREFIX_PRESERVED_UNIQUE_RELEASE_MONOTONIC_TIME",
    "snapshot_evidence": "DISTINCT_BOOTSTRAP_AND_AUDITOR_SESSION_IDENTITIES_PLUS_PHASE_OUTPUT_AND_REPORT_DIGESTS_OR_EXPLICIT_DESIGN_DEFER",
    "snapshot_digest": "CANONICAL_JSON_SHA256",
    "raw_evidence_destination": "RELEASE_EVIDENCE_LIBRARY"
  },
  "external_mutation_boundary": {
    "confirmation_required": [
      "PUBLIC_REPOSITORY",
      "REMOTE_REPOSITORY_CREATION",
      "PAID_RESOURCE",
      "DNS_OR_ROUTING_CHANGE",
      "PRODUCTION_ACTION",
      "DESTRUCTIVE_ACTION",
      "CREDENTIAL_OR_PRIVATE_DATA_ACTION"
    ],
    "preview_before_confirmation": true
  }
}
