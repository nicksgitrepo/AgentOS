{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.model_policy_snapshot.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "project_agnostic", "visibility", "contains_consumer_context", "raw_browsing_transcripts", "observed_at_utc", "expires_at_utc", "evidence", "conflicts", "models", "task_classes", "snapshot_sha256"],
  "properties": {
    "schema": {"const": "agentos.model_policy_snapshot.v1"},
    "version": {"const": 1},
    "status": {"enum": ["PREPARED_INACTIVE", "ACCEPTED_ACTIVE", "SUPERSEDED"]},
    "project_agnostic": {"const": true},
    "visibility": {"const": "PRIVATE_GLOBAL_GOVERNANCE"},
    "contains_consumer_context": {"const": false},
    "raw_browsing_transcripts": {"const": false},
    "observed_at_utc": {"type": "string", "format": "date-time"},
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "evidence": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}},
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}},
    "models": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/model"}},
    "task_classes": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/taskClass"}},
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "authority_class", "source_url", "observed_at_utc", "expires_at_utc", "max_age_days", "uncertainty", "artifact_path", "artifact_sha256", "file_sha256", "summary_sha256", "raw_transcript_stored"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1}, "authority_class": {"enum": ["FIRST_PARTY_PROVIDER", "COMPARATIVE_BENCHMARK", "HOST_ATTESTATION"]}, "source_url": {"type": "string", "minLength": 1},
        "observed_at_utc": {"type": "string", "format": "date-time"}, "expires_at_utc": {"type": "string", "format": "date-time"}, "max_age_days": {"type": "integer", "minimum": 1}, "uncertainty": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "artifact_path": {"type": "string", "minLength": 1}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "file_sha256": {"$ref": "#/$defs/sha256"}, "summary_sha256": {"$ref": "#/$defs/sha256"}, "raw_transcript_stored": {"const": false}
      }
    },
    "conflict": {
      "type": "object", "additionalProperties": false, "required": ["field", "first_party_value", "comparative_value", "resolution"],
      "properties": {"field": {"type": "string", "minLength": 1}, "first_party_value": {"type": "string"}, "comparative_value": {"type": "string"}, "resolution": {"const": "FIRST_PARTY_GOVERNS"}}
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "provider_id", "provider_evidence_id", "benchmark_evidence_id", "host_evidence_id", "host_available", "availability_evidence", "capability_score", "input_usd_per_million", "output_usd_per_million", "output_tokens_per_second", "context_tokens", "supported_reasoning_efforts", "host_supported_reasoning_efforts", "capabilities"],
      "properties": {
        "model_id": {"type": "string"}, "provider_id": {"type": "string"}, "provider_evidence_id": {"type": "string"}, "benchmark_evidence_id": {"type": "string"}, "host_evidence_id": {"type": "string"}, "host_available": {"type": "boolean"}, "availability_evidence": {"type": "string"},
        "capability_score": {"type": "number", "minimum": 0}, "input_usd_per_million": {"type": "number", "minimum": 0}, "output_usd_per_million": {"type": "number", "minimum": 0}, "output_tokens_per_second": {"type": "number", "exclusiveMinimum": 0}, "context_tokens": {"type": "integer", "minimum": 1},
        "supported_reasoning_efforts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["none", "low", "medium", "high", "xhigh", "max"]}}, "host_supported_reasoning_efforts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["low", "medium", "high", "xhigh", "max"]}}, "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "taskClass": {
      "type": "object", "additionalProperties": false,
      "required": ["task_class", "minimum_capability_score", "minimum_context_tokens", "required_capabilities", "preferred_reasoning_effort", "preferred_models", "fallback_models", "max_input_usd_per_million", "max_output_usd_per_million", "max_concurrency", "max_heavyweight_processes", "max_evidence_age_days", "escalation_triggers"],
      "properties": {
        "task_class": {"enum": ["SIMPLE_EXTRACTION", "DETERMINISTIC_QA", "NARROW_CODING", "BROAD_ARCHITECTURE", "SECURITY_REVIEW", "LONG_CONTEXT_SYNTHESIS", "FINAL_INTEGRATION", "REAL_HOST_DEBUGGING"]},
        "minimum_capability_score": {"type": "number", "minimum": 0}, "minimum_context_tokens": {"type": "integer", "minimum": 1}, "required_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "preferred_reasoning_effort": {"enum": ["none", "low", "medium", "high", "xhigh", "max"]},
        "preferred_models": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "fallback_models": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "max_input_usd_per_million": {"type": "number", "minimum": 0}, "max_output_usd_per_million": {"type": "number", "minimum": 0}, "max_concurrency": {"type": "integer", "minimum": 1}, "max_heavyweight_processes": {"type": "integer", "minimum": 0}, "max_evidence_age_days": {"type": "integer", "minimum": 1}, "escalation_triggers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
