{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/ai-search-rag-package-operational-evaluation.v1.json",
  "title": "AgentOS AI Search/RAG specialist operational evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "block_id", "lifecycle", "activation", "package_root_sha256", "package_block_sha256", "decision_tree_sha256", "gate_execution_sha256", "gate_execution", "fixture_results", "mutation_sensitivity", "independent_signature_required", "evaluation_sha256"],
  "properties": {
    "schema": {"const": "agentos.ai_search_rag_package_operational_evaluation.v1"},
    "version": {"const": 1},
    "status": {"const": "PASS"},
    "block_id": {"const": "specialist.ai.search-rag"},
    "lifecycle": {"const": "CANDIDATE"},
    "activation": {"const": "OFF"},
    "package_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "package_block_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gate_execution_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gate_execution": {"type": "array", "minItems": 12},
    "fixture_results": {"type": "array", "minItems": 17},
    "mutation_sensitivity": {"type": "object"},
    "independent_signature_required": {"const": true},
    "evaluation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
