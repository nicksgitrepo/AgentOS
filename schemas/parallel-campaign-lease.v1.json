          "const": "NAMED_LANE_WORKER"
        },
        "lane_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "campaign_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "campaign_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "logical_lineage_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "goal_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "goal_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "writable_scope": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "task_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "READY",
            "LEASED",
            "RUNNING",
            "PROGRESS_RECORDED",
            "HANDOFF_READY",
            "CLOSING",
            "CLOSED",
            "FAILED",
            "REPAIR_REQUIRED"
          ]
        },
        "lease": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/lease"
            }
          ]
        },
        "session_ref": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^opaque:session:[0-9a-f]{64}$"
            }
          ]
        },
        "progress": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/progress"
            }
          ]
        },
        "handoff": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/handoff"
            }
          ]
        },
        "audit": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/audit"
            }
          ]
        },
        "failure": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/failure"
            }
          ]
        }
      }
    }
  }
}
