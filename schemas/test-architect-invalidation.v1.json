{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/test-architect-invalidation.v1.json",
  "title": "Test Architecture dependent-artifact invalidation contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "block_id", "rules", "rebuild_action", "invalidation_sha256"],
  "properties": {"schema": {"const": "agentos.specialist_invalidation.v1"}, "version": {"const": 1}, "block_id": {"const": "specialist.assurance-enterprise.test-architect"}, "rules": {"type": "array", "minItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["rule_id", "trigger", "affected", "action"], "properties": {"rule_id": {"type": "string"}, "trigger": {"type": "string"}, "affected": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "action": {"const": "INVALIDATE_AND_REBUILD"}}}}, "rebuild_action": {"const": "INVALIDATE_DEPENDENTS_REBUILD_AND_REQUALIFY"}, "invalidation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
