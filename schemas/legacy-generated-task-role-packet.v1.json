{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.generated_task_role_packet.v1",
  "title": "AgentOS generated task role packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "task_id_sha256",
    "task_kind",
    "role_id",
    "lane_id",
    "generated_project_role_library_digest",
    "task_gate_catalog_sha256",
    "applicable_question_ids",
    "graph_ids",
    "allowed_authority",
    "prohibited_authority",
    "required_evidence",
    "digest"
  ],
  "properties": {
    "schema": {"const": "agentos.generated_task_role_packet.v1"},
    "version": {"const": 1},
    "status": {"const": "PREPARED_NOT_ACTIVATED"},
    "task_id_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_kind": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "role_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]*$"},
    "lane_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Z][A-Z0-9._-]*$"
    },
    "generated_project_role_library_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_gate_catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "applicable_question_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"}
    },
    "graph_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]*$"}
    },
    "allowed_authority": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "prohibited_authority": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "required_evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

