        "requested_action": {"enum": ["ANALYZE", "ASSEMBLE", "ROUTE"]}, "requested_tools": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "required_block_identities": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string"}},
        "model_policy_status": {"type": "string"}, "model_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "model_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "context_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "model_route_status": {"type": "string"}, "authority_scope": {"const": "JOB_COST_ACCOUNTING"},
        "upstream_router_status": {"type": "string"}, "upstream_router_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "custody_ref": {"type": "string", "pattern": "^(opaque|ref):[A-Z0-9._:/-]{1,180}$"}, "rollback_ref": {"type": "string", "pattern": "^(opaque|ref):[A-Z0-9._:/-]{1,180}$"},
