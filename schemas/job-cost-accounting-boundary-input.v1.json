        "source_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "standard_block_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "standard_source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate_status": {"type": "string"}, "candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
