{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/harness-collision-gate.v1.json",
  "title": "AgentOS parse-only harness collision repair gate",
  "description": "Project-agnostic gate for duplicate local harness bindings. It binds exact syntax evidence and fails closed without executing harness code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "gate_id", "authority_binding", "source", "observed_failure", "parse_evaluation", "repair_block", "next_action", "next_handler", "execution_owner", "direct_consumer", "controller_approval_required", "same_turn_dispatch", "custody", "hostile_fixture_refs", "status", "gate_sha256"],
  "properties": {
    "schema": {"const": "agentos.harness_collision_gate.v1"},
    "version": {"const": 1},
    "gate_id": {"$ref": "#/$defs/identifier"},
    "authority_binding": {"$ref": "#/$defs/authority"},
    "source": {"$ref": "#/$defs/source"},
    "observed_failure": {"$ref": "#/$defs/observedFailure"},
    "parse_evaluation": {"$ref": "#/$defs/parseEvaluation"},
    "repair_block": {"$ref": "#/$defs/repairBlock"},
    "next_action": {"$ref": "#/$defs/identifier"},
    "next_handler": {"$ref": "#/$defs/identifier"},
    "execution_owner": {"const": "LANE_AGENT"},
    "direct_consumer": {"const": "INDEPENDENT_PLATFORM_REVIEW"},
    "controller_approval_required": {"const": false},
    "same_turn_dispatch": {"const": true},
    "custody": {"$ref": "#/$defs/custody"},
    "hostile_fixture_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "status": {"enum": ["CLEAR", "RETRY_REQUIRED"]},
    "gate_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "bindingName": {"type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"},
    "identifier": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{0,191}$"},
    "reference": {"type": "string", "pattern": "^(?:opaque:|ref:)[^\\s]+$"},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_commit", "authority_tree", "authority_receipt_sha256", "source_mapping_sha256"],
      "properties": {"authority_commit": {"$ref": "#/$defs/gitObject"}, "authority_tree": {"$ref": "#/$defs/gitObject"}, "authority_receipt_sha256": {"$ref": "#/$defs/sha256"}, "source_mapping_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_ref", "source_sha256", "source_content_available", "source_preserved"],
      "properties": {"source_ref": {"$ref": "#/$defs/reference"}, "source_sha256": {"$ref": "#/$defs/sha256"}, "source_content_available": {"type": "boolean"}, "source_preserved": {"const": true}}
    },
    "observedFailure": {
      "type": "object", "additionalProperties": false,
      "required": ["defect_code", "exact_failure", "binding_name", "evidence_sha256"],
      "properties": {"defect_code": {"$ref": "#/$defs/identifier"}, "exact_failure": {"type": "string", "minLength": 1}, "binding_name": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/bindingName"}]}, "evidence_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "parseEvaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "failure_class", "syntax_error_name", "syntax_error_message", "binding_name", "collision_detected", "evidence_complete", "missing_evidence", "parse_evidence_sha256"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "UNAVAILABLE"]},
        "failure_class": {"enum": ["NONE", "LOCAL_VARIABLE_COLLISION", "OTHER_SYNTAX_ERROR", "SOURCE_UNAVAILABLE"]},
        "syntax_error_name": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/bindingName"}]},
        "syntax_error_message": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "binding_name": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/bindingName"}]},
        "collision_detected": {"type": "boolean"},
        "evidence_complete": {"type": "boolean"},
        "missing_evidence": {"type": "array", "items": {"$ref": "#/$defs/identifier"}},
        "parse_evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "repairBlock": {
      "type": "object", "additionalProperties": false,
      "required": ["block_id", "classification", "route", "status", "required_evidence", "invalidation_rules", "spawnable"],
      "properties": {
        "block_id": {"$ref": "#/$defs/identifier"}, "classification": {"const": "REPAIRABLE_GATE_GAP"}, "route": {"const": "COMPILE_BLOCK_PATCH"}, "status": {"enum": ["CLEAR", "RETRY_REQUIRED"]}, "required_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}}, "invalidation_rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}}, "spawnable": {"const": false}
      }
    },
    "custody": {
      "type": "object", "additionalProperties": false,
      "required": ["control_plane_only", "source_roots_preserved", "product_mutation", "protected_action", "provider_access", "credential_access", "external_sync", "spend", "destructive_work", "deployment", "publication", "merge", "spawnable", "worker_admission", "wave_activation", "timers", "polling"],
      "properties": {
        "control_plane_only": {"const": true}, "source_roots_preserved": {"const": true}, "product_mutation": {"const": false}, "protected_action": {"const": false}, "provider_access": {"const": false}, "credential_access": {"const": false}, "external_sync": {"const": false}, "spend": {"const": false}, "destructive_work": {"const": false}, "deployment": {"const": false}, "publication": {"const": false}, "merge": {"const": false}, "spawnable": {"const": false}, "worker_admission": {"const": false}, "wave_activation": {"const": "OFF"}, "timers": {"const": 0}, "polling": {"const": false}
      }
    }
  }
}
