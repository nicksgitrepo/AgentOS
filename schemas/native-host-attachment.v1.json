{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.native_host_attachment.v1",
  "title": "AgentOS native external host attachment",
  "x-task-list-readback": {
    "mode": "NATIVE_HOST_LISTED_TASKS",
    "pin_acceptance": "The exact task ID must be present in a fresh pinnedThreads membership readback; a successful set_thread_pinned call alone is not acceptance.",
    "event_finalization": "A finalized host event requires a fresh task-index, turn-status, process-set, and material-receipt reread."
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "attachment_id",
    "host_id",
    "project_id",
    "environment_id",
    "capabilities",
    "model",
    "reasoning_effort",
    "attached_at_utc",
    "digest"
  ],
  "properties": {
    "schema": {"const": "agentos.native_host_attachment.v1"},
    "version": {"const": 1},
    "status": {"const": "BOUND"},
    "attachment_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"},
    "host_id": {"type": "string", "pattern": "^HOST_REF_[0-9a-f]{64}$"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"},
    "environment_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"},
    "capabilities": {
      "type": "array",
      "const": [
        "create_thread",
        "list_threads",
        "read_thread",
        "send_message_to_thread",
        "set_thread_archived",
        "set_thread_pinned",
        "wait_threads"
      ]
    },
    "model": {"type": "string", "minLength": 1},
    "reasoning_effort": {"type": "string", "minLength": 1},
    "attached_at_utc": {"type": "string", "format": "date-time"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
