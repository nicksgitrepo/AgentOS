{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.feature_implementation_loop.v1",
  "title": "Bounded feature planning, implementation, and Orchestrator review records",
  "oneOf": [
    {"$ref": "#/$defs/plan"},
    {"$ref": "#/$defs/dispatch"},
    {"$ref": "#/$defs/review"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {"type": "string", "pattern": "^(opaque:|ref:)"},
    "optionalSuggestion": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 4}]},
    "stringList": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 4}},
    "plan": {"type": "object", "additionalProperties": false, "required": ["schema", "version", "status", "feature_id", "title", "request", "planner_id", "planner_role", "project_agnostic", "scope", "requirements", "acceptance_criteria", "non_goals", "planning_principles", "implementation_instructions", "model_routing", "plan_sha256"], "properties": {"schema": {"const": "agentos.feature_plan.v1"}, "version": {"const": 1}, "status": {"const": "READY_FOR_IMPLEMENTATION"}, "feature_id": {"type": "string"}, "title": {"type": "string"}, "request": {"type": "string"}, "planner_id": {"type": "string"}, "planner_role": {"const": "AGENTOS.FEATURE_PLANNER"}, "project_agnostic": {"const": true}, "scope": {"type": "object", "additionalProperties": false, "required": ["in_scope", "out_of_scope"], "properties": {"in_scope": {"$ref": "#/$defs/stringList"}, "out_of_scope": {"$ref": "#/$defs/stringList"}}}, "requirements": {"$ref": "#/$defs/stringList"}, "acceptance_criteria": {"$ref": "#/$defs/stringList"}, "non_goals": {"$ref": "#/$defs/stringList"}, "planning_principles": {"const": ["NO_OVER_ENGINEERING", "NO_PREMATURE_ABSTRACTIONS", "NO_SCOPE_CREEP"]}, "implementation_instructions": {"$ref": "#/$defs/stringList"}, "model_routing": {"type": "object", "additionalProperties": false, "required": ["planner_task_class", "implementer_task_class", "canonical_policy_ref", "model_suggestion", "suggestion_is_authority"], "properties": {"planner_task_class": {"const": "BROAD_ARCHITECTURE"}, "implementer_task_class": {"const": "NARROW_CODING"}, "canonical_policy_ref": {"$ref": "#/$defs/ref"}, "model_suggestion": {"$ref": "#/$defs/optionalSuggestion"}, "suggestion_is_authority": {"const": false}}}, "plan_sha256": {"$ref": "#/$defs/sha256"}}},
    "dispatch": {"type": "object", "additionalProperties": false, "required": ["schema", "version", "status", "feature_id", "plan_sha256", "implementer_id", "worktree_ref", "round", "canonical_route_ref", "canonical_route_sha256", "instructions", "model_suggestion", "model_suggestion_is_authority", "prior_review_sha256", "dispatch_sha256"], "properties": {"schema": {"const": "agentos.feature_implementation_dispatch.v1"}, "version": {"const": 1}, "status": {"const": "IMPLEMENTATION_AUTHORIZED"}, "feature_id": {"type": "string"}, "plan_sha256": {"$ref": "#/$defs/sha256"}, "implementer_id": {"type": "string"}, "worktree_ref": {"type": "string", "pattern": "^opaque:worktree:"}, "round": {"type": "integer", "minimum": 1}, "canonical_route_ref": {"$ref": "#/$defs/ref"}, "canonical_route_sha256": {"$ref": "#/$defs/sha256"}, "instructions": {"$ref": "#/$defs/stringList"}, "model_suggestion": {"$ref": "#/$defs/optionalSuggestion"}, "model_suggestion_is_authority": {"const": false}, "prior_review_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}, "dispatch_sha256": {"$ref": "#/$defs/sha256"}}},
    "finding": {"type": "object", "additionalProperties": false, "required": ["issue_id", "severity", "location", "evidence_ref", "required_repair", "retest"], "properties": {"issue_id": {"type": "string"}, "severity": {"enum": ["BLOCKER", "HIGH", "MEDIUM", "LOW"]}, "location": {"type": "string"}, "evidence_ref": {"$ref": "#/$defs/ref"}, "required_repair": {"type": "string", "minLength": 20}, "retest": {"type": "string", "minLength": 12}}},
    "protectedBlocker": {"type": "object", "additionalProperties": false, "required": ["boundary", "evidence_ref", "next_action"], "properties": {"boundary": {"type": "string", "minLength": 4}, "evidence_ref": {"$ref": "#/$defs/ref"}, "next_action": {"type": "string", "minLength": 12}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["schema", "version", "status", "feature_id", "plan_sha256", "dispatch_sha256", "orchestrator_id", "implementer_id", "candidate_ref", "round", "evidence_refs", "findings", "protected_blocker", "next_action", "review_sha256"], "properties": {"schema": {"const": "agentos.orchestrator_feature_review.v1"}, "version": {"const": 1}, "status": {"enum": ["ACCEPTED", "REPAIR_REQUIRED", "PROTECTED_BLOCKED"]}, "feature_id": {"type": "string"}, "plan_sha256": {"$ref": "#/$defs/sha256"}, "dispatch_sha256": {"$ref": "#/$defs/sha256"}, "orchestrator_id": {"type": "string", "pattern": "^AGENTOS.ORCHESTRATOR"}, "implementer_id": {"type": "string"}, "candidate_ref": {"$ref": "#/$defs/ref"}, "round": {"type": "integer", "minimum": 1}, "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}, "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}, "protected_blocker": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/protectedBlocker"}]}, "next_action": {"enum": ["GOVERNED_DOWNSTREAM_HANDOFF", "RETURN_DETAILED_INSTRUCTIONS_TO_IMPLEMENTER", "ROUTE_PROTECTED_BOUNDARY"]}, "review_sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
