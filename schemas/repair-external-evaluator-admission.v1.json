{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.repair_external_evaluator_admission.v1",
  "title": "Externally admitted evaluator for AGENTOS.REPAIR",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "evaluator_id", "evaluator_role", "scope", "authority_epoch", "issued_at_utc", "expires_at_utc", "status", "admission_sha256", "root_signature_base64"],
  "properties": {
    "schema": {"const": "agentos.repair_external_evaluator_admission.v1"},
    "version": {"const": 1},
    "evaluator_id": {"type": "string", "pattern": "^AGENT\\.INDEPENDENT_EVALUATOR\\.[A-Z0-9._:-]{1,160}$"},
    "evaluator_role": {"const": "AGENT.INDEPENDENT_EVALUATOR"},
    "scope": {"const": "REPAIR_PACKAGE_REVIEW"},
    "authority_epoch": {"type": "integer", "minimum": 1},
    "issued_at_utc": {"type": "string", "format": "date-time"},
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "status": {"const": "ACTIVE"},
    "admission_sha256": {"$ref": "#/$defs/sha"},
    "root_signature_base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
