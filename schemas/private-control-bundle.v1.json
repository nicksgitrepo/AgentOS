{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.private_control_bundle.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "status", "bundle_id", "source_workspace_binding_digest", "source_control_snapshot_digest",
    "source_git", "files", "excluded_files", "digest"
  ],
  "properties": {
    "schema": {"const": "agentos.private_control_bundle.v1"},
    "version": {"const": 1},
    "status": {"const": "PORTABLE_VERIFIED"},
    "bundle_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "source_workspace_binding_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_control_snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_git": {"$ref": "#/$defs/git"},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "excluded_files": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree", "clean"],
      "properties": {
        "repository": {"enum": ["INDEPENDENT_GIT", "NOT_A_GIT_REPOSITORY"]},
        "commit": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
        "tree": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
        "clean": {"anyOf": [{"type": "null"}, {"type": "boolean"}]}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "size", "sha256", "bytes_base64"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "mode": {"type": "integer", "minimum": 0, "maximum": 511},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/digest"},
        "bytes_base64": {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}
      }
    }
  }
}
