{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/orchestrator-coordination-boundary-input.v1.json",
  "title": "Project-agnostic Orchestrator coordination boundary input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "request_kind", "evidence"],
  "properties": {
    "schema": {"const": "agentos.orchestrator_coordination_boundary_input.v1"},
    "version": {"const": 1},
    "request_kind": {"type": "string", "enum": ["PLAN_COORDINATION", "INTEGRATION_REVIEW", "HANDOFF_ROUTING", "NOT_APPLICABLE", "UNRELATED_REQUEST", "SPAWN", "ADMIT", "ARCHIVE", "DESPAWN", "MERGE", "DEPLOY", "PUBLISH", "MUTATE_PROJECT", "APPROVE"]},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["authority", "custody", "candidate", "source_lock", "requested_action", "signals"],
      "properties": {
        "authority": {"type": "object", "additionalProperties": false, "required": ["status", "source_status"], "properties": {"status": {"type": "string"}, "source_status": {"type": "string"}}},
        "custody": {"type": "object", "additionalProperties": false, "required": ["status", "ref", "owner"], "properties": {"status": {"type": "string"}, "ref": {"type": "string", "pattern": "^(?:opaque|ref):[A-Z0-9._:/-]{1,160}$"}, "owner": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{1,120}$"}}},
        "candidate": {"type": "object", "additionalProperties": false, "required": ["identity", "digest", "review_status", "package_scope"], "properties": {"identity": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{1,120}$"}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "review_status": {"type": "string"}, "package_scope": {"type": "string"}}},
        "source_lock": {"type": "object", "additionalProperties": false, "required": ["status", "identity", "version"], "properties": {"status": {"type": "string"}, "identity": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{1,120}$"}, "version": {"type": "string"}}},
        "requested_action": {"type": "string"},
        "signals": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{1,120}$"}},
        "scope": {"type": "string"}, "authority_scope": {"type": "string"}, "sibling_authorities": {"type": "array", "maxItems": 8, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{1,120}$"}},
        "self_acceptance": {"type": "boolean"}, "scope_expanded": {"type": "boolean"}, "authority_conflict": {"type": "boolean"}, "tool_mode": {"type": "string"}, "requested_tools": {"type": "array", "maxItems": 8, "items": {"type": "string"}}
      }
    }
  }
}
