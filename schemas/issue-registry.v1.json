{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "agentos.issue_registry.v1",
  "version": 1,
  "title": "Deterministic AgentOS issue registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "product_prefixes", "reservations", "next_numbers", "issues", "duplicate_submissions", "registry_sha256"],
  "properties": {
    "schema": {"const": "agentos.issue_registry.v1"},
    "version": {"const": 1},
    "product_prefixes": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,31}$"}, "uniqueItems": true},
    "reservations": {"type": "array"},
    "next_numbers": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "issues": {"type": "array"},
    "duplicate_submissions": {"type": "array"},
    "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "state_rules": {
    "ordering": "issues, prefixes, reservations, and duplicate submissions are canonical UTF-8 sorted sequences.",
    "integrity": "registry_sha256 is canonicalDigest of the registry with registry_sha256 set to null.",
    "history": "Records and reservations are append-only; failed or blocked material cannot disappear."
  }
}
