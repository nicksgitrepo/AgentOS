{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/specialist-context-manifest.v1.json",
  "title": "AgentOS External Companion Context Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "package_hash", "project_governance", "current_context", "candidate", "worktree", "custody", "capabilities", "freshness", "external_only"],
  "properties": {
    "schema": {"const": "agentos.context_manifest.v1"},
    "version": {"const": 1},
    "package_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "project_governance": {"$ref": "#/$defs/ref"},
    "current_context": {"type": "object", "additionalProperties": false, "required": ["identity", "version", "digest", "field_ids", "completeness", "corpus_authority"], "properties": {"identity": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "field_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}, "completeness": {"enum": ["COMPLETE", "UNKNOWN"]}, "corpus_authority": {"$ref": "#/$defs/ref"}}},
    "candidate": {"$ref": "#/$defs/ref"},
    "worktree": {"type": "object", "additionalProperties": false, "required": ["identity", "base_commit", "base_tree", "custody"], "properties": {"identity": {"type": "string", "minLength": 1}, "base_commit": {"type": "string", "minLength": 1}, "base_tree": {"type": "string", "minLength": 1}, "custody": {"type": "string", "minLength": 1}}},
    "custody": {"type": "object", "additionalProperties": false, "required": ["identity", "scope", "status"], "properties": {"identity": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}, "status": {"const": "BOUND"}}},
    "capabilities": {"type": "object", "additionalProperties": false, "required": ["read", "write", "tools", "data", "secrets", "browser", "build", "deploy", "communication", "resources"], "properties": {"read": {"type": "array", "items": {"type": "string"}}, "write": {"type": "array", "items": {"type": "string"}}, "tools": {"type": "array", "items": {"type": "string"}}, "data": {"type": "array", "items": {"type": "string"}}, "secrets": {"const": "DENY"}, "browser": {"type": "string", "minLength": 1}, "build": {"type": "string", "minLength": 1}, "deploy": {"const": "DENY"}, "communication": {"const": "TYPED_HANDOFF_ONLY"}, "resources": {"type": "array", "items": {"type": "string"}}}},
    "freshness": {"$ref": "#/$defs/ref"},
    "external_only": {"const": true}
  },
  "$defs": {"ref": {"type": "object", "additionalProperties": false, "required": ["identity", "version", "digest", "authority", "status"], "properties": {"identity": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "authority": {"type": "string", "minLength": 1}, "status": {"enum": ["COMPLETE", "FRESH", "BOUND", "UNKNOWN"]}}}}
}
