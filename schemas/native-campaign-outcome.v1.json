{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/native-campaign-outcome.v1.json",
  "title": "AgentOS Native Campaign Outcome v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "campaign_plan", "campaign_run", "digest"],
  "properties": {
    "schema": {"const": "agentos.native_campaign_outcome.v1"},
    "version": {"const": 1},
    "status": {"const": "COMPLETE"},
    "campaign_plan": {"type": "object"},
    "campaign_run": {"type": "object"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
