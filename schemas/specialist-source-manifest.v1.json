{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/specialist-source-manifest.v1.json",
  "title": "AgentOS Specialist Source Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "block_id", "sources", "freshness_rule", "manifest_sha256"],
  "properties": {
    "schema": {"const": "agentos.specialist_source_manifest.v1"},
    "version": {"const": 1},
    "block_id": {"type": "string", "pattern": "^specialist\\.[a-z0-9-]+\\.[a-z0-9-]+$"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "title", "publisher", "url", "version", "effective_date", "retrieved_date", "immutable_identity", "content_sha256", "authority_class", "scope"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^source\\.[a-z0-9-]+$"},
          "title": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^(https?://|PORTABLE_KERNEL)"},
          "version": {"type": "string", "minLength": 1},
          "effective_date": {"type": ["string", "null"]},
          "retrieved_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "immutable_identity": {"type": "string", "minLength": 1},
          "content_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "authority_class": {"enum": ["PRIMARY_NORMATIVE", "PRIMARY_DESCRIPTIVE", "SECONDARY_RESEARCH", "AGENTOS_PORTABLE"]},
          "scope": {"type": "string", "minLength": 1}
        }
      },
      "minItems": 1
    },
    "freshness_rule": {"type": "string", "minLength": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
