{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.independent_spawner_clearance.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "receipt_id", "issuer_id", "issuer_role", "subject_role", "result", "authority_epoch", "registry_sha256", "candidate_authority_sha256", "candidate", "scope", "custody", "issued_at_utc", "expires_at_utc", "nonce_sha256", "supersedes_receipt_sha256", "receipt_sha256", "signature_base64"],
  "properties": {
    "schema": {"const": "agentos.independent_spawner_clearance.v2"}, "version": {"const": 2},
    "receipt_id": {"$ref": "#/$defs/id"}, "issuer_id": {"$ref": "#/$defs/id"},
    "issuer_role": {"const": "AGENT.INDEPENDENT_EVALUATOR"}, "subject_role": {"const": "AGENT.SPAWNER_COMPILER"}, "result": {"const": "PASS"},
    "authority_epoch": {"type": "integer", "minimum": 1}, "registry_sha256": {"$ref": "#/$defs/sha256"}, "candidate_authority_sha256": {"$ref": "#/$defs/sha256"},
    "candidate": {"$ref": "#/$defs/candidate"},
