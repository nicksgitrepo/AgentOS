    "custody": {"$ref": "#/$defs/custody"}, "issued_at_utc": {"type": "string", "format": "date-time"}, "expires_at_utc": {"type": "string", "format": "date-time"},
    "nonce_sha256": {"$ref": "#/$defs/sha256"}, "supersedes_receipt_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}, "receipt_sha256": {"$ref": "#/$defs/sha256"}, "signature_base64": {"type": "string", "minLength": 40}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{0,191}$"},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["commit_sha1", "tree_sha1", "package_sha256", "package_file_sha256", "evidence_set_sha256", "lifecycle_candidate_sha256", "roster_projection_sha256", "context_sha256"], "properties": {"commit_sha1": {"$ref": "#/$defs/sha1"}, "tree_sha1": {"$ref": "#/$defs/sha1"}, "package_sha256": {"$ref": "#/$defs/sha256"}, "package_file_sha256": {"$ref": "#/$defs/sha256"}, "evidence_set_sha256": {"$ref": "#/$defs/sha256"}, "lifecycle_candidate_sha256": {"$ref": "#/$defs/sha256"}, "roster_projection_sha256": {"$ref": "#/$defs/sha256"}, "context_sha256": {"$ref": "#/$defs/sha256"}}},
    "custody": {"type": "object", "additionalProperties": false, "required": ["worktree_id", "detached", "clean", "source_preserved", "builder_separated", "custody_readback_sha256"], "properties": {"worktree_id": {"$ref": "#/$defs/id"}, "detached": {"const": true}, "clean": {"const": true}, "source_preserved": {"const": true}, "builder_separated": {"const": true}, "custody_readback_sha256": {"$ref": "#/$defs/sha256"}}}
  },
  "authority_rules": {"trust_root": "Registry and keys come from the canonical content-addressed trust anchor, never caller payload.", "candidate": "Candidate identity is independently resolved from immutable repository/control artifacts.", "replay": "Consumption is durable, append-only, fenced, restart-safe, and one-time."}
}
