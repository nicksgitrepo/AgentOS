{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/security-router-package-operational-evaluation.v1.json",
  "title": "Security Router operational hostile evaluation",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "version", "status", "block_id", "lifecycle", "activation", "package_root_sha256", "package_block_sha256", "gate_inventory_sha256", "fixture_inventory_sha256", "fixture_results", "mutation_sensitivity", "independent_signature_required", "observed_at_utc", "evaluation_sha256"],
  "properties": {
    "schema": {"const": "agentos.specialist_security_router_package_operational_evaluation.v1"}, "version": {"const": 1}, "status": {"const": "PASS"}, "block_id": {"const": "specialist.security.router"}, "lifecycle": {"const": "CANDIDATE"}, "activation": {"const": "OFF"},
    "package_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "package_block_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "gate_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "fixture_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fixture_results": {"type": "array", "minItems": 17, "items": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "fixture_class", "fixture_file_sha256", "entrypoint", "entrypoint_invoked", "semantic_execution_completed", "expected_outcome", "actual_outcome", "expected_route", "actual_route", "expected_error_code", "actual_error_code", "assertion_readbacks", "external_side_effects", "duration_ms", "result_sha256"], "properties": {"fixture_id": {"type": "string"}, "fixture_class": {"type": "string"}, "fixture_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "entrypoint": {"const": "control/security-router-boundary-gate.mjs#evaluateSecurityRouterBoundary"}, "entrypoint_invoked": {"const": true}, "semantic_execution_completed": {"const": true}, "expected_outcome": {"enum": ["DENY", "ESCALATE", "ROUTE"]}, "actual_outcome": {"enum": ["DENY", "ESCALATE", "ROUTE"]}, "expected_route": {"type": "string"}, "actual_route": {"type": "string"}, "expected_error_code": {"type": "string"}, "actual_error_code": {"type": "string"}, "assertion_readbacks": {"type": "array", "minItems": 5}, "external_side_effects": {"type": "object"}, "duration_ms": {"type": "integer", "minimum": 0}, "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "mutation_sensitivity": {"type": "object", "additionalProperties": false, "required": ["status", "mutation_detected", "expected_disposition", "observed_disposition", "result_sha256"], "properties": {"status": {"const": "WEAKENED"}, "mutation_detected": {"const": true}, "expected_disposition": {"const": "DENY"}, "observed_disposition": {"const": "ROUTE"}, "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "independent_signature_required": {"const": true}, "observed_at_utc": {"type": "string", "format": "date-time"}, "evaluation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
