{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/idempotency-boundary-input.v1.json",
  "title": "Project-agnostic Idempotency specialist typed boundary input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "request_kind", "evidence"],
  "properties": {
    "schema": {"const": "agentos.idempotency_boundary_input.v1"},
    "version": {"const": 1},
    "request_kind": {"type": "string"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_status", "custody_status", "custody_owner", "custody_ref", "security_domain", "request_identity", "idempotency_key",
        "duplicate_detection_status", "replay_status", "concurrency_scope", "operation_identity", "operation_version", "source_status",
        "source_identity", "source_version", "source_effective_date", "source_retrieved_date", "source_manifest_sha256", "candidate_status",
        "candidate_digest", "signal", "signal_status", "task_status", "context_status", "context_complete", "requested_action",
        "requested_tools", "required_block_identities", "model_policy_status", "model_route_status", "authority_scope", "scope",
        "standard_id", "standard_version", "standard_block_sha256", "standard_source_manifest_sha256", "model_snapshot_sha256",
        "model_task_class", "model_capability_floor", "model_required_capabilities", "model_route_sha256", "context_receipt_sha256",
        "upstream_router_result_sha256", "operation_context_sha256", "project_data_present", "secret_data_present", "policy_status",
        "replay_mutation_requested", "submission_mutation_requested", "credential_issue_requested", "adversarial_flags"
      ],
      "properties": {
        "authority_status": {"type": "string"}, "custody_status": {"type": "string"}, "custody_owner": {"type": "string"},
        "custody_ref": {"type": "string", "pattern": "^(?:opaque|ref):[A-Z0-9._:/-]{1,180}$"}, "security_domain": {"const": "IDEMPOTENCY"},
        "request_identity": {"type": "string"}, "idempotency_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "duplicate_detection_status": {"type": "string"}, "replay_status": {"type": "string"}, "concurrency_scope": {"type": "string"},
        "operation_identity": {"type": "string"}, "operation_version": {"type": "string"}, "source_status": {"type": "string"},
        "source_identity": {"type": "string"}, "source_version": {"type": "string"}, "source_effective_date": {"type": "string"},
        "source_retrieved_date": {"type": "string"}, "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate_status": {"type": "string"}, "candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "signal": {"type": "string"}, "signal_status": {"type": "string"}, "task_status": {"type": "string"},
        "context_status": {"type": "string"}, "context_complete": {"type": "boolean"}, "requested_action": {"type": "string"},
        "requested_tools": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string"}},
        "required_block_identities": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"type": "string"}},
        "model_policy_status": {"type": "string"}, "model_route_status": {"type": "string"}, "authority_scope": {"type": "string"},
        "scope": {"type": "string"}, "standard_id": {"type": "string"}, "standard_version": {"type": "string"},
        "standard_block_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "standard_source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "model_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "model_task_class": {"type": "string"},
        "model_capability_floor": {"type": "integer", "minimum": 0}, "model_required_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "model_route_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "context_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "upstream_router_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "operation_context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "project_data_present": {"type": "boolean"}, "secret_data_present": {"type": "boolean"}, "policy_status": {"type": "string"},
        "replay_mutation_requested": {"type": "boolean"}, "submission_mutation_requested": {"type": "boolean"}, "credential_issue_requested": {"type": "boolean"},
        "adversarial_flags": {"type": "object", "additionalProperties": false, "required": ["authority_conflict", "scope_expanded", "protected_data", "stale_source", "unsupported_tool", "duplicate_authority", "self_acceptance", "unrelated_scope", "missing_context", "unsafe_action", "broad_claim", "cross_provider", "false_positive", "duplicate_request", "key_missing", "version_ambiguous", "replay_unproven", "concurrency_unbounded"], "properties": {"authority_conflict": {"type": "boolean"}, "scope_expanded": {"type": "boolean"}, "protected_data": {"type": "boolean"}, "stale_source": {"type": "boolean"}, "unsupported_tool": {"type": "boolean"}, "duplicate_authority": {"type": "boolean"}, "self_acceptance": {"type": "boolean"}, "unrelated_scope": {"type": "boolean"}, "missing_context": {"type": "boolean"}, "unsafe_action": {"type": "boolean"}, "broad_claim": {"type": "boolean"}, "cross_provider": {"type": "boolean"}, "false_positive": {"type": "boolean"}, "duplicate_request": {"type": "boolean"}, "key_missing": {"type": "boolean"}, "version_ambiguous": {"type": "boolean"}, "replay_unproven": {"type": "boolean"}, "concurrency_unbounded": {"type": "boolean"}}}
      }
    }
  }
}
