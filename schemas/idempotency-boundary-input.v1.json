{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/idempotency-boundary-input.v1.json",
  "title": "Project-agnostic Idempotency boundary input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "request_kind", "evidence"],
  "properties": {
    "schema": {"const": "agentos.idempotency_boundary_input.v1"},
    "version": {"const": 1},
    "request_kind": {"type": "string"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_status", "security_domain", "request_identity", "idempotency_key", "duplicate_detection_status", "replay_status", "concurrency_scope", "operation_identity", "operation_version", "source_status", "source_identity", "source_version", "source_effective_date", "source_retrieved_date", "candidate_status", "candidate_digest", "signal_status", "task_status", "context_status", "context_complete", "requested_action", "requested_tools", "required_block_identities", "model_policy_status", "model_route_status", "authority_scope", "project_data_present", "secret_data_present", "adversarial_flags"],
      "properties": {
        "authority_status": {"type": "string"}, "security_domain": {"const": "IDEMPOTENCY"}, "request_identity": {"type": "string"}, "idempotency_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "duplicate_detection_status": {"type": "string"}, "replay_status": {"type": "string"}, "concurrency_scope": {"type": "string"}, "operation_identity": {"type": "string"}, "operation_version": {"type": "string"}, "source_status": {"type": "string"}, "source_identity": {"type": "string"}, "source_version": {"type": "string"}, "source_effective_date": {"type": "string"}, "source_retrieved_date": {"type": "string"}, "candidate_status": {"type": "string"}, "candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "signal_status": {"type": "string"}, "task_status": {"type": "string"}, "context_status": {"type": "string"}, "context_complete": {"type": "boolean"}, "requested_action": {"type": "string"}, "requested_tools": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "required_block_identities": {"type": "array", "items": {"type": "string"}, "minItems": 6, "maxItems": 6}, "model_policy_status": {"type": "string"}, "model_route_status": {"type": "string"}, "authority_scope": {"const": "IDEMPOTENCY"}, "project_data_present": {"type": "boolean"}, "secret_data_present": {"type": "boolean"}, "adversarial_flags": {"type": "object", "additionalProperties": {"type": "boolean"}}
      }
    }
  }
}
