{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/owasp-api-2023-api1-object-authorization-boundary-result.v1.json",
  "title": "Project-agnostic OWASP API API1 object authorization boundary result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "disposition",
    "route",
    "analysis_allowed",
    "acceptance_allowed",
    "authorization_decision_allowed",
    "policy_mutation_allowed",
    "external_side_effects",
    "error_code",
    "input_sha256",
    "result_sha256"
  ],
  "properties": {
    "schema": {
      "const": "agentos.owasp_api_object_authorization_boundary_result.v1"
    },
    "version": {
      "const": 1
    },
    "disposition": {
      "enum": [
        "DENY",
        "ROUTE"
      ]
    },
    "route": {
      "type": "string"
    },
    "analysis_allowed": {
      "type": "boolean"
    },
    "acceptance_allowed": {
      "const": false
    },
    "authorization_decision_allowed": {
      "const": false
    },
    "policy_mutation_allowed": {
      "const": false
    },
    "external_side_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_reads",
        "source_reads",
        "protected_data_reads",
        "authorization_decisions",
        "policy_mutations",
        "project_writes",
        "memory_writes",
        "credential_accesses",
        "state_changes"
      ],
      "properties": {
        "candidate_reads": {
          "const": 0
        },
        "source_reads": {
          "const": 0
        },
        "protected_data_reads": {
          "const": 0
        },
        "authorization_decisions": {
          "const": 0
        },
        "policy_mutations": {
          "const": 0
        },
        "project_writes": {
          "const": 0
        },
        "memory_writes": {
          "const": 0
        },
        "credential_accesses": {
          "const": 0
        },
        "state_changes": {
          "const": 0
        }
      }
    },
    "error_code": {
      "type": "string"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "selected_specialist": {
      "const": "specialist.security.owasp-api-2023-api1-object-authorization"
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "next_action",
        "execution_instruction"
      ],
      "properties": {
        "status": {
          "const": "WAITING_WITH_RECEIPT"
        },
        "next_action": {
          "type": "string"
        },
        "execution_instruction": {
          "const": false
        }
      }
    },
    "result_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
