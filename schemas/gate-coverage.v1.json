{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.gate_coverage.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "scope_rules", "categories", "graph_coverage", "digest"],
  "properties": {
    "schema": {"const": "agentos.gate_coverage.v1"},
    "version": {"const": 1},
    "status": {"const": "PREPARED_NOT_ACTIVATED"},
    "scope_rules": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "categories": {"type": "array", "minItems": 13},
    "graph_coverage": {"type": "array", "minItems": 1},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
