{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.specialist_runtime_deployment_package_operational_evaluation.v1",
  "title": "AgentOS Runtime Deployment Package Operational Evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "block_id", "lifecycle", "activation", "package_root_sha256", "package_block_sha256", "gate_inventory_sha256", "fixture_inventory_sha256", "fixture_results", "focused_suites", "mutation_sensitivity", "independent_signature_required", "observed_at_utc", "evaluation_sha256"],
  "properties": {
    "schema": {"const": "agentos.specialist_runtime_deployment_package_operational_evaluation.v1"},
    "version": {"const": 1},
    "status": {"const": "PASS"},
    "block_id": {"const": "specialist.control.runtime-deployment-operator"},
    "lifecycle": {"const": "CANDIDATE"},
    "activation": {"const": "OFF"},
    "package_root_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "package_block_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "gate_inventory_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "fixture_inventory_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "fixture_results": {"type": "array", "minItems": 17, "maxItems": 17, "uniqueItems": true},
    "focused_suites": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true},
    "mutation_sensitivity": {"type": "object", "additionalProperties": false, "required": ["status", "mutation_detected", "expected_disposition", "observed_disposition", "result_sha256"], "properties": {"status": {"const": "WEAKENED"}, "mutation_detected": {"const": true}, "expected_disposition": {"const": "DENY"}, "observed_disposition": {"const": "ROUTE"}, "result_sha256": {"pattern": "^[0-9a-f]{64}$"}}},
    "independent_signature_required": {"const": true},
    "observed_at_utc": {"format": "date-time"},
    "evaluation_sha256": {"pattern": "^[0-9a-f]{64}$"}
  }
}
