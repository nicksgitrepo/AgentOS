{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.lane_safe_checkpoint_receipt.v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "version", "receipt_id", "checkpoint_id", "lane_id", "sequence", "state", "consumption_state", "material_sha256", "receipt_sha256"],
  "properties": {
    "schema": {"const": "agentos.lane_safe_checkpoint_receipt.v1"},
    "version": {"const": 1},
    "receipt_id": {"type": "string", "minLength": 1},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "lane_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "state": {"enum": ["CHECKPOINT_REACHED", "HANDOFF_READY", "AUDIT_ROUTED", "DELIVERED", "CONSUMED", "CLOSED", "STALLED"]},
    "consumption_state": {"enum": ["UNCONSUMED", "CONSUMED"]},
    "material_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "late_material": {"type": "boolean"},
    "parent_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
