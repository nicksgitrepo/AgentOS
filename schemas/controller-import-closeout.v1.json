{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/controller-import-closeout.v1.json",
  "title": "AgentOS Controller Import Routine Closeout",
  "description": "A routine Controller import handoff is not closed until the exact next transition or local block repair is content-bound to the current roster projection.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "projection_sha256", "wave_activation_allowed", "next_transition", "local_block_repair", "protected_wave_activation", "protected_dependency", "closeout_sha256"],
  "properties": {
    "schema": {"const": "agentos.controller_import_closeout.v1"},
    "version": {"const": 1},
    "status": {"enum": ["ROUTINE_HANDOFF_ACCEPTED", "PROTECTED_WAVE_ACTIVATION_PENDING", "STALLED_READY_FOR_RESUMPTION", "TERMINAL_READY"]},
    "projection_sha256": {"$ref": "#/$defs/sha256"},
    "wave_activation_allowed": {"type": "boolean"},
    "next_transition": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/nextTransition"}]},
    "local_block_repair": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/localBlockRepair"}]},
    "protected_wave_activation": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/protectedWaveActivation"}]},
    "protected_dependency": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/protectedDependency"}]},
    "closeout_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{0,191}$"},
    "nextTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition_id", "action", "target_wave_id", "source_projection_sha256"],
      "properties": {
        "transition_id": {"$ref": "#/$defs/identifier"},
        "action": {"const": "START_AVAILABLE_WAVE"},
        "target_wave_id": {"$ref": "#/$defs/identifier"},
        "source_projection_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "localBlockRepair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "request_id", "source_projection_sha256"],
      "properties": {
        "action": {"const": "BUILD_AND_QA_PENDING_BLOCK"},
        "request_id": {"$ref": "#/$defs/identifier"},
        "source_projection_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "protectedWaveActivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "wave_ids", "source_projection_sha256"],
      "properties": {
        "action": {"const": "WAIT_FOR_PROTECTED_WAVE_ACTIVATION"},
        "wave_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "minItems": 1},
        "source_projection_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "protectedDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency_id", "reason", "sole_protected_dependency"],
      "properties": {
        "dependency_id": {"$ref": "#/$defs/identifier"},
        "reason": {"type": "string", "minLength": 1},
        "sole_protected_dependency": {"const": true}
      }
    }
  }
}
