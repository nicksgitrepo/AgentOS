{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/agent-spawner-governed-admission.v1.json",
  "title": "AgentOS Agent Spawner Governed Admission",
  "description": "Same-turn, project-agnostic adapter readback for consuming an independently cleared compiler-only Spawner admission successor. It exposes the next governed action and proves that isolated-custody, worker, wave, Product, provider, and credential bypasses remain closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "adapter_id", "source_continuation_sha256", "source_lifecycle_sha256",
    "lifecycle_after_sha256", "status", "next_action", "next_handler", "same_turn_dispatch",
    "authority", "admission", "evidence_refs", "hostile_fixture_refs", "readback_sha256"
  ],
  "properties": {
    "schema": {"const": "agentos.agent_spawner_governed_admission.v1"},
    "version": {"const": 1},
    "adapter_id": {"$ref": "#/$defs/identifier"},
    "source_continuation_sha256": {"$ref": "#/$defs/sha256"},
    "source_lifecycle_sha256": {"$ref": "#/$defs/sha256"},
    "lifecycle_after_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"const": "ADAPTER_STARTED"},
    "next_action": {"const": "START_GOVERNED_SPAWN"},
    "next_handler": {"const": "HANDLER.GOVERNED_SPAWN_ADAPTER"},
    "same_turn_dispatch": {"const": true},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compiler_only", "admission", "activation", "product_mutation", "provider_access", "credential_access"],
      "properties": {
        "compiler_only": {"const": false},
        "admission": {"const": true},
        "activation": {"const": false},
        "product_mutation": {"const": false},
        "provider_access": {"const": false},
        "credential_access": {"const": false}
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spawnable", "worker_spawned", "wave_activation", "isolated_local_custody"],
      "properties": {
        "spawnable": {"const": true},
        "worker_spawned": {"const": false},
        "wave_activation": {"const": "OFF"},
        "isolated_local_custody": {"const": false}
      }
    },
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceRef"}},
    "hostile_fixture_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "readback_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{0,191}$"},
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "reference", "sha256"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/identifier"},
        "reference": {"type": "string", "pattern": "^(opaque:|ref:)[^\\s]+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
