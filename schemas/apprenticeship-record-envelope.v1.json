{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.apprenticeship_record_envelope.v1",
  "title": "AgentOS apprenticeship persisted record envelope",
  "x-schema-kind": "record",
  "x-status": "PREPARED_NOT_ACTIVATED",
  "x-activation": {"active": false, "automatic": false},
  "type": "object",
  "required": [
    "schema",
    "version",
    "mode",
    "record_id",
    "record_type",
    "state",
    "lifecycle_status",
    "payload_schema",
    "payload_digest",
    "provenance",
    "predecessor_ref",
    "predecessor_digest",
    "evidence_attestation_refs",
    "actor_ref",
    "actor_session_ref",
    "actor_role",
    "owner_decision_ref",
    "activation_allowed",
    "protected_actions",
    "created_at",
    "updated_at",
    "digest"
  ],
  "properties": {
    "schema": {"const": "agentos.apprenticeship_record_envelope.v1"},
    "version": {"const": 1},
    "mode": {"const": "APPRENTICESHIP"},
    "record_id": {"$ref": "apprenticeship-common.v1.json#/$defs/identifier"},
    "record_type": {"$ref": "apprenticeship-common.v1.json#/$defs/identifier"},
    "state": {"enum": ["DRAFT", "OWNER_BOUND", "ADMITTED", "WORKING", "WORK_RESULT_READY", "CANDIDATE_COMPILED", "DRILLING", "DRILL_INCOMPLETE", "UNKNOWN_BLOCKED", "DRILL_COMPLETE_NON_ACCEPTING", "REPRODUCTION_PENDING", "REPRODUCED", "REPRODUCTION_FAILED", "HANDOFF_READY", "OWNER_REVIEW_REQUIRED", "OWNER_APPROVED_PENDING_ACTIVATION", "REPAIR_REQUIRED", "HARD_STOP", "SOFT_REVIEW", "REASSESS", "ARCHIVING", "ARCHIVED"]},
    "lifecycle_status": {"enum": ["PREPARED_NOT_ACTIVATED", "REVIEW_REQUIRED", "REPAIR_REQUIRED", "BLOCKED", "ARCHIVED"]},
    "payload_schema": {"$ref": "apprenticeship-common.v1.json#/$defs/schemaId"},
    "payload_digest": {"$ref": "apprenticeship-common.v1.json#/$defs/sha256"},
    "provenance": {"$ref": "apprenticeship-common.v1.json#/$defs/provenance"},
    "predecessor_ref": {"$ref": "apprenticeship-common.v1.json#/$defs/nullableReference"},
    "predecessor_digest": {"$ref": "apprenticeship-common.v1.json#/$defs/nullableSha256"},
    "evidence_attestation_refs": {"$ref": "apprenticeship-common.v1.json#/$defs/referenceList"},
    "actor_ref": {"$ref": "apprenticeship-common.v1.json#/$defs/reference"},
    "actor_session_ref": {"$ref": "apprenticeship-common.v1.json#/$defs/reference"},
    "actor_role": {"enum": ["APPRENTICESHIP_WORKER", "WALKTHROUGH_ORCHESTRATOR", "WORKFLOW_AUDITOR", "INDEPENDENT_AUDITOR", "AGENTOS_CONTROLLER", "RUNTIME"]},
    "owner_decision_ref": {"$ref": "apprenticeship-common.v1.json#/$defs/nullableReference"},
    "activation_allowed": {"const": false},
    "protected_actions": {"$ref": "apprenticeship-common.v1.json#/$defs/protectedActions"},
    "created_at": {"$ref": "apprenticeship-common.v1.json#/$defs/timestamp"},
    "updated_at": {"$ref": "apprenticeship-common.v1.json#/$defs/timestamp"},
    "digest": {"$ref": "apprenticeship-common.v1.json#/$defs/sha256"}
  },
  "additionalProperties": false
}
