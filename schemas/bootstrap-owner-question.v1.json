{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.bootstrap_owner_question.v1",
  "title": "AgentOS Bootstrap owner question surface",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "question_id", "prompt", "answer_kind", "choices", "boolean_answers", "internal_fields_hidden", "digest"],
  "properties": {
    "schema": {"const": "agentos.bootstrap_owner_question.v1"},
    "version": {"const": 1},
    "question_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9._-]*$"},
    "prompt": {"type": "string", "minLength": 1, "maxLength": 160},
    "answer_kind": {"enum": ["TEXT", "BOOLEAN", "CHOICE"]},
    "choices": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "value", "label"],
        "properties": {
          "number": {"type": "integer", "minimum": 1, "maximum": 5},
          "value": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1, "maxLength": 120}
        }
      }
    },
    "boolean_answers": {"type": "boolean"},
    "internal_fields_hidden": {"const": true},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
