{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/observability-router-boundary-input.v1.json",
  "title": "Project-agnostic Observability Router boundary input",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "version", "request_kind", "evidence"],
  "properties": {
    "schema": {"const": "agentos.observability_router_boundary_input.v1"}, "version": {"const": 1},
    "request_kind": {"type": "string", "enum": ["ROUTE_OBSERVABILITY", "CLASSIFY_INCIDENT_SIGNAL", "NOT_APPLICABLE", "UNRELATED_REQUEST", "SPAWN", "ADMIT", "ARCHIVE", "DESPAWN", "MUTATE_PRODUCTION", "WRITE_PROJECT", "ACCEPT", "SELF_REVIEW"]},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["authority_status", "custody_status", "custody_owner", "custody_ref", "source_status", "source_identity", "source_version", "signal", "target_ref", "context_complete", "scope", "requested_action", "incident_identity", "service_identity", "observability_evidence"], "properties": {
      "authority_status": {"type": "string"}, "custody_status": {"type": "string"}, "custody_owner": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{1,120}$"}, "custody_ref": {"type": "string", "pattern": "^(?:opaque|ref):[A-Z0-9._:/-]{1,160}$"},
      "source_status": {"type": "string"}, "source_identity": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{1,120}$"}, "source_version": {"type": "string"}, "signal": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{1,120}$"}, "target_ref": {"type": "string", "pattern": "^specialist\\.[a-z0-9-]+\\.[a-z0-9-]+$"},
      "context_complete": {"type": "boolean"}, "scope": {"type": "string"}, "requested_action": {"type": "string"}, "requested_tools": {"type": "array", "maxItems": 4, "items": {"type": "string"}}, "self_acceptance": {"type": "boolean"}, "scope_expanded": {"type": "boolean"}, "authority_conflict": {"type": "boolean"}, "project_data_present": {"type": "boolean"}, "secret_data_present": {"type": "boolean"},
      "incident_identity": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{1,120}$"}, "service_identity": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{1,120}$"}, "observability_evidence": {"type": "string"}
    }}
  }
}
