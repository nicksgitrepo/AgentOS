{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.apprenticeship_state_transition.v1",
  "title": "AgentOS apprenticeship state transition",
  "x-schema-kind": "record",
  "x-status": "PREPARED_NOT_ACTIVATED",
  "x-activation": {"active": false, "automatic": false},
  "type": "object",
  "required": [
    "schema",
    "version",
    "mode",
    "transition_id",
    "record_ref",
    "predecessor_state_ref",
    "from_state",
    "to_state",
    "reason_code",
    "authority",
    "actor_ref",
    "actor_session_ref",
    "provenance",
    "evidence_attestation_refs",
    "owner_decision_ref",
    "activation_allowed",
    "protected_actions",
    "observed_at",
    "digest"
  ],
  "properties": {
    "schema": {"const": "agentos.apprenticeship_state_transition.v1"},
    "version": {"const": 1},
    "mode": {"const": "APPRENTICESHIP"},
    "transition_id": {"$ref": "apprenticeship-common.v1.json#/$defs/identifier"},
    "record_ref": {"$ref": "apprenticeship-common.v1.json#/$defs/reference"},
    "predecessor_state_ref": {"$ref": "apprenticeship-common.v1.json#/$defs/nullableReference"},
    "from_state": {"enum": ["DRAFT", "OWNER_BOUND", "ADMITTED", "WORKING", "WORK_RESULT_READY", "CANDIDATE_COMPILED", "DRILLING", "DRILL_INCOMPLETE", "UNKNOWN_BLOCKED", "DRILL_COMPLETE_NON_ACCEPTING", "REPRODUCTION_PENDING", "REPRODUCED", "REPRODUCTION_FAILED", "HANDOFF_READY", "OWNER_REVIEW_REQUIRED", "OWNER_APPROVED_PENDING_ACTIVATION", "REPAIR_REQUIRED", "HARD_STOP", "SOFT_REVIEW", "REASSESS", "ARCHIVING", "ARCHIVED"]},
    "to_state": {"enum": ["DRAFT", "OWNER_BOUND", "ADMITTED", "WORKING", "WORK_RESULT_READY", "CANDIDATE_COMPILED", "DRILLING", "DRILL_INCOMPLETE", "UNKNOWN_BLOCKED", "DRILL_COMPLETE_NON_ACCEPTING", "REPRODUCTION_PENDING", "REPRODUCED", "REPRODUCTION_FAILED", "HANDOFF_READY", "OWNER_REVIEW_REQUIRED", "OWNER_APPROVED_PENDING_ACTIVATION", "REPAIR_REQUIRED", "HARD_STOP", "SOFT_REVIEW", "REASSESS", "ARCHIVING", "ARCHIVED"]},
    "reason_code": {"$ref": "apprenticeship-common.v1.json#/$defs/identifier"},
    "authority": {"enum": ["INTENT_REGULATOR", "RUNTIME", "APPRENTICESHIP_WORKER", "WALKTHROUGH_ORCHESTRATOR", "WORKFLOW_AUDITOR", "INDEPENDENT_AUDITOR"]},
    "actor_ref": {"$ref": "apprenticeship-common.v1.json#/$defs/reference"},
    "actor_session_ref": {"$ref": "apprenticeship-common.v1.json#/$defs/reference"},
    "provenance": {"$ref": "apprenticeship-common.v1.json#/$defs/provenance"},
    "evidence_attestation_refs": {"$ref": "apprenticeship-common.v1.json#/$defs/referenceList"},
    "owner_decision_ref": {"$ref": "apprenticeship-common.v1.json#/$defs/nullableReference"},
    "activation_allowed": {"const": false},
    "protected_actions": {"$ref": "apprenticeship-common.v1.json#/$defs/protectedActions"},
    "observed_at": {"$ref": "apprenticeship-common.v1.json#/$defs/timestamp"},
    "digest": {"$ref": "apprenticeship-common.v1.json#/$defs/sha256"}
  },
  "additionalProperties": false
}
