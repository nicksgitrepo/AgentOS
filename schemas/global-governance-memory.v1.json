{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.global_governance_memory.v1",
  "title": "Project-agnostic global governance memory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "project_agnostic", "genesis_writer", "writers", "readers", "canonical_event", "current_readback", "project_memory_isolation"],
  "properties": {
    "schema": {"const": "agentos.global_governance_memory.v1"},
    "version": {"const": 1},
    "status": {"const": "PREPARED_NOT_ACTIVATED"},
    "project_agnostic": {"const": true},
    "genesis_writer": {"const": "BOOTSTRAP_GENESIS_SEQUENCE_ZERO_ONLY"},
    "writers": {"const": ["GOVERNED_MEMORY_ADAPTER"]},
    "readers": {"const": ["CONTROLLER", "PRODUCT_OWNER", "SPAWNER", "MEMORY", "SCHEDULER", "RUNTIME", "ORCHESTRATOR", "INERT_SEED", "WORKING_AGENT"]},
    "canonical_event": {"const": "agentos.global_governance_memory_event.v1"},
    "current_readback": {"const": "agentos.global_governance_memory_readback.v1"},
    "project_memory_isolation": {"const": "NO_PROJECT_RECORD_OR_TRANSCRIPT_MAY_ENTER_GLOBAL_GOVERNANCE_MEMORY"}
  }
}
