{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/audit-finding.v1.json",
  "title": "AgentOS canonical audit finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "finding_id", "semantic_key", "stable_aliases", "causal_root_id", "title", "summary", "discipline",
    "gate_ref", "clause_refs", "source_observations", "evidence_items", "affected_surfaces", "severity", "confidence", "blast_radius",
    "dependency_finding_ids", "conflict_finding_ids", "proposed_repair_class", "focused_proof_contract", "independent_acceptance_contract",
    "evidence_ceiling", "lifecycle", "finding_sha256"
  ],
  "properties": {
    "schema": {"const": "agentos.audit_finding.v1"},
    "version": {"const": 1},
    "finding_id": {"$ref": "#/$defs/id"},
    "semantic_key": {"$ref": "#/$defs/id"},
    "stable_aliases": {"$ref": "#/$defs/ids"},
    "causal_root_id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "discipline": {"type": "string", "minLength": 1},
    "gate_ref": {"type": "string", "minLength": 1},
    "clause_refs": {"$ref": "#/$defs/nonemptyStrings"},
    "source_observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}},
    "evidence_items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "affected_surfaces": {"$ref": "#/$defs/nonemptyStrings"},
    "severity": {"enum": ["BLOCKER", "CRITICAL", "HIGH", "MEDIUM", "LOW"]},
    "confidence": {"enum": ["LOW", "MEDIUM", "HIGH", "VERIFIED"]},
    "blast_radius": {"enum": ["SYSTEM", "REPOSITORY", "COMPONENT", "LOCAL"]},
    "dependency_finding_ids": {"$ref": "#/$defs/ids"},
    "conflict_finding_ids": {"$ref": "#/$defs/ids"},
    "proposed_repair_class": {"enum": [
      "SAFETY_SECURITY_DATA_BLOCKER", "CHARACTERIZATION_CONTRACT", "ARCHITECTURAL_PREREQUISITE", "STRUCTURAL_BOUNDARY",
      "SHARED_SECURITY_DATA_CONCURRENCY", "SHARED_SEAM_CONTRACT", "FEATURE_CORRECTNESS",
      "ACCESS_VALIDATION_OBSERVABILITY_PERFORMANCE", "DUPLICATION_SIMPLIFICATION", "LOCALIZED_QUALITY",
      "DOCUMENTATION_TEST_ORGANIZATION", "RELEASE_METADATA_HYGIENE"
    ]},
    "focused_proof_contract": {"$ref": "#/$defs/evidenceContract"},
    "independent_acceptance_contract": {"$ref": "#/$defs/evidenceContract"},
    "evidence_ceiling": {"$ref": "#/$defs/evidenceCeiling"},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "finding_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "nonemptyStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_id", "source_identity_sha256", "source_ref", "observed_at_utc", "observer_role", "statement", "observation_sha256"],
      "properties": {
        "observation_id": {"$ref": "#/$defs/id"}, "source_identity_sha256": {"$ref": "#/$defs/sha256"},
        "source_ref": {"type": "string", "minLength": 1}, "observed_at_utc": {"type": "string", "format": "date-time"},
        "observer_role": {"$ref": "#/$defs/id"}, "statement": {"type": "string", "minLength": 1}, "observation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "kind", "source_observation_id", "artifact_sha256", "claim", "evidence_class", "evidence_sha256"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/id"}, "kind": {"$ref": "#/$defs/id"}, "source_observation_id": {"$ref": "#/$defs/id"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"}, "claim": {"type": "string", "minLength": 1},
        "evidence_class": {"enum": ["DIRECT", "DETERMINISTIC", "INDEPENDENT", "REAL_HOST"]}, "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidenceContract": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "version", "contract_kind", "required_checks", "required_evidence_classes", "prohibited_claims", "contract_sha256"],
      "properties": {
        "schema": {"const": "agentos.finding_evidence_contract.v1"}, "version": {"const": 1},
        "contract_kind": {"enum": ["FOCUSED_PROOF", "INDEPENDENT_ACCEPTANCE"]},
        "required_checks": {"$ref": "#/$defs/nonemptyStrings"}, "required_evidence_classes": {"$ref": "#/$defs/nonemptyStrings"},
        "prohibited_claims": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "contract_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidenceCeiling": {
      "type": "object", "additionalProperties": false,
      "required": ["available_local_checks", "unavailable_proof", "real_host_required", "real_host_status", "mandatory_retest", "max_claim", "ceiling_sha256"],
      "properties": {
        "available_local_checks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "unavailable_proof": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "real_host_required": {"type": "boolean"}, "real_host_status": {"enum": ["NOT_REQUIRED", "UNTESTED_DEFERRED", "PASSED", "FAILED"]},
        "mandatory_retest": {"type": ["string", "null"]}, "max_claim": {"enum": ["OBSERVED_ONLY", "REPRODUCED", "LOCALLY_PROVEN", "REAL_HOST_PROVEN"]},
        "ceiling_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false, "required": ["status", "history"],
      "properties": {
        "status": {"enum": ["OPEN", "CONSOLIDATED", "PLANNED", "IN_REPAIR", "CANDIDATE_REJECTED", "REPAIRED_PENDING_REAUDIT", "ACCEPTED", "REOPENED", "DEFERRED_REAL_HOST", "REJECTED_FALSE_POSITIVE", "BLOCKED_EXACT"]},
        "history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/historyEvent"}}
      }
    },
    "historyEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "from_status", "to_status", "event", "at_utc", "actor_role", "reason", "evidence_sha256", "candidate_id", "failure_signature_sha256", "recovery_route_id", "event_sha256"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "from_status": {"type": ["string", "null"]},
        "to_status": {"enum": ["OPEN", "CONSOLIDATED", "PLANNED", "IN_REPAIR", "CANDIDATE_REJECTED", "REPAIRED_PENDING_REAUDIT", "ACCEPTED", "REOPENED", "DEFERRED_REAL_HOST", "REJECTED_FALSE_POSITIVE", "BLOCKED_EXACT"]},
        "event": {"$ref": "#/$defs/id"}, "at_utc": {"type": "string", "format": "date-time"}, "actor_role": {"$ref": "#/$defs/id"},
        "reason": {"type": "string", "minLength": 1}, "evidence_sha256": {"$ref": "#/$defs/sha256"}, "candidate_id": {"type": ["string", "null"]},
        "failure_signature_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "recovery_route_id": {"type": ["string", "null"]},
        "event_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
