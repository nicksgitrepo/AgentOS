{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.canonical_campaign_orchestration.v1",
  "title": "Canonical campaign orchestration result",
  "description": "The privacy-safe integration result for Bootstrap admission through persistent Runtime supervision, native worker/Auditor closure, acceptance, and the owner's selected review result.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "activation_status", "admission_sha256", "bootstrap_plan_sha256", "parallel_plan_sha256", "runtime", "workers", "acceptance", "delivery", "closure", "result_sha256"],
  "properties": {
    "schema": {"const": "agentos.canonical_campaign_orchestration.v1"},
    "version": {"const": 1},
    "status": {"enum": ["CLOSED", "BLOCKED"]},
    "activation_status": {"const": "PREPARED_NOT_ACTIVATED"},
    "admission_sha256": {"$ref": "#/$defs/sha256"},
    "bootstrap_plan_sha256": {"$ref": "#/$defs/sha256"},
    "parallel_plan_sha256": {"$ref": "#/$defs/sha256"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "workers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/worker"}},
    "acceptance": {"$ref": "#/$defs/acceptance"},
    "delivery": {"$ref": "#/$defs/delivery"},
    "closure": {"oneOf": [{"type": "null"}, {"$ref": "./canonical-campaign-closure.v1.json"}]},
    "result_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "CLOSED"}}},
      "then": {
        "properties": {
          "closure": {"$ref": "./canonical-campaign-closure.v1.json"},
          "acceptance": {"properties": {"status": {"const": "ACCEPTED"}}},
          "delivery": {"properties": {"status": {"const": "COMPLETE"}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "BLOCKED"}}},
      "then": {"properties": {"closure": {"type": "null"}}}
    }
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]*$"},
    "reference": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "sessionRef": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^opaque:session:[0-9a-f]{64}$"}]},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_ref", "status", "state_sha256", "checkpoint_sha256", "event_cursor", "roles_sha256"],
      "properties": {
        "runtime_ref": {"type": "string", "pattern": "^RUNTIME_REF_[0-9a-f]{64}$"},
        "status": {"enum": ["ACTIVE", "AWAITING_ACCEPTANCE", "CLOSED", "HARD_STOPPED", "REPLACEMENT_REQUIRED"]},
        "state_sha256": {"$ref": "#/$defs/sha256"},
        "checkpoint_sha256": {"$ref": "#/$defs/nullableSha256"},
        "event_cursor": {"type": "integer", "minimum": 1},
        "roles_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_ref", "lane_id", "session_ref", "progress_sha256", "handoff_sha256", "audit_sha256", "auditor_ref", "auditor_session_ref", "native_request_sha256", "native_session_sha256", "native_closure_sha256", "native_auditor_request_sha256", "native_auditor_session_sha256", "native_auditor_closure_sha256"],
      "properties": {
        "worker_ref": {"$ref": "#/$defs/reference"},
        "lane_id": {"$ref": "#/$defs/identifier"},
        "session_ref": {"$ref": "#/$defs/sessionRef"},
        "progress_sha256": {"$ref": "#/$defs/nullableSha256"},
        "handoff_sha256": {"$ref": "#/$defs/nullableSha256"},
        "audit_sha256": {"$ref": "#/$defs/nullableSha256"},
        "auditor_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reference"}]},
        "auditor_session_ref": {"$ref": "#/$defs/sessionRef"},
        "native_request_sha256": {"$ref": "#/$defs/nullableSha256"},
        "native_session_sha256": {"$ref": "#/$defs/nullableSha256"},
        "native_closure_sha256": {"$ref": "#/$defs/nullableSha256"},
        "native_auditor_request_sha256": {"$ref": "#/$defs/nullableSha256"},
        "native_auditor_session_sha256": {"$ref": "#/$defs/nullableSha256"},
        "native_auditor_closure_sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "accepted_worker_count", "final_evidence_sha256"],
      "properties": {
        "status": {"enum": ["ACCEPTED", "NOT_REACHED", "REJECTED"]},
        "accepted_worker_count": {"type": "integer", "minimum": 0},
        "final_evidence_sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "owner_choice", "policy_sha256", "result", "result_sha256"],
      "properties": {
        "status": {"enum": ["COMPLETE", "NOT_REACHED"]},
        "owner_choice": {"enum": ["REVIEW", "BRANCH", "PUSH", "MERGE", "DEPLOY", "RELEASE"]},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "result": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "result_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
