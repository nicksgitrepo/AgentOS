{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/oidc-core-gate-execution.v1.json",
  "title": "Executable OIDC Core gate-tree readback",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "block_id", "evaluator_entrypoint", "ordered_gate_ids", "executions", "execution_sha256"],
  "properties": {
    "schema": {"const": "agentos.oidc_core_gate_execution.v1"},
    "version": {"const": 1},
    "block_id": {"const": "specialist.security.oidc-core"},
    "evaluator_entrypoint": {"const": "control/oidc-core-package-evaluator.mjs#evaluateOidcCorePackage"},
    "ordered_gate_ids": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": "string"}},
    "executions": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["gate_id", "fixture_class", "expected"], "properties": {"gate_id": {"type": "string"}, "fixture_class": {"type": "string"}, "expected": {"type": "object", "additionalProperties": false, "required": ["disposition", "route", "error_code", "zero_side_effects", "acceptance_allowed"], "properties": {"disposition": {"enum": ["DENY", "ESCALATE", "ROUTE"]}, "route": {"type": "string"}, "error_code": {"type": "string"}, "zero_side_effects": {"const": true}, "acceptance_allowed": {"const": false}}}}}},
    "execution_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
