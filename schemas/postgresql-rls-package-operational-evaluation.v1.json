{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/postgresql-rls-package-operational-evaluation.v1.json",
  "title": "Project-agnostic PostgreSQL RLS executable package evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "block_id", "lifecycle", "activation", "package_root_sha256", "package_block_sha256", "gate_inventory_sha256", "fixture_inventory_sha256", "gate_execution", "fixture_results", "mutation_sensitivity", "independent_signature_required", "observed_at_utc", "source_manifest_sha256", "source_effective_date", "source_retrieved_date", "model_snapshot_sha256", "model_route_sha256", "context_receipt_sha256", "upstream_router_result_sha256", "gate_semantic_inventory_sha256", "evaluation_file_sha256", "handoff_file_sha256", "evaluation_sha256"],
  "properties": {
    "schema": {"const": "agentos.specialist_postgresql_rls_package_operational_evaluation.v1"}, "version": {"const": 1}, "status": {"const": "PASS"}, "block_id": {"const": "specialist.data.postgresql-rls"}, "lifecycle": {"const": "CANDIDATE"}, "activation": {"const": "OFF"},
    "package_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "package_block_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "gate_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "fixture_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "gate_execution": {"type": "array", "minItems": 12, "maxItems": 12}, "fixture_results": {"type": "array", "minItems": 17, "maxItems": 17},
    "mutation_sensitivity": {"type": "object", "additionalProperties": false, "required": ["status", "mutation_detected", "expected_disposition", "observed_disposition", "result_sha256"], "properties": {"status": {"const": "WEAKENED"}, "mutation_detected": {"const": true}, "expected_disposition": {"const": "DENY"}, "observed_disposition": {"const": "ROUTE"}, "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}, "independent_signature_required": {"const": true}, "observed_at_utc": {"type": "string", "format": "date-time"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source_effective_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "source_retrieved_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "model_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "model_route_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "context_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "upstream_router_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "gate_semantic_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "evaluation_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "handoff_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "roster_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "evaluation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
