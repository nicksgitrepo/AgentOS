{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/specialist-standard-supersession.v1.json",
  "title": "AgentOS Reusable Standard Block Supersession Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "block_id", "status", "superseded_by", "known_non_superseding", "rule"],
  "properties": {
    "schema": {"const": "agentos.specialist_standard_supersession.v1"},
    "version": {"const": 1},
    "block_id": {"type": "string", "pattern": "^specialist\\.[a-z0-9-]+\\.[a-z0-9-]+$"},
    "status": {"type": "string", "minLength": 1},
    "superseded_by": {"type": ["object", "null"]},
    "known_non_superseding": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["identifier", "edition", "status", "source_url"], "properties": {"identifier": {"type": "string", "minLength": 1}, "edition": {"type": "string", "minLength": 1}, "status": {"type": "string", "minLength": 1}, "source_url": {"type": "string", "pattern": "^https?://"}}}},
    "rule": {"type": "string", "minLength": 1}
  }
}
