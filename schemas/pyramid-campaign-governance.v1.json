    "candidate": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "candidate_sha256", "worktree_ref", "rollback_ref", "clean", "source_roots_preserved", "status"], "properties": {"candidate_id": {"$ref": "#/$defs/identifier"}, "candidate_sha256": {"$ref": "#/$defs/sha256"}, "worktree_ref": {"$ref": "#/$defs/reference"}, "rollback_ref": {"$ref": "#/$defs/reference"}, "clean": {"const": true}, "source_roots_preserved": {"const": true}, "status": {"enum": ["PREPARED_ISOLATED_CANDIDATE", "CUMULATIVE_CANDIDATE"]}}},
    "handoff": {"type": "object", "additionalProperties": false, "required": ["schema", "version", "lane_id", "specialist_id", "wave_index", "task_ref", "worktree_ref", "base_candidate_sha256", "finding_sha256", "repair_candidate_sha256", "evidence_sha256", "hostile_fixture_refs", "source_binding_sha256", "custody", "rollback_ref", "status", "handoff_sha256"], "properties": {"schema": {"const": "agentos.pyramid_campaign_governance.v1.handoff"}, "version": {"const": 1}, "lane_id": {"$ref": "#/$defs/identifier"}, "specialist_id": {"$ref": "#/$defs/identifier"}, "wave_index": {"type": "integer", "minimum": 1}, "task_ref": {"$ref": "#/$defs/reference"}, "worktree_ref": {"$ref": "#/$defs/reference"}, "base_candidate_sha256": {"$ref": "#/$defs/sha256"}, "finding_sha256": {"$ref": "#/$defs/sha256"}, "repair_candidate_sha256": {"$ref": "#/$defs/sha256"}, "evidence_sha256": {"$ref": "#/$defs/sha256"}, "hostile_fixture_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}}, "source_binding_sha256": {"$ref": "#/$defs/sha256"}, "custody": {"$ref": "#/$defs/custody"}, "rollback_ref": {"$ref": "#/$defs/reference"}, "status": {"const": "TYPED_FINDING_AND_REPAIR_READY"}, "handoff_sha256": {"$ref": "#/$defs/sha256"}}},
    "custody": {"type": "object", "additionalProperties": false, "required": ["isolated_worktree", "shared_workspace_read_only", "source_roots_preserved", "product_mutation", "provider_access", "credential_access", "external_sync", "spend", "destructive_work", "heavyweight_processes", "timer_count", "polling"], "properties": {"isolated_worktree": {"const": true}, "shared_workspace_read_only": {"const": true}, "source_roots_preserved": {"const": true}, "product_mutation": {"const": false}, "provider_access": {"const": false}, "credential_access": {"const": false}, "external_sync": {"const": false}, "spend": {"const": false}, "destructive_work": {"const": false}, "heavyweight_processes": {"type": "integer", "minimum": 0, "maximum": 1}, "timer_count": {"const": 0}, "polling": {"const": false}}},
    "finalReview": {"type": "object", "additionalProperties": false, "required": ["reviewer_role", "candidate_sha256", "coherence_evidence_sha256", "release_evidence_sha256", "residual_risk_sha256", "accepted", "review_sha256"], "properties": {"reviewer_role": {"const": "FINAL_HIGHER_TIER_COHERENCE_POLISH_REVIEWER"}, "candidate_sha256": {"$ref": "#/$defs/sha256"}, "coherence_evidence_sha256": {"$ref": "#/$defs/sha256"}, "release_evidence_sha256": {"$ref": "#/$defs/sha256"}, "residual_risk_sha256": {"$ref": "#/$defs/sha256"}, "accepted": {"const": true}, "review_sha256": {"$ref": "#/$defs/sha256"}}},
    "independentReaudit": {"type": "object", "additionalProperties": false, "required": ["reviewer_role", "candidate_sha256", "evidence_sha256", "residual_risk_sha256", "accepted", "reaudit_sha256"], "properties": {"reviewer_role": {"const": "INDEPENDENT_CANDIDATE_REAUDITOR"}, "candidate_sha256": {"$ref": "#/$defs/sha256"}, "evidence_sha256": {"$ref": "#/$defs/sha256"}, "residual_risk_sha256": {"$ref": "#/$defs/sha256"}, "accepted": {"const": true}, "reaudit_sha256": {"$ref": "#/$defs/sha256"}}},
    "pyramidImportOutput": {"type": "object", "additionalProperties": false, "required": ["schema", "version", "project_id", "status", "legacy", "candidate_repositories", "pyramid", "git_repoint", "output_sha256"], "properties": {"schema": {"const": "agentos.pyramid_import_output.v1"}, "version": {"const": 1}, "project_id": {"type": "string", "minLength": 1}, "status": {"const": "READY_FOR_GIT_REPOINT"}, "legacy": {"type": "object"}, "candidate_repositories": {"type": "array", "minItems": 1}, "pyramid": {"type": "object"}, "git_repoint": {"type": "object"}, "output_sha256": {"$ref": "#/$defs/sha256"}}, "unevaluatedProperties": false},
    "isolatedCandidateAssembly": {"type": "object", "additionalProperties": false, "required": ["schema", "version", "candidate_id", "base_candidate_sha256", "assembled_candidate_sha256", "worktree_ref", "rollback_ref", "source_roots_preserved", "zero_trace", "custody", "proof_refs", "status", "assembly_sha256"], "properties": {"schema": {"const": "agentos.pyramid_campaign_governance.v1.isolated_candidate_assembly"}, "version": {"const": 1}, "candidate_id": {"$ref": "#/$defs/identifier"}, "base_candidate_sha256": {"$ref": "#/$defs/sha256"}, "assembled_candidate_sha256": {"$ref": "#/$defs/sha256"}, "worktree_ref": {"$ref": "#/$defs/reference"}, "rollback_ref": {"$ref": "#/$defs/reference"}, "source_roots_preserved": {"const": true}, "zero_trace": {"const": true}, "custody": {"$ref": "#/$defs/isolatedCandidateCustody"}, "proof_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}}, "status": {"const": "ISOLATED_CUMULATIVE_CANDIDATE_ASSEMBLED"}, "assembly_sha256": {"$ref": "#/$defs/sha256"}}},
    "isolatedCandidateCustody": {"type": "object", "additionalProperties": false, "required": ["isolated_worktree", "shared_workspace_read_only", "source_roots_preserved", "product_mutation", "provider_access", "credential_access", "external_sync", "spend", "destructive_work", "deployment_publication_merge", "release", "heavyweight_processes", "timer_count", "polling"], "properties": {"isolated_worktree": {"const": true}, "shared_workspace_read_only": {"const": true}, "source_roots_preserved": {"const": true}, "product_mutation": {"const": false}, "provider_access": {"const": false}, "credential_access": {"const": false}, "external_sync": {"const": false}, "spend": {"const": false}, "destructive_work": {"const": false}, "deployment_publication_merge": {"const": false}, "release": {"const": false}, "heavyweight_processes": {"const": 0}, "timer_count": {"const": 0}, "polling": {"const": false}}},
    "lanePolicy": {"type": "object", "additionalProperties": false, "required": ["max_active_lanes", "max_heavyweight_processes", "heavyweight_processes", "timers", "polling"], "properties": {"max_active_lanes": {"const": 6}, "max_heavyweight_processes": {"const": 1}, "heavyweight_processes": {"type": "integer", "minimum": 0, "maximum": 1}, "timers": {"const": 0}, "polling": {"const": false}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["roster_derivation", "wave_routing", "isolated_audit_admission", "platform_review_routing", "cumulative_candidate_write", "central_integration", "product_mutation", "provider_access", "credential_access", "external_sync", "spend", "destructive_work", "release"], "properties": {"roster_derivation": {"const": true}, "wave_routing": {"const": true}, "isolated_audit_admission": {"const": true}, "platform_review_routing": {"const": true}, "cumulative_candidate_write": {"const": true}, "central_integration": {"const": false}, "product_mutation": {"const": false}, "provider_access": {"const": false}, "credential_access": {"const": false}, "external_sync": {"const": false}, "spend": {"const": false}, "destructive_work": {"const": false}, "release": {"const": false}}},
    "handler": {"type": "string", "pattern": "^HANDLER\\.[A-Z0-9._:-]+$"},
    "protectedEvent": {"type": "object", "additionalProperties": false, "required": ["blocker_id", "blocker_class", "affected_action", "evidence_ceiling", "restart_event", "resources"], "properties": {"blocker_id": {"$ref": "#/$defs/identifier"}, "blocker_class": {"type": "string"}, "affected_action": {"$ref": "#/$defs/identifier"}, "evidence_ceiling": {"type": "string", "minLength": 24}, "restart_event": {"type": "string", "minLength": 8}, "resources": {"type": "object", "additionalProperties": false, "required": ["jobs", "workers", "heavyweight_processes", "timers"], "properties": {"jobs": {"const": 0}, "workers": {"const": 0}, "heavyweight_processes": {"const": 0}, "timers": {"const": 0}}}}},
    "stopWorkflowDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "decision_id", "action_ref", "rollback_ref", "question_order", "answers", "outcome", "primary_trigger_question_id", "triggered_question_ids", "unknown_question_ids", "next_action", "stop", "owner_decision_required", "reason", "decision_sha256"],
      "properties": {
        "schema": {"const": "agentos.stop_workflow_gate.v1"},
        "version": {"const": 1},
        "decision_id": {"$ref": "#/$defs/identifier"},
        "action_ref": {"$ref": "#/$defs/reference"},
        "rollback_ref": {"$ref": "#/$defs/reference"},
        "question_order": {"const": ["COSTS_MONEY", "CHANGES_PROTECTED_PROJECT_OR_SCOPE", "DELETES_UNSAVED_OR_UNBACKED_UP_WORK", "DESTROYS_OR_IRREVERSIBLY_MODIFIES", "OWNER_DECISION_REQUIRED"]},
        "answers": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/stopWorkflowAnswer"}},
        "outcome": {"enum": ["CONTINUE_AUTONOMOUS", "EVIDENCE_REQUIRED", "STOP_OWNER_DECISION", "STOP_DESTRUCTIVE_BOUNDARY"]},
        "primary_trigger_question_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/stopWorkflowQuestionId"}]},
        "triggered_question_ids": {"type": "array", "items": {"$ref": "#/$defs/stopWorkflowQuestionId"}, "uniqueItems": true},
        "unknown_question_ids": {"type": "array", "items": {"$ref": "#/$defs/stopWorkflowQuestionId"}, "uniqueItems": true},
        "next_action": {"enum": ["CONTINUE_NEXT_ACTION", "RUN_NEXT_BOUNDED_RECOVERY", "STOP_DEPENDENT_WORK_OWNER_REVIEW", "STOP_DEPENDENT_WORK_DESTRUCTIVE_REVIEW"]},
        "stop": {"type": "boolean"},
        "owner_decision_required": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 24},
        "decision_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "stopWorkflowQuestionId": {"enum": ["COSTS_MONEY", "CHANGES_PROTECTED_PROJECT_OR_SCOPE", "DELETES_UNSAVED_OR_UNBACKED_UP_WORK", "DESTROYS_OR_IRREVERSIBLY_MODIFIES", "OWNER_DECISION_REQUIRED"]},
    "stopWorkflowAnswer": {"type": "object", "additionalProperties": false, "required": ["question_id", "answer", "evidence_refs"], "properties": {"question_id": {"$ref": "#/$defs/stopWorkflowQuestionId"}, "answer": {"enum": ["YES", "NO", "UNKNOWN"]}, "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}}}}
  }
}
