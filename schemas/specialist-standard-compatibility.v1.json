{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/specialist-standard-compatibility.v1.json",
  "title": "AgentOS Reusable Standard Block Compatibility Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "block_id", "current_edition", "compatible_predecessors", "rule"],
  "properties": {
    "schema": {"const": "agentos.specialist_standard_compatibility.v1"},
    "version": {"const": 1},
    "block_id": {"type": "string", "pattern": "^specialist\\.[a-z0-9-]+\\.[a-z0-9-]+$"},
    "current_edition": {"type": "string", "minLength": 1},
    "compatible_predecessors": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "rule": {"type": "string", "minLength": 1}
  }
}
