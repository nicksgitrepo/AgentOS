{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.project_owner_conversation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "authority_status", "speaker_role", "explanation_level", "message", "choices", "technical_details_hidden", "private_evidence_refs", "conversation_sha256"],
  "properties": {
    "schema": {"const": "agentos.project_owner_conversation.v1"}, "version": {"const": 1},
    "authority_status": {"const": "NON_AUTHORITATIVE_TEMPLATE"},
    "speaker_role": {"const": "AGENTOS.PRODUCT_OWNER"},
    "explanation_level": {"enum": ["SIMPLE", "ELABORATE", "ADVANCED"]},
    "message": {"type": "string", "minLength": 1},
    "choices": {"type": "array", "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["key", "label", "meaning"], "properties": {"key": {"type": "string", "pattern": "^(?:[1-4]|[a-d]|n)$"}, "label": {"type": "string", "minLength": 1}, "meaning": {"type": "string", "minLength": 1}}}},
    "technical_details_hidden": {"type": "boolean"},
    "private_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:opaque:|ref:)"}},
    "conversation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
