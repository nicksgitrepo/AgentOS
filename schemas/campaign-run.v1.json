{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.campaign_run.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "plan_digest", "project_id", "campaign_id", "campaign_version", "goal_id", "goal_sha256", "phase_index", "lane_index", "lane_results", "phase_results", "digest"],
  "properties": {
    "schema": { "const": "agentos.campaign_run.v1" },
    "version": { "const": 1 },
    "status": { "enum": ["ACTIVE", "COMPLETE"] },
    "plan_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "project_id": { "type": "string" },
    "campaign_id": { "type": "string" },
    "campaign_version": { "type": "string", "pattern": "^(?:v[0-9]+[.][0-9]+[.][0-9]+(?:-(?:tb|rc)-[0-9]+)?|[A-Z][A-Z0-9._-]*)$" },
    "goal_id": { "type": "string" },
    "goal_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "phase_index": { "type": "integer", "minimum": 0 },
    "lane_index": { "type": "integer", "minimum": 0 },
    "lane_results": { "type": "array" },
    "phase_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase_id", "lane_ids", "reviewed_lane_ids", "auditor_session_id", "acceptance_digest", "status"],
        "properties": {
          "phase_id": { "type": "string" },
          "lane_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "reviewed_lane_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "auditor_session_id": { "type": "string", "pattern": "^SESSION_REF_[0-9a-f]{64}$" },
          "acceptance_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "status": { "const": "ACCEPTED" }
        }
      }
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
