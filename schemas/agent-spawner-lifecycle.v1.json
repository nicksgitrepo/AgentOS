{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/agent-spawner-lifecycle.v1.json",
  "title": "AgentOS Agent Spawner Lifecycle",
  "description": "Project-agnostic lifecycle for the persistent no-side-effect Agent Spawner compiler and separately admitted governed worker spawning. In COMPILER_ONLY mode, local QA/import planning must continue and complete routes must hand off to ADMIT_GOVERNED_SPAWN even when independent clearance is pending; compiler-only state cannot enter a protected stall, and only the governed adapter/readback may admit workers or activate waves.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "lifecycle_id", "role_id", "mode", "state", "persistent_state", "wave_activation", "candidate_sha256",
    "roster_projection_sha256", "context_sha256", "qa", "authority", "execution", "protected_hold_event_sha256", "next_action",
    "atomic_admission_binding", "lifecycle_sha256"
  ],
  "properties": {
    "schema": {"const": "agentos.agent_spawner_lifecycle.v1"},
    "version": {"const": 1},
    "lifecycle_id": {"$ref": "#/$defs/identifier"},
    "role_id": {"const": "AGENT.SPAWNER_COMPILER"},
    "mode": {"enum": ["COMPILER_ONLY", "GOVERNED_SPAWN"]},
    "state": {"enum": ["PREPARED", "QA_READY", "COMPILER_ACTIVE", "SPAWN_ADMITTED", "SPAWN_ACTIVE", "STALLED", "RETIRED"]},
    "persistent_state": {"enum": ["PREPARED", "QA_READY", "COMPILER_ACTIVE", "ADMITTED", "ACTIVE", "STALLED", "RETIRED"]},
    "wave_activation": {"enum": ["OFF", "ON"]},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "roster_projection_sha256": {"$ref": "#/$defs/sha256"},
    "context_sha256": {"$ref": "#/$defs/sha256"},
    "qa": {"$ref": "#/$defs/qa"},
    "authority": {"$ref": "#/$defs/authority"},
    "execution": {"$ref": "#/$defs/execution"},
    "protected_hold_event_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "next_action": {"enum": ["START_COMPILER", "COMPILE_NEXT_BLOCK", "PUBLISH_TYPED_ROSTER", "WAIT_FOR_INDEPENDENT_CLEARANCE", "ADMIT_GOVERNED_SPAWN", "START_GOVERNED_SPAWN", "WAIT_FOR_OWNER_OR_PROTECTED_DEPENDENCY_EVENT", "NONE"]},
    "atomic_admission_binding": {"anyOf": [{"$ref": "#/$defs/atomic_admission_lifecycle_binding"}, {"type": "null"}]},
    "lifecycle_sha256": {"$ref": "#/$defs/sha256"},
    "storage_decision": {"$ref": "#/$defs/storage_decision"},
    "routing_receipt": {"$ref": "#/$defs/routing_receipt"},
    "routing_payload": {"$ref": "#/$defs/routing_payload"},
    "atomic_admission": {"$ref": "#/$defs/atomic_admission"}
  },
  "allOf": [
    {"if": {"properties": {"state": {"enum": ["SPAWN_ADMITTED", "SPAWN_ACTIVE"]}}}, "then": {"properties": {"qa": {"properties": {
      "incomplete_block_count": {"const": 0},
      "pending_route_count": {"const": 0}
    }}}}},
    {"if": {"properties": {"state": {"const": "STALLED"}}}, "then": {"properties": {
      "mode": {"const": "GOVERNED_SPAWN"},
      "qa": {"properties": {
        "incomplete_block_count": {"const": 0},
        "pending_route_count": {"const": 0},
        "independent_clearance_status": {"const": "PENDING_EXTERNAL_AUTHORITY"}
      }}
    }}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{0,191}$"},
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "complete_block_count", "incomplete_block_count", "pending_route_count", "independent_clearance_status", "independent_clearance_receipt_sha256"],
      "properties": {
        "status": {"enum": ["NOT_READY", "STATIC_PASS_REVIEW_REQUIRED", "INDEPENDENT_PASS"]},
        "complete_block_count": {"type": "integer", "minimum": 0},
        "incomplete_block_count": {"type": "integer", "minimum": 0},
        "pending_route_count": {"type": "integer", "minimum": 0},
        "independent_clearance_status": {"enum": ["PENDING_EXTERNAL_AUTHORITY", "CLEARED", "REJECTED"]},
        "independent_clearance_receipt_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compiler_authority", "temporary_worker_admission", "spawn_authority", "product_mutation", "provider_access", "credential_access", "external_sync", "isolated_local_custody", "independent_evaluation_required"],
      "properties": {
        "compiler_authority": {"const": true},
        "temporary_worker_admission": {"type": "boolean"},
        "spawn_authority": {"type": "boolean"},
        "product_mutation": {"const": false},
        "provider_access": {"const": false},
        "credential_access": {"const": false},
        "external_sync": {"const": false},
        "isolated_local_custody": {"type": "boolean"},
        "independent_evaluation_required": {"const": true}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compiler_ticks", "active_worker_count", "scheduler_job_count", "heavyweight_process_count", "timer_count", "polling"],
      "properties": {
        "compiler_ticks": {"type": "integer", "minimum": 0},
        "active_worker_count": {"type": "integer", "minimum": 0},
        "scheduler_job_count": {"type": "integer", "minimum": 0},
        "heavyweight_process_count": {"type": "integer", "minimum": 0},
        "timer_count": {"type": "integer", "minimum": 0},
        "polling": {"type": "boolean"}
      }
    },
    "atomic_admission_lifecycle_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "version", "admission_id", "task_id", "role_id", "project_id", "environment", "cwd", "worktree",
        "custody_ref", "receipt_sha256", "readback_bundle_sha256", "binding_sha256"
      ],
      "properties": {
        "schema": {"const": "agentos.agent_spawner_atomic_admission_lifecycle_binding.v1"},
        "version": {"const": 1},
        "admission_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "role_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "environment": {"const": "local"},
        "cwd": {"type": "string", "pattern": "^/[^\\u0000-\\u001f\\u007f]+$"},
        "worktree": {"type": "string", "pattern": "^/[^\\u0000-\\u001f\\u007f]+$"},
        "custody_ref": {"type": "string", "pattern": "^(?:opaque:|ref:)[^\\s]+$"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "readback_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "binding_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "storage_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "version", "receipt_id", "monitor_role", "observed_at_utc", "free_gib", "threshold_class",
        "policy", "current_issue", "next_issue", "cleanup", "ordinary_agents", "custody", "previous_receipt_sha256",
        "hostile_fixture_refs", "receipt_sha256"
      ],
      "properties": {
        "schema": {"const": "agentos.agent_spawner_storage_governance.v1"},
        "version": {"const": 1},
        "receipt_id": {"$ref": "#/$defs/identifier"},
        "monitor_role": {"const": "CONTROLLER"},
        "observed_at_utc": {"type": "string", "format": "date-time"},
        "free_gib": {"type": "number", "minimum": 0},
        "threshold_class": {"enum": ["HARD_FLOOR", "OWNER_WARNING", "BELOW_CLEANUP_TARGET", "CLEANUP_TARGET", "ABOVE_CLEANUP_TARGET"]},
        "policy": {
          "type": "object", "additionalProperties": false,
          "required": ["monitor_owner", "monitor_interval_hours", "ordinary_agents_poll_storage", "cleanup_target_free_gib", "owner_warning_at_or_below_free_gib", "hard_operating_floor_at_or_below_free_gib", "below_target_current_issue_transition", "cleanup_safety"],
          "properties": {
            "monitor_owner": {"const": "CONTROLLER_ONLY"},
            "monitor_interval_hours": {"const": 24},
            "ordinary_agents_poll_storage": {"const": false},
            "cleanup_target_free_gib": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum", "work_stopping_floor"], "properties": {"minimum": {"const": 80}, "maximum": {"const": 100}, "work_stopping_floor": {"const": false}}},
            "owner_warning_at_or_below_free_gib": {"const": 50},
            "hard_operating_floor_at_or_below_free_gib": {"const": 25},
            "below_target_current_issue_transition": {"type": "array", "const": ["FINISH_AND_VERIFY_CURRENT_ISSUE", "FREEZE_EXACT_CANDIDATE", "HANDOFF_AND_COMPLETE_AUTHORIZED_RUNTIME_DELIVERY", "ADMIT_NO_NEXT_ISSUE", "CONTROLLER_RUNS_CUSTODY_SAFE_CLEANUP_TOWARD_80_TO_100_GIB", "RESUME_NEXT_ISSUE_AFTER_CLEANUP_TRANSITION_CLOSES"]},
            "cleanup_safety": {"type": "object", "additionalProperties": false, "required": ["preserve_active_or_unmerged_work", "ambiguous_custody_cleanup_forbidden", "allowed_classes"], "properties": {"preserve_active_or_unmerged_work": {"const": true}, "ambiguous_custody_cleanup_forbidden": {"const": true}, "allowed_classes": {"type": "array", "const": ["PROVEN_SAFE_DISPOSABLE_DATA", "STALE_CACHES", "REDUNDANT_BUILD_OUTPUTS", "CLEAN_RELEASED_WORKTREES"]}}}
          }
        },
        "current_issue": {"type": "object", "additionalProperties": false, "required": ["status", "work_allowed", "storage_heavy_work_allowed", "finish_verify_freeze_handoff_required", "runtime_delivery_allowed"], "properties": {"status": {"type": "string", "minLength": 1}, "work_allowed": {"type": "boolean"}, "storage_heavy_work_allowed": {"type": "boolean"}, "finish_verify_freeze_handoff_required": {"type": "boolean"}, "runtime_delivery_allowed": {"type": "boolean"}}},
        "next_issue": {"type": "object", "additionalProperties": false, "required": ["admission", "allowed", "blocked_reason"], "properties": {"admission": {"enum": ["ADMIT_AFTER_DAILY_TRANSITION", "DENY_DURING_CLEANUP", "DENY_HARD_OPERATING_FLOOR"]}, "allowed": {"type": "boolean"}, "blocked_reason": {"type": ["string", "null"]}}},
        "cleanup": {"type": "object", "additionalProperties": false, "required": ["required", "action", "target_min_gib", "target_max_gib", "attempted", "reached_target", "owner_alert", "resume_above_gib"], "properties": {"required": {"type": "boolean"}, "action": {"enum": ["NO_CLEANUP_REQUIRED", "CONTROLLER_RUNS_CUSTODY_SAFE_CLEANUP_TOWARD_80_TO_100_GIB", "ALERT_OWNER_AND_WAIT_FOR_RECOVERY_AUTHORITY"]}, "target_min_gib": {"const": 80}, "target_max_gib": {"const": 100}, "attempted": {"type": "boolean"}, "reached_target": {"type": ["boolean", "null"]}, "owner_alert": {"type": "boolean"}, "resume_above_gib": {"const": 25}}},
        "ordinary_agents": {"type": "object", "additionalProperties": false, "required": ["polling_allowed", "decision"], "properties": {"polling_allowed": {"const": false}, "decision": {"const": "REJECT_REPEATED_STORAGE_POLL"}}},
        "custody": {"type": "object", "additionalProperties": false, "required": ["active_or_unmerged_preserved", "ambiguous_custody_cleanup_forbidden", "cleanup_allowed"], "properties": {"active_or_unmerged_preserved": {"const": true}, "ambiguous_custody_cleanup_forbidden": {"const": true}, "cleanup_allowed": {"type": "boolean"}}},
        "previous_receipt_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "hostile_fixture_refs": {"type": "array", "const": ["FIXTURE.STORAGE.79_GIB_ORDINARY_COMPILE_AND_TEST", "FIXTURE.STORAGE.79_GIB_CONTROLLER_DAILY_CLEANUP", "FIXTURE.STORAGE.CLEANUP_FAILURE_ALERT_RESUME_ABOVE_25", "FIXTURE.STORAGE.50_GIB_OWNER_WARNING", "FIXTURE.STORAGE.25_GIB_HARD_STOP", "FIXTURE.STORAGE.ORDINARY_AGENT_POLL_REJECTED", "FIXTURE.STORAGE.DUPLICATE_DAILY_CHECK_REJECTED", "FIXTURE.STORAGE.AMBIGUOUS_CUSTODY_CLEANUP_REJECTED", "FIXTURE.STORAGE.NEXT_ISSUE_DURING_CLEANUP_REJECTED", "FIXTURE.STORAGE.HISTORICAL_RECEIPT_CANNOT_OVERRIDE"]},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "routing_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "version", "routing_receipt_id", "route_id", "recipient_ref", "receipt_path", "final_receipt_ref",
        "final_receipt_bytes_sha256", "final_receipt_bytes_verified", "status", "finalized_before_route", "route_emitted",
        "post_route_mutation_forbidden", "historical_receipt_ref", "historical_receipt_bytes_sha256", "successor_receipt_ref",
        "fresh_replacement_authority_sha256", "product_verdict_inherited", "product_verdict", "hostile_fixture_refs", "receipt_sha256"
      ],
      "properties": {
        "schema": {"const": "agentos.agent_spawner_routing_receipt.v1"},
        "version": {"const": 1},
        "routing_receipt_id": {"$ref": "#/$defs/identifier"},
        "route_id": {"$ref": "#/$defs/identifier"},
        "recipient_ref": {"type": "string", "pattern": "^(?:opaque:|ref:)[^\\s]+$"},
        "receipt_path": {"type": "string", "pattern": "^(?:opaque:|ref:)[^\\s]+$"},
        "final_receipt_ref": {"type": "string", "pattern": "^(?:opaque:|ref:)[^\\s]+$"},
        "final_receipt_bytes_sha256": {"$ref": "#/$defs/sha256"},
        "final_receipt_bytes_verified": {"type": "boolean"},
        "status": {"const": "FINALIZED"},
        "finalized_before_route": {"const": true},
        "route_emitted": {"const": false},
        "post_route_mutation_forbidden": {"const": true},
        "historical_receipt_ref": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^(?:opaque:|ref:)[^\\s]+$"}]},
        "historical_receipt_bytes_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "successor_receipt_ref": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^(?:opaque:|ref:)[^\\s]+$"}]},
        "fresh_replacement_authority_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "product_verdict_inherited": {"const": false},
        "product_verdict": {"type": "null"},
        "hostile_fixture_refs": {"type": "array", "const": [
          "FIXTURE.ROUTING_RECEIPT.DIGEST_BEFORE_FINAL_WRITE",
          "FIXTURE.ROUTING_RECEIPT.SAME_PATH_POST_ROUTE_MUTATION",
          "FIXTURE.ROUTING_RECEIPT.HISTORICAL_DIGESTS_SEPARATE",
          "FIXTURE.ROUTING_RECEIPT.CORRECTION_NO_VERDICT_INHERITANCE",
          "FIXTURE.ROUTING_RECEIPT.REPLACEMENT_REQUIRES_FRESH_AUTHORITY",
          "FIXTURE.ROUTING_RECEIPT.SUCCESSOR_EXACT_BYTE_RECOMPUTATION"
        ]},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "routing_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "version", "route_id", "recipient_ref", "routing_receipt_ref", "routing_receipt_sha256", "receipt_path",
        "final_receipt_ref", "final_receipt_bytes_sha256", "finalized_before_route", "same_path_mutation_forbidden",
        "replacement_audit_requires_fresh_authority", "payload_sha256"
      ],
      "properties": {
        "schema": {"const": "agentos.agent_spawner_routing_receipt.v1"},
        "version": {"const": 1},
        "route_id": {"$ref": "#/$defs/identifier"},
        "recipient_ref": {"type": "string", "pattern": "^(?:opaque:|ref:)[^\\s]+$"},
        "routing_receipt_ref": {"type": "string", "pattern": "^(?:opaque:|ref:)[^\\s]+$"},
        "routing_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_path": {"type": "string", "pattern": "^(?:opaque:|ref:)[^\\s]+$"},
        "final_receipt_ref": {"type": "string", "pattern": "^(?:opaque:|ref:)[^\\s]+$"},
        "final_receipt_bytes_sha256": {"$ref": "#/$defs/sha256"},
        "finalized_before_route": {"const": true},
        "same_path_mutation_forbidden": {"const": true},
        "replacement_audit_requires_fresh_authority": {"const": true},
        "payload_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "atomic_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "version", "admission_id", "task_id", "role_id", "role_kind", "project_id", "environment", "cwd",
        "worktree", "custody_ref", "model", "reasoning_effort", "queue", "seam", "status", "host_readback_sha256",
        "task_index_readback_sha256", "state_readback_sha256", "process_readback_sha256", "existing_claims_readback_sha256", "existing_claims_authority", "existing_claims_provenance", "substantive_prompt_sent",
        "process_started", "cleanup_action", "retry_allowed", "material_transition", "hostile_fixture_refs", "receipt_sha256"
      ],
      "properties": {
        "schema": {"const": "agentos.agent_spawner_atomic_admission.v1"},
        "version": {"const": 1},
        "admission_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "role_id": {"$ref": "#/$defs/identifier"},
        "role_kind": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "environment": {"const": "local"},
        "cwd": {"type": "string", "pattern": "^/[^\\u0000-\\u001f\\u007f]+$"},
        "worktree": {"type": "string", "pattern": "^/[^\\u0000-\\u001f\\u007f]+$"},
        "custody_ref": {"type": "string", "pattern": "^(?:opaque:|ref:)[^\\s]+$"},
        "model": {"const": "gpt-5.6-luna"},
        "reasoning_effort": {"const": "max"},
        "queue": {"type": "string", "minLength": 1},
        "seam": {"type": "string", "minLength": 1},
        "status": {"const": "ADMITTED"},
        "host_readback_sha256": {"$ref": "#/$defs/sha256"},
        "task_index_readback_sha256": {"$ref": "#/$defs/sha256"},
        "state_readback_sha256": {"$ref": "#/$defs/sha256"},
        "process_readback_sha256": {"$ref": "#/$defs/sha256"},
        "existing_claims_readback_sha256": {"$ref": "#/$defs/sha256"},
        "existing_claims_authority": {"const": "AGENTOS.SPAWNER.IDENTITY_CLAIMS_READBACK"},
        "existing_claims_provenance": {"type": "string", "pattern": "^(?:opaque:|ref:)[^\\s]+$"},
        "substantive_prompt_sent": {"const": false},
        "process_started": {"const": false},
        "cleanup_action": {"const": "NONE"},
        "retry_allowed": {"const": false},
        "material_transition": {"type": "string", "minLength": 1},
        "hostile_fixture_refs": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "minItems": 8},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
