{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/industrial-3d-boundary-result.v1.json",
  "title": "Industrial 3D atomic specialist typed boundary result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "disposition", "route", "analysis_allowed", "routing_allowed", "acceptance_allowed", "asset_mutation_allowed", "engineering_assertion_allowed", "memory_write_allowed", "external_side_effects", "error_code", "input_sha256", "result_sha256"],
  "properties": {
    "schema": {"const": "agentos.industrial_3d_boundary_result.v1"},
    "version": {"const": 1},
    "disposition": {"enum": ["DENY", "ROUTE"]},
    "route": {"type": "string"},
    "analysis_allowed": {"type": "boolean"},
    "routing_allowed": {"type": "boolean"},
    "acceptance_allowed": {"const": false},
    "asset_mutation_allowed": {"const": false},
    "engineering_assertion_allowed": {"const": false},
    "memory_write_allowed": {"const": false},
    "external_side_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_evidence_reads", "asset_writes", "source_reads", "standard_reads", "memory_writes", "engineering_assertions", "acceptance_calls", "credential_accesses", "state_changes"],
      "properties": {
        "asset_evidence_reads": {"const": 0}, "asset_writes": {"const": 0}, "source_reads": {"const": 0}, "standard_reads": {"const": 0}, "memory_writes": {"const": 0},
        "engineering_assertions": {"const": 0}, "acceptance_calls": {"const": 0}, "credential_accesses": {"const": 0}, "state_changes": {"const": 0}
      }
    },
    "error_code": {"type": "string"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selected_specialist": {"const": "specialist.graphics.industrial-3d"},
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "next_action", "execution_instruction"],
      "properties": {"status": {"const": "WAITING_WITH_RECEIPT"}, "next_action": {"type": "string"}, "execution_instruction": {"const": false}}
    }
  }
}
