{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.generated_task_role_packet.v1",
  "title": "AgentOS generated task-role packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "status", "project_id", "task_id_sha256",
    "task_scope_sha256", "task_kind", "role_id", "lane_id",
    "project_contract_sha256", "library_digests", "role_packet_digest",
    "task_gate_context", "task_gate_catalog_sha256", "selected_question_ids",
    "questions", "effective_graph_scope", "authority", "generation",
    "authority_expansion", "digest"
  ],
  "properties": {
    "schema": {"const": "agentos.generated_task_role_packet.v1"},
    "version": {"const": 1},
    "status": {"const": "COMPILED"},
    "project_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]*$"},
    "task_id_sha256": {"$ref": "#/$defs/digest"},
    "task_scope_sha256": {"$ref": "#/$defs/digest"},
    "task_kind": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]*$"},
    "role_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]*$"},
    "lane_id": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[A-Z][A-Z0-9._-]*$"}]},
    "project_contract_sha256": {"$ref": "#/$defs/digest"},
    "library_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_general", "base_role", "project_general", "generated_project_role"],
      "properties": {
        "base_general": {"$ref": "#/$defs/digest"},
        "base_role": {"$ref": "#/$defs/digest"},
        "project_general": {"$ref": "#/$defs/digest"},
        "generated_project_role": {"$ref": "#/$defs/digest"}
      }
    },
    "role_packet_digest": {"$ref": "#/$defs/digest"},
    "task_gate_context": {"enum": ["TASK_START", "CODE_CHANGE", "DOCUMENTATION", "HANDOFF", "RESPONSE", "CLOSURE"]},
    "task_gate_catalog_sha256": {"$ref": "#/$defs/digest"},
    "selected_question_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^TASK-[A-Z]+-[0-9]{3}$"}
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/question"}
    },
    "effective_graph_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph_ids", "graph_digests"],
      "properties": {
        "graph_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]*$"}},
        "graph_digests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/graphDigest"}}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_authority", "prohibited_authority", "required_evidence"],
      "properties": {
        "allowed_authority": {"type": "array", "items": {"type": "string"}},
        "prohibited_authority": {"type": "array", "items": {"type": "string"}},
        "required_evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compiler", "compiler_version", "input_digests"],
      "properties": {
        "compiler": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"},
        "compiler_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "input_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}
      }
    },
    "authority_expansion": {"const": "REJECT"},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "stage", "question", "pass_answer", "applies_to", "required_evidence", "no_route", "unknown_route"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^TASK-[A-Z]+-[0-9]{3}$"},
        "stage": {"type": "string", "pattern": "^TASK_[A-Z]+$"},
        "question": {"type": "string", "minLength": 2},
        "pass_answer": {"enum": ["YES", "NO", "UNKNOWN", "NOT_APPLICABLE"]},
        "applies_to": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "required_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "no_route": {"type": "string", "minLength": 1},
        "unknown_route": {"type": "string", "minLength": 1}
      }
    },
    "graphDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph_id", "graph_sha256", "source"],
      "properties": {
        "graph_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]*$"},
        "graph_sha256": {"$ref": "#/$defs/digest"},
        "source": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"}
      }
    }
  }
}

