{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.project_memory_capsule_import_receipt.v1",
  "title": "AgentOS authoritative project-memory capsule import receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "capsule_id", "capsule_sha256", "appended_event_count",
    "destination_event_count", "destination_head_sha256", "project_tree_touched", "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "agentos.project_memory_capsule_import_receipt.v1"},
    "status": {"enum": ["IMPORTED", "IDEMPOTENT_REPLAY"]},
    "capsule_id": {"$ref": "#/$defs/id"},
    "capsule_sha256": {"$ref": "#/$defs/sha"},
    "appended_event_count": {"type": "integer", "minimum": 0},
    "destination_event_count": {"type": "integer", "minimum": 0},
    "destination_head_sha256": {"$ref": "#/$defs/sha"},
    "project_tree_touched": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
