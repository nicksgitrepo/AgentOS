{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/specialist-integration-handoff.v1.json",
  "title": "AgentOS Specialist Block Library Integration Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "candidate", "library", "inventory", "lanes", "outputs", "receipts", "unfinished_gates", "authority", "next_action"],
  "properties": {
    "schema": {"const": "agentos.specialist_library_integration_handoff.v1"},
    "version": {"const": 1},
    "status": {"enum": ["SPECIALIST_BLOCK_LIBRARY_READY_FOR_AGENTOS_INTAKE", "WAITING_WITH_RECEIPT", "BLOCKED_EXACT"]},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["branch", "commit", "tree", "remote_ref", "activation", "admission"], "properties": {"branch": {"type": "string", "minLength": 1}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "remote_ref": {"type": "string", "minLength": 1}, "activation": {"const": "OFF"}, "admission": {"const": "NOT_ADMITTED"}}},
    "library": {"type": "object", "additionalProperties": false, "required": ["governance_version", "lifecycle", "generic_purity", "compiler_outputs"], "properties": {"governance_version": {"const": "2.1rc"}, "lifecycle": {"const": "CANDIDATE_INACTIVE"}, "generic_purity": {"const": true}, "compiler_outputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 8}}},
    "inventory": {"type": "object", "additionalProperties": false, "required": ["raw_role_mentions", "unique_role_titles", "alias_mappings", "materialized_entries", "role_kind_counts", "compiled_package_counts"], "properties": {"raw_role_mentions": {"const": 625}, "unique_role_titles": {"const": 619}, "alias_mappings": {"const": 10}, "materialized_entries": {"const": 619}, "role_kind_counts": {"type": "object", "additionalProperties": false, "required": ["ROUTER", "CONTROL_PLANE", "KNOWLEDGE_BLOCK", "GOVERNANCE_BLOCK", "STANDARD_BLOCK", "CONTEXT_BLOCK", "ATOMIC_SPECIALIST", "COMPILED_AGENT_PACKAGE"], "properties": {"ROUTER": {"const": 631}, "CONTROL_PLANE": {"const": 13}, "KNOWLEDGE_BLOCK": {"const": 0}, "GOVERNANCE_BLOCK": {"const": 0}, "STANDARD_BLOCK": {"const": 0}, "CONTEXT_BLOCK": {"const": 0}, "ATOMIC_SPECIALIST": {"const": 79}, "COMPILED_AGENT_PACKAGE": {"const": 0}}}, "compiled_package_counts": {"type": "object", "additionalProperties": false, "required": ["total", "ROUTER", "CONTROL_PLANE", "ATOMIC_SPECIALIST", "STANDARD_BLOCK"], "properties": {"total": {"const": 91}, "ROUTER": {"const": 12}, "CONTROL_PLANE": {"const": 13}, "ATOMIC_SPECIALIST": {"const": 51}, "STANDARD_BLOCK": {"const": 15}}}},
    "lanes": {"type": "object", "additionalProperties": false, "required": ["active_count", "wave", "entries"], "properties": {"active_count": {"const": 6}, "wave": {"const": "P0"}, "entries": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["generic_id", "child_id", "package_id", "status"], "properties": {"generic_id": {"type": "string", "minLength": 1}, "child_id": {"type": "string", "minLength": 1}, "package_id": {"type": "string", "minLength": 1}, "status": {"enum": ["ACTIVE_BUILDING", "CANDIDATE", "EVALUATED", "WAITING_WITH_RECEIPT"]}}}}}},
    "outputs": {"type": "object", "additionalProperties": false, "required": ["block_compiler", "loader", "bootstrap_compiler", "schemas", "registry", "human_roster"], "properties": {"block_compiler": {"type": "string", "minLength": 1}, "loader": {"type": "string", "minLength": 1}, "bootstrap_compiler": {"type": "string", "minLength": 1}, "schemas": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "registry": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "human_roster": {"type": "string", "minLength": 1}}},
    "receipts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["receipt_id", "status", "scope"], "properties": {"receipt_id": {"type": "string", "minLength": 1}, "status": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}}}, "minItems": 1},
    "unfinished_gates": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "authority": {"type": "object", "additionalProperties": false, "required": ["scope", "forbidden", "independent_acceptance_required"], "properties": {"scope": {"const": "ISOLATED_AGENTOS_LIBRARY_WORKTREE_ONLY"}, "forbidden": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "independent_acceptance_required": {"const": true}}},
    "next_action": {"type": "string", "minLength": 1}
  }
}
}
