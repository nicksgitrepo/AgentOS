{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.project_governance_appendix.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "project_id", "source_revision", "compatible_release_digests", "graph_bindings", "role_overlays", "digest"],
  "properties": {
    "schema": {"const": "agentos.project_governance_appendix.v1"},
    "version": {"const": 1},
    "status": {"enum": ["ACTIVE", "CLEAN", "ARCHIVED"]},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "source_revision": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "compatible_release_digests": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "graph_bindings": {"type": "array", "items": {"$ref": "#/$defs/graph_binding"}},
    "role_overlays": {"type": "array", "items": {"type": "object"}},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "graph_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph_id", "path", "graph_sha256"],
      "properties": {
        "graph_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "path": {"type": "string", "minLength": 1},
        "graph_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
