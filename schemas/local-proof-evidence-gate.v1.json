{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/local-proof-evidence-gate.v1.json",
  "title": "AgentOS local proof evidence block gate",
  "description": "A fail-closed, project-agnostic gate for a dispatched local proof whose mandatory evidence remains unavailable. It records the exact missing inventory and routes same-turn block repair without implying product or protected work.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "gate_id", "defect_id", "authority_binding", "proof_result", "required_steps", "missing_evidence",
    "decision", "successor", "custody", "evidence_refs", "hostile_fixture_refs", "status", "gate_sha256"
  ],
  "properties": {
    "schema": {"const": "agentos.local_proof_evidence_gate.v1"},
    "version": {"const": 1},
    "gate_id": {"$ref": "#/$defs/identifier"},
    "defect_id": {"$ref": "#/$defs/identifier"},
    "authority_binding": {"$ref": "#/$defs/authorityBinding"},
    "proof_result": {"$ref": "#/$defs/proofResult"},
    "required_steps": {"$ref": "#/$defs/identifierArray"},
    "missing_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/missingEvidence"}
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "proof_claimed", "all_mandatory_steps_satisfied", "next_action", "next_handler", "direct_consumer", "controller_approval_required", "same_turn_dispatch", "protected_event_id"],
      "properties": {
        "status": {"const": "BLOCKED_MISSING_REQUIRED_EVIDENCE"},
        "proof_claimed": {"const": false},
        "all_mandatory_steps_satisfied": {"const": false},
        "next_action": {"const": "REPAIR_BLOCKS"},
        "next_handler": {"const": "HANDLER.ORCHESTRATOR_BLOCK_REPAIR"},
        "direct_consumer": {"const": "INDEPENDENT_PLATFORM_REVIEW"},
        "controller_approval_required": {"const": false},
        "same_turn_dispatch": {"const": true},
        "protected_event_id": {"type": "null"}
      }
    },
    "successor": {"$ref": "#/$defs/successor"},
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_plane_only", "source_roots_preserved", "consumer_product_mutated", "provider_access", "credential_access", "external_sync", "spend", "destructive_work", "deployment", "publication", "merge", "protected_event_id", "timers", "polling"],
      "properties": {
        "control_plane_only": {"const": true},
        "source_roots_preserved": {"const": true},
        "consumer_product_mutated": {"const": false},
        "provider_access": {"const": false},
        "credential_access": {"const": false},
        "external_sync": {"const": false},
        "spend": {"const": false},
        "destructive_work": {"const": false},
        "deployment": {"const": false},
        "publication": {"const": false},
        "merge": {"const": false},
        "protected_event_id": {"type": "null"},
        "timers": {"const": 0},
        "polling": {"const": false}
      }
    },
    "evidence_refs": {"$ref": "#/$defs/evidenceRefs"},
    "hostile_fixture_refs": {"$ref": "#/$defs/identifierArray"},
    "status": {"const": "BLOCKED_MISSING_REQUIRED_EVIDENCE"},
    "gate_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{0,191}$"},
    "identifierArray": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "reference": {"type": "string", "pattern": "^(opaque:|ref:)[^\\s]+$"},
    "authorityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_commit", "authority_tree", "authority_receipt_ref", "authority_receipt_sha256", "source_mapping_sha256"],
      "properties": {
        "authority_commit": {"$ref": "#/$defs/gitObject"},
        "authority_tree": {"$ref": "#/$defs/gitObject"},
        "authority_receipt_ref": {"$ref": "#/$defs/reference"},
        "authority_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "source_mapping_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "proofResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_ref", "result_sha256", "readback_ref", "readback_sha256", "successor_ref", "successor_sha256", "observed_status", "proof_claimed", "all_mandatory_steps_satisfied", "unresolved_required_steps", "evidence_ceiling", "source_action", "source_handler", "handler_invoked", "direct_consumer", "controller_approval_required", "protected_event_id"],
      "properties": {
        "result_ref": {"$ref": "#/$defs/reference"},
        "result_sha256": {"$ref": "#/$defs/sha256"},
        "readback_ref": {"$ref": "#/$defs/reference"},
        "readback_sha256": {"$ref": "#/$defs/sha256"},
        "successor_ref": {"$ref": "#/$defs/reference"},
        "successor_sha256": {"$ref": "#/$defs/sha256"},
        "observed_status": {"const": "LOCAL_PROOF_REQUIRED_EVIDENCE_BLOCKED"},
        "proof_claimed": {"const": false},
        "all_mandatory_steps_satisfied": {"const": false},
        "unresolved_required_steps": {"$ref": "#/$defs/identifierArray"},
        "evidence_ceiling": {"type": "string", "minLength": 24},
        "source_action": {"$ref": "#/$defs/identifier"},
        "source_handler": {"$ref": "#/$defs/identifier"},
        "handler_invoked": {"const": true},
        "direct_consumer": {"const": "INDEPENDENT_PLATFORM_REVIEW"},
        "controller_approval_required": {"const": false},
        "protected_event_id": {"type": "null"}
      }
    },
    "missingEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_step", "status", "evidence_ref", "evidence_sha256", "reason"],
      "properties": {
        "required_step": {"$ref": "#/$defs/identifier"},
        "status": {"const": "MISSING"},
        "evidence_ref": {"type": "null"},
        "evidence_sha256": {"type": "null"},
        "reason": {"type": "string", "minLength": 16}
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_ref", "receipt_sha256", "atomic", "same_turn", "write_scope"],
      "properties": {
        "receipt_ref": {"$ref": "#/$defs/reference"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "atomic": {"const": true},
        "same_turn": {"const": true},
        "write_scope": {"const": "CONTROL_PLANE_ONLY"}
      }
    },
    "successor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "successor_id", "next_action", "next_handler", "direct_consumer", "controller_approval_required", "lane_execution", "same_turn_dispatch", "protected_event_id", "persistence", "successor_sha256"],
      "properties": {
        "schema": {"const": "agentos.local_proof_evidence_successor.v1"},
        "version": {"const": 1},
        "successor_id": {"$ref": "#/$defs/identifier"},
        "next_action": {"const": "REPAIR_BLOCKS"},
        "next_handler": {"const": "HANDLER.ORCHESTRATOR_BLOCK_REPAIR"},
        "direct_consumer": {"const": "INDEPENDENT_PLATFORM_REVIEW"},
        "controller_approval_required": {"const": false},
        "lane_execution": {"const": "AUTONOMOUS_TYPED_HANDOFF"},
        "same_turn_dispatch": {"const": true},
        "protected_event_id": {"type": "null"},
        "persistence": {"$ref": "#/$defs/persistence"},
        "successor_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "reference", "sha256"],
        "properties": {
          "evidence_id": {"$ref": "#/$defs/identifier"},
          "reference": {"$ref": "#/$defs/reference"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  }
}
