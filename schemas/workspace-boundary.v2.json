{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.workspace_boundary.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "layout", "release_root_ref", "projects_root_ref", "project_root_ref", "control_root_ref", "worktrees_root_ref", "control_repository_policy", "project_state_policy", "agent_worktree_policy", "references_policy", "runtime_binding_digest", "digest"],
  "properties": {
    "schema": { "const": "agentos.workspace_boundary.v2" },
    "version": { "const": 2 },
    "status": { "const": "PREPARED_NOT_ACTIVATED" },
    "layout": { "const": "SIBLING_RELEASE_PROJECTS_CONTROL" },
    "release_root_ref": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "projects_root_ref": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "project_root_ref": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "control_root_ref": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "worktrees_root_ref": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "control_repository_policy": { "const": "CREATE_SIBLING_REPOSITORY_BEFORE_ANY_WRITE" },
    "project_state_policy": { "const": "NEVER_WRITE_OR_STORE_AGENTOS_ARTIFACTS" },
    "agent_worktree_policy": { "const": "ISOLATED_CHECKOUTS_ONLY_UNDER_CONTROL_REPOSITORY" },
    "references_policy": { "const": "NO_AGENTOS_REFERENCES_IN_PROJECT_TREE" },
    "runtime_binding_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
