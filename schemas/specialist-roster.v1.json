{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/specialist-roster.v1.json",
  "title": "AgentOS Specialist Block Roster",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "governance_version", "blocks", "aliases", "routing_index", "activation", "roster_sha256"],
  "properties": {
    "schema": {"const": "agentos.specialist_roster.v1"},
    "version": {"const": 1},
    "status": {"const": "COMPILED_CANDIDATE"},
    "governance_version": {"const": "2.1rc"},
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_id", "candidate_digest", "role_kind", "atomic_scope_statement", "permitted_decisions", "forbidden_decisions", "maximum_authority", "required_upstream_router", "sibling_conflicts", "composition_rules", "escalation_target", "split_required_when", "priority", "family", "revision", "status", "primary_sources", "dependencies", "conflicts", "gate_path", "schema_path", "evaluator_receipt", "owner", "lifecycle", "activation", "exit_governance_review"],
        "properties": {
          "block_id": {"type": "string", "pattern": "^specialist\\.[a-z0-9-]+\\.[a-z0-9-]+$"},
          "candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "role_kind": {"enum": ["ROUTER", "CONTROL_PLANE", "KNOWLEDGE_BLOCK", "GOVERNANCE_BLOCK", "STANDARD_BLOCK", "CONTEXT_BLOCK", "ATOMIC_SPECIALIST", "COMPILED_AGENT_PACKAGE"]},
          "atomic_scope_statement": {"type": "string", "minLength": 1},
          "permitted_decisions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "forbidden_decisions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "maximum_authority": {"type": "string", "minLength": 1},
          "required_upstream_router": {"type": ["string", "null"]},
          "sibling_conflicts": {"type": "array", "items": {"type": "string"}},
          "composition_rules": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "escalation_target": {"type": "string", "minLength": 1},
          "split_required_when": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "priority": {"enum": ["P0", "P1", "P2", "P3", "P4", "P5", "P6"]},
          "family": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "status": {"enum": ["CANDIDATE", "EVALUATED", "SUSPENDED", "ARCHIVED"]},
          "primary_sources": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "conflicts": {"type": "array", "items": {"type": "string"}},
          "gate_path": {"type": "string", "pattern": "^.+\\.gate$"},
          "schema_path": {"type": "string", "pattern": "^schemas/.+\\.json$"},
          "evaluator_receipt": {"type": "string", "pattern": "^specialist-eval\\.[a-z0-9-]+\\.v[0-9]+$"},
          "owner": {"const": "specialist-library-controller"},
          "lifecycle": {"const": "NOT_ADMITTED"},
          "activation": {"const": "OFF"},
          "exit_governance_review": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema", "required_before", "agent_response", "proposal_layers", "spawner_disposition", "accepted_change_route", "memory_rule"],
            "properties": {
              "schema": {"const": "agentos.exit_governance_review.v1"},
              "required_before": {"const": ["CAPABILITY_REVOCATION", "ARCHIVE"]},
              "agent_response": {"const": "NO_CHANGE_RECOMMENDED_OR_TYPED_PROPOSALS"},
              "proposal_layers": {"const": ["GLOBAL", "PROJECT", "ROLE", "TECHNOLOGY_OR_STANDARD", "ENVIRONMENT", "TASK"]},
              "spawner_disposition": {"const": ["ACCEPT", "REJECT_WITH_REASON", "DEFER_WITH_EXACT_EVIDENCE_GAP"]},
              "accepted_change_route": {"const": "SPAWNER_DEFECT_REPAIR_QA_HOSTILE_REGRESSION_INDEPENDENT_EVALUATION"},
              "memory_rule": {"const": "MEMORY_PROPOSALS_ARE_EXPLICITLY_DISPOSITIONED_BEFORE_ARCHIVE"}
            }
          }
        }
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alias", "canonical_block_id", "reason"],
        "properties": {
          "alias": {"type": "string", "minLength": 1},
          "canonical_block_id": {"type": "string", "pattern": "^specialist\\.[a-z0-9-]+\\.[a-z0-9-]+$"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "routing_index": {"type": "string", "const": "routing-index.v1.json"},
    "activation": {"const": "OFF"},
    "roster_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
