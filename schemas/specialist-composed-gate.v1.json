{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/specialist-composed-gate.v1.json",
  "title": "AgentOS Composed Dependency-Aware Decision Gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "package_hash", "answer_type", "allowed_outcomes", "nodes", "roots", "default_rule", "decision_tree_sha256"],
  "properties": {
    "schema": {"const": "agentos.composed_decision_tree.v1"},
    "version": {"const": 1},
    "package_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "answer_type": {"const": "FOUR_VALUED"},
    "allowed_outcomes": {"const": ["YES", "NO", "UNKNOWN", "NOT_APPLICABLE"]},
    "nodes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["node_id", "kind", "layer", "block_ref", "depends_on", "required_evidence", "transitions"], "properties": {"node_id": {"type": "string", "minLength": 1}, "kind": {"enum": ["OWNER_INTENT", "PROJECT_GOVERNANCE", "CONTEXT", "AUTHORITY", "BLOCK_GATE"]}, "layer": {"type": "string", "minLength": 1}, "block_ref": {"type": ["object", "null"]}, "depends_on": {"type": "array", "items": {"type": "string"}}, "required_evidence": {"type": "array", "items": {"type": "string"}}, "transitions": {"type": "object", "additionalProperties": false, "required": ["YES", "NO", "UNKNOWN", "NOT_APPLICABLE"], "properties": {"YES": {"type": "string"}, "NO": {"type": "string"}, "UNKNOWN": {"type": "string"}, "NOT_APPLICABLE": {"type": "string"}}}}}, "minItems": 4},
    "roots": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "default_rule": {"const": "UNKNOWN_CLOSES_ONLY_DEPENDENT_ACTION;_NO_SILENT_BLOCK_OR_AUTHORITY_ADDITION"},
    "decision_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
