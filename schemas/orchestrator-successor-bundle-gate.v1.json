{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/orchestrator-successor-bundle-gate.v1.json",
  "title": "AgentOS Autonomous Orchestrator Successor Bundle Gate",
  "description": "A project-agnostic gate requiring non-null, cross-bound source successor, dispatch readback, and final receipt digests before an autonomous lane handoff is persisted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "bundle_id", "source_successor", "dispatch_readback", "final_receipt", "execution_owner", "direct_consumer", "controller_approval_required", "evidence_refs", "hostile_fixture_refs", "bundle_sha256"],
  "properties": {
    "schema": {"const": "agentos.orchestrator_successor_bundle.v1"},
    "version": {"const": 1},
    "bundle_id": {"$ref": "#/$defs/identifier"},
    "source_successor": {"type": "object", "description": "Must validate against agentos.action_result_continuation.v1."},
    "dispatch_readback": {"type": "object", "description": "Must validate against agentos.orchestrator_successor_dispatch.v1."},
    "final_receipt": {"type": "object", "description": "Must validate against agentos.controller_action_receipt.v1."},
    "execution_owner": {"$ref": "#/$defs/identifier"},
    "direct_consumer": {"$ref": "#/$defs/identifier"},
    "controller_approval_required": {"const": false},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "hostile_fixture_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "bundle_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{0,191}$"},
    "reference": {"type": "string", "pattern": "^(opaque:|ref:)[^\\s]+$"},
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["evidence_id", "reference", "sha256"],
      "properties": {"evidence_id": {"$ref": "#/$defs/identifier"}, "reference": {"$ref": "#/$defs/reference"}, "sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
