{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/industrial-3d-package-operational-evaluation.v1.json",
  "title": "Industrial 3D atomic specialist operational evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "block_id", "lifecycle", "activation", "package_root_sha256", "package_block_sha256", "source_manifest_sha256", "standard_block_sha256", "standard_source_manifest_sha256", "model_snapshot_sha256", "model_route_sha256", "context_receipt_sha256", "memory_readback_sha256", "fixture_contract_sha256", "upstream_router_result_sha256", "gate_execution", "fixture_results", "mutation_sensitivity", "independent_signature_required", "evaluation_sha256"],
  "properties": {
    "schema": {"const": "agentos.specialist_industrial_3d_package_operational_evaluation.v1"},
    "version": {"const": 1},
    "status": {"const": "PASS"},
    "block_id": {"const": "specialist.graphics.industrial-3d"},
    "lifecycle": {"const": "CANDIDATE"},
    "activation": {"const": "OFF"},
    "package_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "package_block_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "standard_block_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "standard_source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_route_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "context_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "memory_readback_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fixture_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "upstream_router_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gate_execution": {"type": "array", "minItems": 12, "maxItems": 12},
    "fixture_results": {"type": "array", "minItems": 17, "maxItems": 17},
    "mutation_sensitivity": {"type": "object"},
    "independent_signature_required": {"const": true},
    "evaluation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
