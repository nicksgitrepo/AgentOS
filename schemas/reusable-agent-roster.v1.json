{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/reusable-agent-roster.v1.json",
  "title": "AgentOS Reusable Agent Roster",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "governance_version", "project_agnostic", "source_inventory", "policy", "model_policy", "tiers", "aliases", "entries", "build_queue", "roster_sha256"],
  "properties": {
    "schema": {"const": "agentos.reusable_agent_roster.v1"},
    "version": {"const": 1},
    "status": {"enum": ["COMPILED_CANDIDATE", "ACCEPTED"]},
    "governance_version": {"type": "string", "minLength": 1},
    "project_agnostic": {"const": true},
    "source_inventory": {"$ref": "#/$defs/sourceInventory"},
    "policy": {"$ref": "#/$defs/policy"},
    "model_policy": {"$ref": "#/$defs/modelPolicy"},
    "tiers": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/tier"}},
    "aliases": {"type": "array", "items": {"$ref": "#/$defs/alias"}},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}},
    "build_queue": {"type": "array", "items": {"$ref": "#/$defs/queueItem"}},
    "roster_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "sourceInventory": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_library_roster", "master_inventory", "permanent_role_registry", "package_count", "current_package_count", "archived_package_count", "entry_type_counts"],
      "properties": {
        "canonical_library_roster": {"$ref": "#/$defs/path"},
        "master_inventory": {"$ref": "#/$defs/path"},
        "permanent_role_registry": {"$ref": "#/$defs/path"},
        "package_count": {"type": "integer", "minimum": 1},
        "current_package_count": {"type": "integer", "minimum": 1},
        "archived_package_count": {"type": "integer", "minimum": 0},
        "entry_type_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["one_package_at_a_time", "permanent_before_platform", "platform_before_auditor", "seed_is_inert", "auditor_closeout", "acceptance_rule", "model_names_are_advisory"],
      "properties": {
        "one_package_at_a_time": {"const": true},
        "permanent_before_platform": {"const": true},
        "platform_before_auditor": {"const": true},
        "seed_is_inert": {"const": true},
        "auditor_closeout": {"type": "string", "minLength": 1},
        "acceptance_rule": {"type": "string", "minLength": 1},
        "model_names_are_advisory": {"const": true}
      }
    },
    "modelPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_path", "snapshot_sha256", "observed_at_utc", "expires_at_utc", "task_classes"],
      "properties": {
        "snapshot_path": {"$ref": "#/$defs/path"}, "snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "observed_at_utc": {"type": "string", "format": "date-time"}, "expires_at_utc": {"type": "string", "format": "date-time"},
        "task_classes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "tier": {
      "type": "object", "additionalProperties": false,
      "required": ["tier", "rule", "order"],
      "properties": {"tier": {"type": "string", "minLength": 1}, "rule": {"type": "string", "minLength": 1}, "order": {"type": "array", "items": {"type": "string", "minLength": 1}}}
    },
    "alias": {
      "type": "object", "additionalProperties": false,
      "required": ["alias", "canonical_id", "reason"],
      "properties": {"alias": {"type": "string", "minLength": 1}, "canonical_id": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["gate_id", "path", "file_sha256"],
      "properties": {"gate_id": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/path"}, "file_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["fixture_id", "path", "file_sha256", "expected_outcome"],
      "properties": {"fixture_id": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/path"}, "file_sha256": {"$ref": "#/$defs/sha256"}, "expected_outcome": {"type": "string", "minLength": 1}}
    },
    "evidenceHandoff": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_fields", "handoff_path", "handoff_file_sha256", "independent_review_required", "receipt_id"],
      "properties": {"evidence_fields": {"type": "array", "items": {"type": "string"}}, "handoff_path": {"type": ["string", "null"]}, "handoff_file_sha256": {"type": ["string", "null"]}, "independent_review_required": {"type": "boolean"}, "receipt_id": {"type": ["string", "null"]}}
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "build_rules", "seed_rule", "worker_rule", "permanent_rule", "archive_rule"],
      "properties": {"kind": {"type": "string", "minLength": 1}, "build_rules": {"type": "array", "items": {"type": "string"}}, "seed_rule": {"type": "string", "minLength": 1}, "worker_rule": {"type": "string", "minLength": 1}, "permanent_rule": {"type": "string", "minLength": 1}, "archive_rule": {"type": "string", "minLength": 1}}
    },
    "modelRoute": {
      "type": "object", "additionalProperties": false,
      "required": ["task_class", "minimum_capability", "required_capabilities", "route_source"],
      "properties": {"task_class": {"type": "string", "minLength": 1}, "minimum_capability": {"type": "integer", "minimum": 0}, "required_capabilities": {"type": "array", "items": {"type": "string"}}, "route_source": {"type": "string", "minLength": 1}}
    },
    "score": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "expected_frequency", "dependency_centrality", "cross_project_reuse", "risk_reduction", "architecture_coverage", "finish_cost", "rationale"],
      "properties": {"total": {"type": "number", "minimum": 0, "maximum": 100}, "expected_frequency": {"type": "number", "minimum": 0, "maximum": 100}, "dependency_centrality": {"type": "number", "minimum": 0, "maximum": 100}, "cross_project_reuse": {"type": "number", "minimum": 0, "maximum": 100}, "risk_reduction": {"type": "number", "minimum": 0, "maximum": 100}, "architecture_coverage": {"type": "number", "minimum": 0, "maximum": 100}, "finish_cost": {"type": "number", "minimum": 0, "maximum": 100}, "rationale": {"type": "string", "minLength": 1}}
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["stable_agent_id", "display_name", "entry_type", "tier", "canonical_block_id", "package_path", "family", "exact_narrow_purpose", "applicability_triggers", "authority", "forbidden_actions", "stop_conditions", "required_blocks", "knowledge_context_inputs", "deterministic_gates", "hostile_fixtures", "required_evidence_handoff", "lifecycle", "model_route", "dependency_predecessors", "likely_consumers", "reuse_likelihood", "risk", "build_state", "qa_state", "independent_evaluation_state", "supersession_invalidation"],
      "properties": {
        "stable_agent_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{1,191}$"}, "display_name": {"type": "string", "minLength": 1}, "entry_type": {"enum": ["AGENT_ROLE", "REUSABLE_GOVERNANCE_BLOCK", "REUSABLE_STANDARD_BLOCK", "LEGACY_ARCHIVE"]}, "tier": {"type": "string", "minLength": 1}, "canonical_block_id": {"type": "string", "minLength": 1}, "package_path": {"type": ["string", "null"]}, "family": {"type": "string", "minLength": 1}, "exact_narrow_purpose": {"type": "string", "minLength": 1}, "applicability_triggers": {"type": "array", "items": {"type": "string"}}, "authority": {"type": "array", "items": {"type": "string"}}, "forbidden_actions": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "stop_conditions": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "required_blocks": {"type": "array", "items": {"type": "string"}}, "knowledge_context_inputs": {"type": "array", "items": {"type": "string"}}, "deterministic_gates": {"type": "object", "additionalProperties": false, "required": ["status", "manifest_path", "gates"], "properties": {"status": {"type": "string", "minLength": 1}, "manifest_path": {"type": ["string", "null"]}, "gates": {"type": "array", "items": {"$ref": "#/$defs/gate"}}}}, "hostile_fixtures": {"type": "object", "additionalProperties": false, "required": ["status", "fixtures"], "properties": {"status": {"type": "string", "minLength": 1}, "fixtures": {"type": "array", "items": {"$ref": "#/$defs/fixture"}}}}, "required_evidence_handoff": {"$ref": "#/$defs/evidenceHandoff"}, "lifecycle": {"$ref": "#/$defs/lifecycle"}, "model_route": {"$ref": "#/$defs/modelRoute"}, "dependency_predecessors": {"type": "array", "items": {"type": "string"}}, "likely_consumers": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "reuse_likelihood": {"$ref": "#/$defs/score"}, "risk": {"type": "object", "additionalProperties": false, "required": ["criticality", "reason"], "properties": {"criticality": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]}, "reason": {"type": "string", "minLength": 1}}}, "build_state": {"type": "string", "minLength": 1}, "qa_state": {"type": "string", "minLength": 1}, "independent_evaluation_state": {"type": "string", "minLength": 1}, "supersession_invalidation": {"type": "object", "additionalProperties": false, "required": ["links", "invalidate_when", "rebuild_rule"], "properties": {"links": {"type": "array", "items": {"type": "string"}}, "invalidate_when": {"type": "array", "items": {"type": "string"}}, "rebuild_rule": {"type": "string", "minLength": 1}}}}
    },
    "queueItem": {
      "type": "object", "additionalProperties": false,
      "required": ["rank", "stable_agent_id", "tier", "eligible", "priority_score", "reason"],
      "properties": {"rank": {"type": "integer", "minimum": 1}, "stable_agent_id": {"type": "string", "minLength": 1}, "tier": {"type": "string", "minLength": 1}, "eligible": {"type": "boolean"}, "priority_score": {"type": "number", "minimum": 0, "maximum": 100}, "reason": {"type": "string", "minLength": 1}}
    }
  }
}
