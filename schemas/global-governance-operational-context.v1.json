{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.operational_global_governance_context.v1",
  "title": "Canonical operational global-governance projection context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "operational_id", "role_class", "read_only_projection", "global_memory_write_capability", "ledger_head_sha256", "memory_readback_sha256", "bootstrap_sha256", "snapshot_sha256", "projection_sha256", "compact_selection", "global_behavior_policy", "worker_binding_rule", "context_sha256"],
  "properties": {
    "schema": {"const": "agentos.operational_global_governance_context.v1"},
    "version": {"const": 1},
    "status": {"const": "READY"},
    "operational_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{0,191}$"},
    "role_class": {"enum": ["CONTROLLER", "PRODUCT_OWNER", "SPAWNER", "MEMORY", "SCHEDULER", "RUNTIME", "ORCHESTRATOR", "INERT_SEED", "WORKING_AGENT"]},
    "read_only_projection": {"const": true},
    "global_memory_write_capability": {"type": "boolean"},
    "ledger_head_sha256": {"$ref": "#/$defs/sha256"},
    "memory_readback_sha256": {"$ref": "#/$defs/sha256"},
    "bootstrap_sha256": {"$ref": "#/$defs/sha256"},
    "snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "projection_sha256": {"$ref": "#/$defs/sha256"},
    "compact_selection": {"anyOf": [{"type": "null"}, {"type": "object"}]},
    "global_behavior_policy": {"type": "object", "additionalProperties": false, "required": ["schema", "version", "project_agnostic", "human_facing_role", "default_explanation_level", "technical_details_require_explicit_advanced_choice", "current_role_human_facing_authority", "bootstrap_spawn_exception", "ordinary_spawn_authority", "all_despawn_authority", "auditor_group_size", "auditor_closeout", "builder_requires_isolated_worktree", "project_owner_monitor_minutes", "controller_progress_monitor_minutes", "supported_development_workflows", "feature_implementation_loop", "policy_sha256"], "properties": {"schema": {"const": "agentos.global_agent_behavior_policy.v1"}, "version": {"const": 1}, "project_agnostic": {"const": true}, "human_facing_role": {"const": "AGENTOS.PRODUCT_OWNER"}, "default_explanation_level": {"const": "SIMPLE"}, "technical_details_require_explicit_advanced_choice": {"const": true}, "current_role_human_facing_authority": {"enum": ["NONE", "PROJECT_OWNER_ONLY"]}, "bootstrap_spawn_exception": {"const": "START_EXACTLY_ONE_SPAWNER"}, "ordinary_spawn_authority": {"const": "AGENTOS.SPAWNER"}, "all_despawn_authority": {"const": "AGENTOS.SPAWNER"}, "auditor_group_size": {"const": 6}, "auditor_closeout": {"const": "DESPAWN_AFTER_ACCEPTED_HANDOFF_AND_ZERO_AGENT_REFERENCES"}, "builder_requires_isolated_worktree": {"const": true}, "project_owner_monitor_minutes": {"const": 15}, "controller_progress_monitor_minutes": {"const": 15}, "supported_development_workflows": {"const": ["COLLABORATIVE_AUDIT", "PYRAMID"]}, "feature_implementation_loop": {"type": "object", "additionalProperties": false, "required": ["planning", "scope_control", "planner", "implementers", "model_name_authority", "implementer_self_review", "review_acceptance", "repair_feedback"], "properties": {"planning": {"const": "BOUNDED_COMPREHENSIVE_REQUIRED"}, "scope_control": {"const": "AVOID_OVER_ENGINEERING_PREMATURE_ABSTRACTIONS_AND_SCOPE_CREEP"}, "planner": {"const": "CAPABILITY_FIRST"}, "implementers": {"const": "ECONOMICAL_CAPABLE"}, "model_name_authority": {"const": "ADVISORY_SUGGESTION_ONLY"}, "implementer_self_review": {"const": "FORBIDDEN"}, "review_acceptance": {"const": "ORCHESTRATOR_ONLY"}, "repair_feedback": {"const": "REENTER_IMPLEMENTATION_UNTIL_ACCEPTED_OR_GENUINE_PROTECTED_BLOCKER"}}}, "policy_sha256": {"$ref": "#/$defs/sha256"}}},
    "worker_binding_rule": {"enum": ["CURRENT_HEAD_REQUIRED_BEFORE_WORK", "BOUND_UNTIL_HANDOFF_OR_TYPED_SAFE_REFRESH"]},
    "context_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "authority_rules": {
    "writer": "Only the SPAWNER role class receives global_memory_write_capability=true; the governed Memory adapter writes through its separate append contract.",
    "readers": "Every concrete permanent role plus inert seeds and working agents receives a compact read-only projection resolved from the current accepted global-governance memory head.",
    "supersession": "Non-worker contexts fail closed on a changed head; active workers retain the exact bound snapshot only until handoff or typed safe refresh."
  }
}
