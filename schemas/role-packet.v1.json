{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.role-packet.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "role_id", "display_name", "lifetime", "graph_ids", "allowed_authority", "prohibited_authority", "digest"],
  "properties": {
    "schema": { "const": "agentos.role_packet.v1" },
    "version": { "type": "integer", "const": 1 },
    "status": { "const": "PREPARED_NOT_ACTIVATED" },
    "role_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9._-]*$" },
    "display_name": { "type": "string", "minLength": 1 },
    "lane_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
    "lifetime": { "enum": ["PERSISTENT", "CAMPAIGN"] },
    "graph_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9._-]*$" } },
    "allowed_authority": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "prohibited_authority": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
