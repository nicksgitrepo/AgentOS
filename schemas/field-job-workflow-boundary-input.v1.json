{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/field-job-workflow-boundary-input.v1.json",
  "title": "Field Job Workflow boundary input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "request_kind", "evidence"],
  "properties": {
    "schema": {"const": "agentos.field_job_workflow_boundary_input.v1"},
    "version": {"const": 1},
    "request_kind": {"type": "string"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_status", "custody_status", "custody_ref", "workflow_domain", "workflow_phase", "workflow_task", "workflow_ref", "workflow_dependencies", "source_status", "source_identity", "source_version", "source_effective_date", "source_retrieved_date", "source_manifest_sha256", "candidate_status", "candidate_digest", "workflow_signal", "signal_status", "task_status", "context_status", "context_complete", "context_receipt_sha256", "requested_action", "requested_tools", "required_block_identities", "model_policy_status", "model_route_status", "model_task_class", "model_snapshot_sha256", "model_route_sha256", "model_capability_floor", "model_required_capabilities", "authority_scope", "memory_binding_sha256", "upstream_router_file_sha256", "upstream_router_result_sha256", "project_data_present", "secret_data_present", "adversarial_flags"],
      "properties": {
        "authority_status": {"type": "string"}, "custody_status": {"type": "string"}, "custody_ref": {"type": "string"},
        "workflow_domain": {"const": "FIELD_WORKFLOW"}, "workflow_phase": {"type": "string"}, "workflow_task": {"type": "string"}, "workflow_ref": {"type": "string"},
        "workflow_dependencies": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "source_status": {"type": "string"}, "source_identity": {"type": "string"}, "source_version": {"type": "string"}, "source_effective_date": {"type": ["string", "null"]}, "source_retrieved_date": {"type": ["string", "null"]}, "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate_status": {"type": "string"}, "candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "workflow_signal": {"type": "string"}, "signal_status": {"type": "string"}, "task_status": {"type": "string"},
        "context_status": {"type": "string"}, "context_complete": {"type": "boolean"}, "context_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "requested_action": {"enum": ["ANALYZE", "ROUTE"]}, "requested_tools": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "required_block_identities": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "string"}},
        "model_policy_status": {"type": "string"}, "model_route_status": {"type": "string"}, "model_task_class": {"type": "string"}, "model_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "model_route_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "model_capability_floor": {"type": "integer", "minimum": 0}, "model_required_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "authority_scope": {"type": "string"}, "memory_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "upstream_router_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "upstream_router_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "project_data_present": {"type": "boolean"}, "secret_data_present": {"type": "boolean"}, "adversarial_flags": {"type": "object", "additionalProperties": {"type": "boolean"}}
      }
    }
  }
}
