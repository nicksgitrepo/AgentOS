{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.gate_response.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "graph_id", "gate_id", "gate_name", "context", "question", "answer", "statement", "evidence_digest", "identity", "issuer_session_id", "issuer_kind", "status", "digest"],
  "properties": {
    "schema": { "const": "agentos.gate_response.v1" },
    "version": { "const": 1 },
    "graph_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9._-]*$" },
    "gate_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9._-]*$" },
    "gate_name": { "type": "string", "minLength": 2 },
    "context": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "answer": { "enum": ["YES", "NO", "UNKNOWN", "NOT_APPLICABLE"] },
    "statement": { "type": "string", "minLength": 1 },
    "evidence_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_commit", "source_tree", "worktree_id", "session_id", "goal_id", "environment_id"],
      "properties": {
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "source_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "worktree_id": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "pattern": "^SESSION_REF_[0-9a-f]{64}$" },
        "goal_id": { "type": "string", "minLength": 1 },
        "environment_id": { "type": "string", "minLength": 1 }
      }
    },
    "issuer_session_id": { "type": "string", "pattern": "^SESSION_REF_[0-9a-f]{64}$" },
    "issuer_kind": { "enum": ["HOST_READBACK", "INDEPENDENT_AUDITOR"] },
    "status": { "enum": ["PASS", "ROUTED"] },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
