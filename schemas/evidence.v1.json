{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.evidence.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "question_id", "graph_digest", "evidence_slot", "answer", "kind", "value_sha256", "source_commit", "source_tree", "worktree_id", "session_id", "goal_id", "environment_id", "issuer_session_id", "issuer_kind", "supports_answer", "observed_at_utc", "attestation_hmac", "digest"],
  "properties": {
    "evidence_id": { "type": "string", "minLength": 1 },
    "question_id": { "type": "string", "minLength": 1 },
    "graph_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidence_slot": { "type": "string", "minLength": 1 },
    "answer": { "enum": ["YES", "NO", "UNKNOWN", "NOT_APPLICABLE"] },
    "kind": { "type": "string", "minLength": 1 },
    "value_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "worktree_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "goal_id": { "type": "string", "minLength": 1 },
    "environment_id": { "type": "string", "minLength": 1 },
    "issuer_session_id": { "type": "string", "minLength": 1 },
    "issuer_kind": { "enum": ["HOST_READBACK", "INDEPENDENT_AUDITOR"] },
    "supports_answer": { "const": true },
    "observed_at_utc": { "type": "string", "format": "date-time" },
    "attestation_hmac": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
