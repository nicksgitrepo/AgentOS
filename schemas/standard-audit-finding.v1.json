{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.standard_audit_finding.v1",
  "title": "Project-agnostic collaborative audit finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "issue_id", "title", "severity", "weakness_id", "summary", "researched_finding", "evidence_refs", "affected_scope", "repair_acceptance", "reported_by", "state", "audit_attempt", "repair_attempt", "history", "finding_sha256"],
  "properties": {
    "schema": {"const": "agentos.standard_audit_finding.v1"},
    "version": {"const": 1},
    "issue_id": {"type": "string", "pattern": "^AGENTOS-(CVE|ISSUE)-[0-9]{4}-[0-9]{4,}$"},
    "title": {"type": "string", "minLength": 8},
    "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
    "weakness_id": {"type": "string", "minLength": 3},
    "summary": {"type": "string", "minLength": 24},
    "researched_finding": {"type": "string", "minLength": 40},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(ref:|opaque:)"}},
    "affected_scope": {"type": "string", "minLength": 12},
    "repair_acceptance": {"type": "string", "minLength": 20},
    "reported_by": {"type": "string"},
    "state": {"enum": ["OPEN", "PENDING_AUDIT_1", "PENDING_REPAIR_1", "PENDING_AUDIT_2", "PENDING_REPAIR_2", "PENDING_AUDIT_3", "ESCALATION_REQUIRED", "PENDING_ESCALATION_AUDIT", "CORRECTED"]},
    "audit_attempt": {"type": "integer", "minimum": 0},
    "repair_attempt": {"type": "integer", "minimum": 0},
    "history": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["state", "actor", "outcome"], "properties": {"state": {"type": "string"}, "actor": {"type": "string"}, "outcome": {"type": "string"}}}},
    "finding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
