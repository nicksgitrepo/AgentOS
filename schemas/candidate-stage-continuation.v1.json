{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/candidate-stage-continuation.v1.json",
  "title": "AgentOS ordinary candidate-stage continuation",
  "description": "Candidate review, isolated integration, independent re-audit, and platform review must persist a typed result and immediately dispatch another local stage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "action_id", "result_id", "result", "result_sha256", "semantic_before_sha256", "semantic_after_sha256", "next_action", "next_handler", "continuation", "continuation_sha256", "persistence", "evidence_refs", "hostile_fixture_refs", "status", "record_sha256"],
  "properties": {
    "schema": {"const": "agentos.action_result_continuation.v1"},
    "version": {"const": 1},
    "action_id": {"$ref": "#/$defs/stage"},
    "result_id": {"$ref": "#/$defs/identifier"},
    "result": {"$ref": "#/$defs/stageResult"},
    "result_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_before_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_after_sha256": {"$ref": "#/$defs/sha256"},
    "next_action": {"$ref": "#/$defs/stage"},
    "next_handler": {"type": "string", "enum": ["HANDLER.CONTROLLER_CANDIDATE_REVIEW", "HANDLER.ORCHESTRATOR_CENTRAL_INTEGRATION", "HANDLER.ORCHESTRATOR_INDEPENDENT_REAUDIT", "HANDLER.ORCHESTRATOR_PLATFORM_REVIEW"]},
    "continuation": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "timer_deferral", "heartbeat_deferral", "same_turn_dispatch", "protected_event_id", "resume_condition"],
      "properties": {
        "mode": {"const": "IMMEDIATE_SAME_TURN"},
        "timer_deferral": {"const": false},
        "heartbeat_deferral": {"const": false},
        "same_turn_dispatch": {"const": true},
        "protected_event_id": {"type": "null"},
        "resume_condition": {"type": "string", "minLength": 8}
      }
    },
    "continuation_sha256": {"$ref": "#/$defs/sha256"},
    "persistence": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "receipt_ref", "receipt_sha256", "atomic", "same_turn", "write_scope"],
      "properties": {
        "status": {"const": "PERSISTED"},
        "receipt_ref": {"$ref": "#/$defs/reference"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "atomic": {"const": true},
        "same_turn": {"const": true},
        "write_scope": {"const": "CONTROL_PLANE_ONLY"}
      }
    },
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceRef"}},
    "hostile_fixture_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}},
    "status": {"const": "RESULT_PERSISTED"},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{0,191}$"},
    "reference": {"type": "string", "pattern": "^(opaque:|ref:)[^\\s]+$"},
    "stage": {"enum": ["PREPARE_CANDIDATE_REVIEW", "START_CENTRAL_INTEGRATION", "START_INDEPENDENT_REAUDIT", "START_PLATFORM_REVIEW"]},
    "evidenceRef": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "reference", "sha256"],
      "properties": {"evidence_id": {"$ref": "#/$defs/identifier"}, "reference": {"$ref": "#/$defs/reference"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "stageResult": {
      "type": "object", "required": ["status", "candidate_sha256", "candidate_before_sha256", "candidate_after_sha256", "product_mutation", "source_roots_preserved"],
      "properties": {
        "status": {"type": "string", "pattern": "^(?!NONE(?:$|[_:-]))(?!DONE(?:$|[_:-]))(?!WAIT(?:$|[_:-]))(?!PLANNING_ONLY$)(?!REASONING_ONLY$)(?!COMMENTARY_ONLY$)(?!PLACEHOLDER$)[A-Z][A-Z0-9._:-]{0,191}$"},
        "candidate_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_before_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_after_sha256": {"$ref": "#/$defs/sha256"},
        "product_mutation": {"const": false},
        "source_roots_preserved": {"const": true}
      },
      "additionalProperties": true
    }
  },
  "state_rules": {
    "ordinary_stages": "Only the four registered candidate stages may be chained by this contract.",
    "liveness": "Every stage result is atomically persisted and dispatched in the same turn; timer-only, commentary-only, NONE, DONE, and placeholder results are invalid.",
    "boundary": "The candidate may change inside isolated custody, but Product mutation and source-root loss are always rejected."
  }
}
