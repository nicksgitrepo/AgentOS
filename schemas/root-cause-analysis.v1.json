{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.root_cause_analysis.v1",
  "title": "AgentOS root-cause analysis",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9._-]{0,95}$"},
    "opaque": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,31}:[0-9a-f]{64}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "tree", "checkpoint_sha256", "clean", "pushed"],
      "properties": {"commit": {"$ref": "#/$defs/git"}, "tree": {"$ref": "#/$defs/git"}, "checkpoint_sha256": {"$ref": "#/$defs/sha"}, "clean": {"const": true}, "pushed": {"const": false}}
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["scope_ref", "affected_paths_sha256", "excluded_scope_sha256", "boundary_sha256", "source_root", "product_writes_allowed", "external_actions_allowed"],
      "properties": {"scope_ref": {"$ref": "#/$defs/id"}, "affected_paths_sha256": {"$ref": "#/$defs/sha"}, "excluded_scope_sha256": {"$ref": "#/$defs/sha"}, "boundary_sha256": {"$ref": "#/$defs/sha"}, "source_root": {"const": "CONTROL_GOVERNANCE"}, "product_writes_allowed": {"const": false}, "external_actions_allowed": {"const": false}}
    },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["evidence_ref", "evidence_sha256", "kind"], "properties": {"evidence_ref": {"$ref": "#/$defs/opaque"}, "evidence_sha256": {"$ref": "#/$defs/sha"}, "kind": {"$ref": "#/$defs/id"}}}
    },
    "checkpoint": {"$ref": "agentos.digest_bound_checkpoint.v1"},
    "failure": {
      "type": "object", "additionalProperties": false, "required": ["operation", "summary", "output_sha256"],
      "properties": {"operation": {"$ref": "#/$defs/id"}, "summary": {"type": "string", "minLength": 1, "maxLength": 512}, "output_sha256": {"$ref": "#/$defs/sha"}}
    },
    "predecessorEvidence": {
      "type": "object", "additionalProperties": false, "required": ["record_sha256", "evidence_sha256", "preserved", "preserved_at_utc"],
      "properties": {"record_sha256": {"$ref": "#/$defs/sha"}, "evidence_sha256": {"$ref": "#/$defs/sha"}, "preserved": {"const": true}, "preserved_at_utc": {"type": "string", "format": "date-time"}}
    },
    "rootCause": {
      "type": "object", "additionalProperties": false, "required": ["category", "summary", "factors_sha256"],
      "properties": {"category": {"$ref": "#/$defs/id"}, "summary": {"type": "string", "minLength": 1, "maxLength": 512}, "factors_sha256": {"$ref": "#/$defs/sha"}}
    },
    "route": {
      "type": "object", "additionalProperties": false, "required": ["route_kind", "owner_role", "max_attempts", "retry_policy", "owner_review_required"],
      "properties": {"route_kind": {"$ref": "#/$defs/id"}, "owner_role": {"$ref": "#/$defs/id"}, "max_attempts": {"type": "integer", "minimum": 0, "maximum": 2}, "retry_policy": {"enum": ["NEVER_RETRY", "ONE_BOUNDED_ATTEMPT", "OWNER_REVIEW_AFTER_ATTEMPT"]}, "owner_review_required": {"type": "boolean"}}
    },
    "protected": {
      "type": "object", "additionalProperties": false,
      "required": ["acceptance", "activation", "deletion", "deployment", "external_release", "external_publish", "external_push", "merge", "product_writes", "secrets", "spend", "authority_change"],
      "properties": {"acceptance": {"const": false}, "activation": {"const": false}, "deletion": {"const": false}, "deployment": {"const": false}, "external_release": {"const": false}, "external_publish": {"const": false}, "external_push": {"const": false}, "merge": {"const": false}, "product_writes": {"const": false}, "secrets": {"const": false}, "spend": {"const": false}, "authority_change": {"const": false}}
    }
  },
  "required": ["schema", "version", "status", "finding_id", "classification", "classification_sha256", "phase", "failure", "source_before", "scope", "evidence_refs", "predecessor_evidence", "root_cause", "repair_route", "acceptance_consequence", "protected_actions", "parent_rca_sha256", "status_reason", "recorded_at_utc", "rca_sha256"],
  "properties": {
    "schema": {"const": "agentos.root_cause_analysis.v1"},
    "version": {"const": 1},
    "status": {"enum": ["OPEN", "ROUTED", "REPAIRING", "REPAIRED", "BLOCKED", "CLOSED"]},
    "finding_id": {"$ref": "#/$defs/id"},
    "classification": {"enum": ["HARD_BOUNDARY", "SOURCE_DRIFT", "TRUE_BLOCKER", "SOFT_BOUNDARY", "REPAIRABLE_PUZZLE"]},
    "classification_sha256": {"$ref": "#/$defs/sha"},
    "phase": {"$ref": "#/$defs/id"},
    "failure": {"$ref": "#/$defs/failure"},
    "source_before": {"$ref": "#/$defs/source"},
    "scope": {"$ref": "#/$defs/scope"},
    "evidence_refs": {"$ref": "#/$defs/evidence"},
    "predecessor_evidence": {"$ref": "#/$defs/predecessorEvidence"},
    "root_cause": {"$ref": "#/$defs/rootCause"},
    "repair_route": {"$ref": "#/$defs/route"},
    "acceptance_consequence": {"type": "string", "minLength": 1, "maxLength": 512},
    "protected_actions": {"$ref": "#/$defs/protected"},
    "parent_rca_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]},
    "status_reason": {"type": "string", "minLength": 1, "maxLength": 512},
    "recorded_at_utc": {"type": "string", "format": "date-time"},
    "rca_sha256": {"$ref": "#/$defs/sha"}
  }
}
