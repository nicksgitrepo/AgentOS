{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.storage_regeneration_governance.v1",
  "title": "AgentOS storage regeneration and recurrence governance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "authority_id", "owner", "measured_sources", "protected_classes", "hostile_cases", "policies", "measured_source_rules", "observed_at_utc", "governance_sha256"],
  "properties": {
    "schema": {"const": "agentos.storage_regeneration_governance.v1"},
    "version": {"const": 1},
    "authority_id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "measured_sources": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}},
    "protected_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "hostile_cases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cleanup_execution_authorized", "scheduler_runtime_closeout", "runtime_delivery_closeout", "controller_daily_inspection", "recurrence_history_required", "generated_temp_closeout_required", "broad_globs_forbidden", "worktree_removal_forbidden", "shared_cache_deletion_forbidden", "active_custody_cleanup_forbidden", "toolchain_deletion_forbidden", "postgresql_state_deletion_forbidden", "artifact_receipt_deletion_forbidden", "codex_history_mutation_forbidden", "outside_projects_cache_mutation_forbidden"],
      "properties": {
        "cleanup_execution_authorized": {"const": false},
        "scheduler_runtime_closeout": {"const": true},
        "runtime_delivery_closeout": {"const": true},
        "controller_daily_inspection": {"const": true},
        "recurrence_history_required": {"const": true},
        "generated_temp_closeout_required": {"const": true},
        "broad_globs_forbidden": {"const": true},
        "worktree_removal_forbidden": {"const": true},
        "shared_cache_deletion_forbidden": {"const": true},
        "active_custody_cleanup_forbidden": {"const": true},
        "toolchain_deletion_forbidden": {"const": true},
        "postgresql_state_deletion_forbidden": {"const": true},
        "artifact_receipt_deletion_forbidden": {"const": true},
        "codex_history_mutation_forbidden": {"const": true},
        "outside_projects_cache_mutation_forbidden": {"const": true}
      }
    },
    "measured_source_rules": {"type": "object", "minProperties": 7, "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
    "observed_at_utc": {"type": "string", "format": "date-time"},
    "governance_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "definitions": {
    "immutableDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safeRelativePath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\.\.(?:/|$))(?!.*[*?{}\\[\\]])[^\\\\]+$"}
  },
  "x-contracts": {
    "generatedTempCloseout": "agentos.storage_generated_temp_closeout.v1",
    "disposableOutputManifest": "agentos.storage_disposable_output_manifest.v1",
    "postDeliveryCleanup": "agentos.storage_post_delivery_cleanup.v1",
    "cacheIdentity": "agentos.storage_cache_identity.v1",
    "sharedDependencyCustody": "agentos.storage_shared_dependency_custody.v1",
    "regenerationCycle": "agentos.storage_regeneration_cycle.v1",
    "dailyInspection": "agentos.storage_daily_inspection.v1",
    "retainedDeliveredWorktree": "agentos.storage_retained_worktree_closeout.v1",
    "fleetReplayCustody": "agentos.storage_fleet_replay_custody.v1",
    "runtimePostgresqlCustody": "agentos.storage_runtime_postgresql_custody.v1",
    "sessionRollover": "agentos.storage_session_rollover.v1",
    "sharedTargetPruneDecision": "agentos.storage_shared_target_prune_decision.v1"
  }
}
