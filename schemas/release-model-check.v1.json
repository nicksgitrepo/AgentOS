{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.release_model_check.v1",
  "title": "Release finite-state model check",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "subject_candidate_sha256", "initial_state_id", "states", "transitions", "terminal_state_ids", "checks", "independent_checker_sha256", "checked_at_utc", "privacy", "model_sha256"],
  "properties": {
    "schema": {"const": "agentos.release_model_check.v1"},
    "version": {"const": 1},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "subject_candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "initial_state_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state_id", "terminal", "owner_controlled", "requires_recovery", "activation"],
        "properties": {
          "state_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
          "terminal": {"type": "boolean"},
          "owner_controlled": {"type": "boolean"},
          "requires_recovery": {"type": "boolean"},
          "activation": {"const": false}
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["transition_id", "from_state_id", "to_state_id", "action", "requires_owner", "protected_action", "evidence_sha256"],
        "properties": {
          "transition_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
          "from_state_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
          "to_state_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
          "action": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
          "requires_owner": {"type": "boolean"},
          "protected_action": {"type": "boolean"},
          "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "terminal_state_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reachability", "termination", "bypass_resistance", "recovery", "owner_control"],
      "properties": {
        "reachability": {"$ref": "#/$defs/checkWithUnreachable"},
        "termination": {"$ref": "#/$defs/checkWithTermination"},
        "bypass_resistance": {"$ref": "#/$defs/checkWithViolations"},
        "recovery": {"$ref": "#/$defs/checkWithRecovery"},
        "owner_control": {"$ref": "#/$defs/checkWithViolations"}
      }
    },
    "independent_checker_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checked_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"},
    "privacy": {"$ref": "#/$defs/privacy"},
    "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "checkWithUnreachable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "unreachable_state_ids"],
      "properties": {"pass": {"type": "boolean"}, "unreachable_state_ids": {"type": "array", "items": {"type": "string"}}}
    },
    "checkWithTermination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "nonterminating_state_ids", "livelock_state_ids"],
      "properties": {"pass": {"type": "boolean"}, "nonterminating_state_ids": {"type": "array", "items": {"type": "string"}}, "livelock_state_ids": {"type": "array", "items": {"type": "string"}}}
    },
    "checkWithViolations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "violating_transition_ids"],
      "properties": {"pass": {"type": "boolean"}, "violating_transition_ids": {"type": "array", "items": {"type": "string"}}}
    },
    "checkWithRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "missing_recovery_state_ids"],
      "properties": {"pass": {"type": "boolean"}, "missing_recovery_state_ids": {"type": "array", "items": {"type": "string"}}}
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safe", "categories"],
      "properties": {
        "safe": {"const": true},
        "categories": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ABSOLUTE_PATH", "WORKTREE_PATH", "ENVIRONMENT_VALUE", "SECRET_LIKE_VALUE", "SESSION_OR_TASK_IDENTITY", "UNSAFE_PRIVATE_LINK"],
          "properties": {
            "ABSOLUTE_PATH": {"const": 0},
            "WORKTREE_PATH": {"const": 0},
            "ENVIRONMENT_VALUE": {"const": 0},
            "SECRET_LIKE_VALUE": {"const": 0},
            "SESSION_OR_TASK_IDENTITY": {"const": 0},
            "UNSAFE_PRIVATE_LINK": {"const": 0}
          }
        }
      }
    }
  }
}
