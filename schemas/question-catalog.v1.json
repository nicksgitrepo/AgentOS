{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.question_catalog.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "graph_names", "gate_names", "evidence_labels", "digest"],
  "properties": {
    "schema": { "const": "agentos.question_catalog.v1" },
    "version": { "const": 1 },
    "status": { "const": "PREPARED_NOT_ACTIVATED" },
    "graph_names": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 2 } },
    "gate_names": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 2 } },
    "evidence_labels": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 2 } },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
