{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.agent_lifecycle_custody.v1",
  "title": "Spawner-exclusive agent lifecycle custody",
  "type": "object",
  "additionalProperties": false,
  "required": ["spawn", "despawn", "auditor_closeout"],
  "properties": {
    "spawn": {"const": "BOOTSTRAP_MAY_START_EXACTLY_ONE_SPAWNER_THEN_SPAWNER_ONLY"},
    "despawn": {"const": "SPAWNER_ONLY_AFTER_ACCEPTED_HANDOFF_CLOSED_SCOPE_PRESERVED_EVIDENCE_AND_ZERO_REFERENCES"},
    "auditor_closeout": {"const": "DESPAWN_IMMEDIATELY_AFTER_AUDIT_HANDOFF_ACCEPTANCE"}
  }
}
