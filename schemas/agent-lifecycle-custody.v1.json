{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.agent_lifecycle_custody.v1",
  "title": "Spawner-exclusive agent lifecycle custody",
  "type": "object",
  "additionalProperties": false,
  "required": ["spawn", "despawn", "auditor_closeout"],
  "properties": {
    "spawn": {"const": "OPAQUE_CURRENT_ADMITTED_SPAWNER_CAPABILITY_PLUS_CANONICAL_ONE_USE_ROLE_ADMISSION_REFERENCE_AND_DURABLE_LEDGER"},
    "despawn": {"const": "ELIGIBILITY_DERIVED_ONLY_FROM_APPEND_ONLY_HANDOFF_SCOPE_EVIDENCE_WORKTREE_AND_CUSTODY_EVENTS"},
    "auditor_closeout": {"const": "DESPAWN_ONLY_AFTER_ACCEPTED_HANDOFF_AND_ZERO_REFERENCES_DERIVED_FROM_LEDGER"}
  }
}
