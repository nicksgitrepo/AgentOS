{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "agentos.typed_spawner_admission.v1",
  "version": 1,
  "status": "PREPARED_NOT_ACTIVATED",
  "title": "Typed persistent Spawner/Compiler admission",
  "description": "Admits only the project-agnostic persistent Spawner/Compiler after Controller governance readiness and sealed Bootstrap handoff validation. It cannot spawn workers, activate waves, mutate Product state, or use providers/credentials.",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]*$"},
    "identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "blockEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["block_id", "layer", "block_sha256", "status", "non_placeholder", "evaluation", "expires_at_utc", "contradictions", "gate_evidence", "evidence_sha256"],
      "properties": {
        "block_id": {"$ref": "#/$defs/id"},
        "layer": {"enum": ["GLOBAL", "PROJECT", "ROLE", "TECHNOLOGY_OR_STANDARD", "ENVIRONMENT", "TASK"]},
        "block_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "COMPLETE_QA_PASS"},
        "non_placeholder": {"const": true},
        "evaluation": {"const": "PASS"},
        "expires_at_utc": {"type": "string", "format": "date-time"},
        "contradictions": {"const": []},
        "gate_evidence": {"type": "array", "minItems": 1},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "blockSet": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "version", "block_set_id", "required_layers", "block_evidence", "validated_at_utc", "status", "hostile_fixture_ids", "independent_evaluation_sha256", "authority", "stop_conditions", "block_set_sha256"],
      "properties": {
        "schema": {"const": "agentos.spawner_governing_block_set.v1"},
        "version": {"const": 1},
        "block_set_id": {"$ref": "#/$defs/id"},
        "required_layers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["GLOBAL", "PROJECT", "ROLE", "TECHNOLOGY_OR_STANDARD", "ENVIRONMENT", "TASK"]}},
        "block_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/blockEvidence"}},
        "validated_at_utc": {"type": "string", "format": "date-time"},
        "status": {"const": "COMPLETE_QA_PASS"},
        "hostile_fixture_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "independent_evaluation_sha256": {"$ref": "#/$defs/sha256"},
        "authority": {"const": "INDEPENDENT_ADMISSION_AUTHORITY"},
        "stop_conditions": {"type": "string", "minLength": 24},
        "block_set_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "custody": {
      "type": "object", "additionalProperties": false,
      "required": ["route", "controller_id", "spawner_id", "source_readiness_sha256", "source_handoff_sha256", "custody_sha256"],
      "properties": {
        "route": {"const": "CONTROLLER_TO_PERSISTENT_SPAWNER"},
        "controller_id": {"$ref": "#/$defs/identity"},
        "spawner_id": {"$ref": "#/$defs/id"},
        "source_readiness_sha256": {"$ref": "#/$defs/sha256"},
        "source_handoff_sha256": {"$ref": "#/$defs/sha256"},
        "custody_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "properties": {
    "schema": {"const": "agentos.typed_spawner_admission.v1"},
    "version": {"const": 1},
    "spawner_id": {"$ref": "#/$defs/id"},
    "controller_id": {"$ref": "#/$defs/identity"},
    "governance_readiness_sha256": {"$ref": "#/$defs/sha256"},
    "sealed_handoff_sha256": {"$ref": "#/$defs/sha256"},
    "block_set": {"$ref": "#/$defs/blockSet"},
    "custody": {"$ref": "#/$defs/custody"},
    "admission_state": {"const": "ADMITTED_COMPILER_ONLY"},
    "mode": {"const": "COMPILER_ONLY"},
    "temporary_admission": {"const": false},
    "worker_spawned": {"const": false},
    "wave_activation": {"const": "OFF"},
    "product_mutation": {"const": "FORBIDDEN"},
    "provider_access": {"const": "FORBIDDEN"},
    "credential_access": {"const": "FORBIDDEN"},
    "permanent_roles_constructed": {"const": 0},
    "next_action": {"const": "CONSTRUCT_PERMANENT_ROLES_ONE_AT_A_TIME"},
    "admission_sha256": {"$ref": "#/$defs/sha256"}
  },
  "required": [
    "schema", "version", "spawner_id", "controller_id", "governance_readiness_sha256", "sealed_handoff_sha256",
    "block_set", "custody", "admission_state", "mode", "temporary_admission", "worker_spawned", "wave_activation",
    "product_mutation", "provider_access", "credential_access", "permanent_roles_constructed", "next_action", "admission_sha256"
  ],
  "admission_rules": {
    "predecessors": "Controller governance readiness and sealed Bootstrap handoff must both validate and their digests must be bound into custody.",
    "block_gate": "Only a complete non-placeholder QA-passed governing block set with independent evaluation may be admitted.",
    "lifecycle": "The persistent Spawner is admitted compiler-only; permanent roles are constructed one at a time by the next transition.",
    "protected_boundary": "No worker, temporary role, wave, Product mutation, provider, credential, spend, or release action is performed by this contract."
  }
}
