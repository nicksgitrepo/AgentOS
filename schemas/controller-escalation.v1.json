{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/controller-escalation.v1.json",
  "title": "AgentOS Controller Direct Escalation and Continuation",
  "description": "Every Controller blocker is content-bound, routed directly to the owner front door, and either repaired in the same continuation or escalated into an event-driven protected stall with zero resources.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "escalation_id", "blocker_class", "blocker_code", "protected_boundary", "evidence_refs", "attempted_actions", "safe_remaining", "owner_route", "owner_decision_needed", "restart_event", "resource_state", "continuation", "protected_dependency", "escalation_sha256"],
  "properties": {
    "schema": {"const": "agentos.controller_escalation.v1"},
    "version": {"const": 1},
    "escalation_id": {"$ref": "#/$defs/identifier"},
    "blocker_class": {"enum": ["ADMISSION_FAILURE", "AUTH_BOUNDARY", "CONTRADICTION", "COST_BOUNDARY", "DESTRUCTIVE_WORK_BOUNDARY", "PRODUCTION_RELEASE_BOUNDARY", "PROTECTED_DEPENDENCY", "RESOURCE_ISSUE", "WORKFLOW_STOP"]},
    "blocker_code": {"$ref": "#/$defs/identifier"},
    "protected_boundary": {"type": "boolean"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "attempted_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "safe_remaining": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "owner_route": {"$ref": "#/$defs/ownerRoute"},
    "owner_decision_needed": {"type": "string", "minLength": 1},
    "restart_event": {"type": "string", "minLength": 1},
    "resource_state": {"$ref": "#/$defs/resourceState"},
    "continuation": {"$ref": "#/$defs/continuation"},
    "protected_dependency": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/protectedDependency"}]},
    "escalation_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{0,191}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "kind", "reference", "sha256", "status"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/identifier"},
        "kind": {"$ref": "#/$defs/identifier"},
        "reference": {"type": "string", "pattern": "^(opaque:|ref:).+"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["BOUND", "PENDING", "UNAVAILABLE"]}
      }
    },
    "ownerRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "owner_task_id", "route_status", "message_sha256"],
      "properties": {
        "channel": {"const": "OWNER_FRONT_DOOR"},
        "owner_task_id": {"$ref": "#/$defs/identifier"},
        "route_status": {"const": "ROUTED"},
        "message_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "resourceState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temporary_workers", "scheduler_jobs", "heavyweight_processes", "timers", "polling"],
      "properties": {
        "temporary_workers": {"type": "integer", "minimum": 0},
        "scheduler_jobs": {"type": "integer", "minimum": 0},
        "heavyweight_processes": {"type": "integer", "minimum": 0},
        "timers": {"type": "integer", "minimum": 0},
        "polling": {"type": "boolean"}
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "next_action", "same_turn_escalation", "event_driven_idle", "closeout_status"],
      "properties": {
        "mode": {"enum": ["REPAIR_AND_CONTINUE", "ESCALATE_AND_STALL"]},
        "next_action": {"$ref": "#/$defs/identifier"},
        "same_turn_escalation": {"type": "boolean"},
        "event_driven_idle": {"type": "boolean"},
        "closeout_status": {"enum": ["ROUTINE_HANDOFF_ACCEPTED", "STALLED_READY_FOR_RESUMPTION"]}
      }
    },
    "protectedDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency_id", "status", "evidence_ceiling", "sole_protected_dependency"],
      "properties": {
        "dependency_id": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["PENDING_EXTERNAL_AUTHORITY", "OWNER_DECISION_REQUIRED", "PENDING_AUTHORITY"]},
        "evidence_ceiling": {"type": "string", "minLength": 1},
        "sole_protected_dependency": {"const": true}
      }
    }
  }
}
