{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.general_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "graphs", "digest"],
  "properties": {
    "schema": { "const": "agentos.general_manifest.v1" },
    "version": { "const": 1 },
    "status": { "const": "PREPARED_NOT_ACTIVATED" },
    "graphs": { "type": "array", "minItems": 1 },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
