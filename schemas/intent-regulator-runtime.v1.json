{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.intent_regulator_runtime.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "status", "project_id", "project_contract_sha256", "governance",
    "model_policy_sha256", "release_policy_sha256", "offline_policy_sha256", "review_interval_minutes",
    "source_commit", "source_tree", "generated_at_utc", "configuration_sha256"
  ],
  "properties": {
    "schema": {"const": "agentos.intent_regulator_runtime.v1"},
    "version": {"const": 1},
    "status": {"enum": ["PREPARED_NOT_ACTIVATED", "ACTIVE", "CLOSED", "BLOCKED"]},
    "project_id": {"type": "string", "minLength": 1},
    "project_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_general_sha256", "base_role_sha256", "project_general_sha256", "generated_project_role_sha256"],
      "properties": {
        "base_general_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "base_role_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "project_general_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "generated_project_role_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "model_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "release_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "offline_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_interval_minutes": {"type": "integer", "minimum": 1, "maximum": 1440},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
