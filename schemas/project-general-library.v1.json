{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.project_general_library.v1",
  "title": "AgentOS project-owned governance library",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "library_kind", "governance_version", "ownership", "lineage", "project_id", "base_general_library_digest", "base_role_library_digest", "project_context_revision", "project_context_digest", "policy_state_digest", "source_revision", "project_graph_bindings", "default_graph_ids", "role_overlays", "composition_policy", "digest"],
  "properties": {
    "schema": {"const": "agentos.project_general_library.v1"},
    "version": {"const": 1},
    "status": {"enum": ["COMPILED", "INDEPENDENTLY_CHECKED", "OWNER_ACCEPTED", "PREPARED_NOT_ACTIVATED", "ACTIVE", "SUPERSEDED", "REJECTED", "BLOCKED"]},
    "library_kind": {"const": "PROJECT_GENERAL"},
    "governance_version": {"const": "3.0"},
    "ownership": {"$ref": "#/$defs/ownership"},
    "lineage": {"$ref": "#/$defs/lineage"},
    "project_id": {"type": "string"},
    "base_general_library_digest": {"$ref": "#/$defs/digest"},
    "base_role_library_digest": {"$ref": "#/$defs/digest"},
    "project_context_revision": {"type": "string"},
    "project_context_digest": {"$ref": "#/$defs/digest"},
    "policy_state_digest": {"$ref": "#/$defs/digest"},
    "source_revision": {"type": "string"},
    "project_graph_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/graphBinding"},
          {"properties": {"precedence_class": {"const": "PROJECT_ADDITIVE"}}}
        ]
      }
    },
    "default_graph_ids": {"type": "array", "items": {"type": "string"}},
    "role_overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role_id", "graph_ids", "additional_prohibited_authority", "additional_required_evidence"],
        "properties": {
          "role_id": {"type": "string", "not": {"enum": ["AGENTOS.INTENT_REGULATOR", "AGENTOS.PROJECT_OWNER", "INTENT_REGULATOR", "PROJECT_OWNER"]}},
          "graph_ids": {"type": "array", "items": {"type": "string"}},
          "additional_prohibited_authority": {"type": "array", "items": {"type": "string"}},
          "additional_required_evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "composition_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "base_override", "graph_id_collision", "authority_expansion", "duplicate_overlay_policy"],
      "properties": {
        "mode": {"const": "ADDITIVE_ONLY"},
        "base_override": {"const": "REJECT"},
        "graph_id_collision": {"const": "REJECT"},
        "authority_expansion": {"const": "REJECT"},
        "duplicate_overlay_policy": {"const": "REJECT_UNLESS_IDENTICAL"}
      }
    },
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_role", "authoring_role"],
      "properties": {"owner_role": {"const": "AGENTOS.PRODUCT_OWNER"}, "authoring_role": {"const": "AGENTOS.SPAWNER"}}
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "supersedes", "owner_decision_digest", "independent_check_digest"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "supersedes": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "owner_decision_digest": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "independent_check_digest": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}
      }
    },
    "graphBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph_id", "path_ref", "graph_sha256", "domain", "precedence_class"],
      "properties": {
        "graph_id": {"type": "string"},
        "path_ref": {"type": "string"},
        "graph_sha256": {"$ref": "#/$defs/digest"},
        "domain": {"type": "string"},
        "precedence_class": {"type": "string"}
      }
    }
  }
}
