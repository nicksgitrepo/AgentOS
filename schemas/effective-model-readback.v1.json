{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.effective_model_readback.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "route_sha256", "requested_model", "requested_reasoning_effort", "host_execution_ref_sha256", "session_execution_ref_sha256", "host_model", "host_reasoning_effort", "session_model", "session_reasoning_effort", "host_capability_catalog_sha256", "session_capability_catalog_sha256", "host_tools", "session_tools", "host_context_tokens", "session_context_tokens", "host_permissions", "session_permissions", "effective_model", "effective_reasoning_effort", "missing_fields", "mismatch_fields", "reason_code", "acceptance", "protected_actions_enabled", "observed_at_utc", "digest"],
  "properties": {
    "schema": {"const": "agentos.effective_model_readback.v1"},
    "version": {"const": 1},
    "status": {"enum": ["VERIFIED", "UNKNOWN", "MISMATCH"]},
    "route_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requested_model": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "requested_reasoning_effort": {"enum": ["low", "medium", "high", "max"]},
    "host_execution_ref_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "session_execution_ref_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "host_model": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "host_reasoning_effort": {"type": ["string", "null"], "enum": ["low", "medium", "high", "max", null]},
    "session_model": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "session_reasoning_effort": {"type": ["string", "null"], "enum": ["low", "medium", "high", "max", null]},
    "host_capability_catalog_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "session_capability_catalog_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "host_tools": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]*$"}},
    "session_tools": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]*$"}},
    "host_context_tokens": {"type": ["integer", "null"], "minimum": 1},
    "session_context_tokens": {"type": ["integer", "null"], "minimum": 1},
    "host_permissions": {"type": "array", "items": {"enum": ["READ_SOURCE", "READ_ASSIGNED_WORKTREE", "WRITE_ASSIGNED_WORKTREE", "HOST_LIFECYCLE", "EMIT_EVIDENCE", "INDEPENDENT_REVIEW"]}},
    "session_permissions": {"type": "array", "items": {"enum": ["READ_SOURCE", "READ_ASSIGNED_WORKTREE", "WRITE_ASSIGNED_WORKTREE", "HOST_LIFECYCLE", "EMIT_EVIDENCE", "INDEPENDENT_REVIEW"]}},
    "effective_model": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "effective_reasoning_effort": {"type": ["string", "null"], "enum": ["low", "medium", "high", "max", null]},
    "missing_fields": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"}},
    "mismatch_fields": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"}},
    "reason_code": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
    "acceptance": {"type": "boolean"},
    "protected_actions_enabled": {"const": false},
    "observed_at_utc": {"type": "string", "format": "date-time"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
