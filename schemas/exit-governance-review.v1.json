{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.exit_governance_review.v1",
  "title": "Spawner-owned temporary-agent exit governance review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "agent_id", "role_id", "request_sha256", "status", "proposals", "observed_at_utc"],
  "properties": {
    "schema": {"const": "agentos.exit_governance_review.v1"},
    "version": {"const": 1},
    "agent_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{1,191}$"},
    "role_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{1,191}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["NO_CHANGE_RECOMMENDED", "PROPOSALS"]},
    "proposals": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["proposal_id", "layer", "summary", "evidence", "affected_paths", "gate_ids", "expected_benefit", "risks", "applicability", "hostile_regression_candidate", "memory_impact"], "properties": {"proposal_id": {"type": "string"}, "layer": {"enum": ["GLOBAL", "PROJECT", "ROLE", "TECHNOLOGY_OR_STANDARD", "ENVIRONMENT", "TASK"]}, "summary": {"type": "string"}, "evidence": {"type": "array", "minItems": 1}, "affected_paths": {"type": "array", "minItems": 1}, "gate_ids": {"type": "array", "minItems": 1}, "expected_benefit": {"type": "string"}, "risks": {"type": "string"}, "applicability": {"type": "string"}, "hostile_regression_candidate": {"type": "string"}, "memory_impact": {"enum": ["NONE", "POSSIBLE", "REQUIRES_REVIEW"]}}}},
    "observed_at_utc": {"type": "string", "format": "date-time"}
  }
}
