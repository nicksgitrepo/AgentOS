{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.campaign_result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "admission_digest", "graph_digest", "execution", "progress", "gate_responses", "closed_session", "closure", "completion_proof", "digest"],
  "properties": {
    "schema": { "const": "agentos.campaign_result.v1" },
    "version": { "const": 1 },
    "status": { "enum": ["AUDIT_CANDIDATE", "ACCEPTED"] },
    "admission_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "graph_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "execution": { "type": "object" },
    "progress": { "type": "object" },
    "gate_responses": { "type": "array", "minItems": 1 },
    "closed_session": { "type": "object" },
    "closure": { "type": "object" },
    "completion_proof": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
