{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.project_memory_capsule_import.v1",
  "title": "AgentOS project-memory capsule import preparation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "status", "capsule_id", "source_capsule_sha256", "destination_binding",
    "owner_decision_digest", "project_tree_touched", "authority_write_required", "next_action_ref", "digest"
  ],
  "properties": {
    "schema": {"const": "agentos.project_memory_capsule_import.v1"},
    "version": {"const": 1},
    "status": {"enum": ["READY_TO_REPLAY", "RECONCILIATION_REQUIRED"]},
    "capsule_id": {"$ref": "#/$defs/id"},
    "source_capsule_sha256": {"$ref": "#/$defs/sha"},
    "destination_binding": {"$ref": "#/$defs/binding"},
    "owner_decision_digest": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]},
    "project_tree_touched": {"const": false},
    "authority_write_required": {"const": true},
    "next_action_ref": {"$ref": "#/$defs/id"},
    "digest": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_ref", "campaign_ref", "goal_ref", "role_ref", "source_commit", "source_tree", "source_snapshot_sha256", "policy_sha256", "handoff_sha256"],
      "properties": {
        "project_ref": {"$ref": "#/$defs/id"},
        "campaign_ref": {"$ref": "#/$defs/id"},
        "goal_ref": {"$ref": "#/$defs/id"},
        "role_ref": {"$ref": "#/$defs/id"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_snapshot_sha256": {"$ref": "#/$defs/sha"},
        "policy_sha256": {"$ref": "#/$defs/sha"},
        "handoff_sha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
