    "selected_specialist": {"const": "specialist.security.idempotency"}, "handoff": {"type": "object", "additionalProperties": false, "required": ["status", "next_action", "execution_instruction"], "properties": {"status": {"const": "WAITING_WITH_RECEIPT"}, "next_action": {"type": "string"}, "execution_instruction": {"const": false}}}
  }
}
