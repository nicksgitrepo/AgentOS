{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.role_gate_packet.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "role_id", "display_name", "graph_ids", "graph_packets", "digest"],
  "properties": {
    "schema": {"const": "agentos.role_gate_packet.v1"},
    "version": {"const": 1},
    "status": {"const": "PREPARED_NOT_ACTIVATED"},
    "role_id": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "lane_id": {"type": "string", "minLength": 1},
    "graph_ids": {"type": "array", "minItems": 1},
    "graph_packets": {"type": "array", "minItems": 1},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
