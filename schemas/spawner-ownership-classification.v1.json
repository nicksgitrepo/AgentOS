{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.spawner_ownership_classification.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "defect_id", "defect_kind", "affected_layer", "ownership", "protected_boundary", "owner_approval_required", "controller_approval_required", "evidence_sha256", "next_action", "observed_at_utc", "classification_sha256"],
  "properties": {
    "schema": {"const": "agentos.spawner_ownership_classification.v1"},
    "version": {"const": 1},
    "ownership": {"enum": ["SPAWNER_LANE", "OUTSIDE_SPAWNER_LANE"]},
    "owner_approval_required": {"const": false},
    "controller_approval_required": {"const": false},
    "next_action": {"enum": ["START_AUTONOMOUS_REPAIR", "DELIVER_REDISTRIBUTION_HANDOFF"]},
    "classification_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
