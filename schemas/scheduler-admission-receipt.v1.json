{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/scheduler-admission-receipt.v1.json",
  "title": "Scheduler Admission Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "status", "request_id", "candidate_commit", "candidate_tree", "candidate_generation",
    "effective_argv", "working_directory_ref", "dependency_closure_sha256", "runtime_closure_sha256",
    "execution_unit_id", "lane_cursor_ref", "queue_cursor_ref", "admission_sha256"
  ],
  "properties": {
    "schema": {"const": "agentos.scheduler_admission_receipt.v1"},
    "version": {"const": 1},
    "status": {"const": "READY"},
    "request_id": {"type": "string", "minLength": 1},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_generation": {"type": "integer", "minimum": 1},
    "effective_argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "working_directory_ref": {"type": "string", "pattern": "^opaque:[A-Za-z0-9:_-]+$"},
    "dependency_closure_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_closure_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_unit_id": {"type": "string", "minLength": 1},
    "lane_cursor_ref": {"type": "string", "minLength": 1},
    "queue_cursor_ref": {"type": "string", "minLength": 1},
    "admission_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
