{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.private_release_update_receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "phase", "update_id", "project_id", "workspace_binding_digest", "control_snapshot_digest_before", "control_snapshot_digest_after", "current_release", "replacement_release", "governance_mode", "governance_decision_digest", "candidate_root_ref", "retention_root_ref", "project_tree_touched", "rollback_available", "digest"],
  "properties": {
    "schema": {"const": "agentos.private_release_update_receipt.v1"},
    "version": {"const": 1},
    "status": {"const": "VERIFIED"},
    "phase": {"const": "VERIFIED"},
    "update_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "workspace_binding_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "control_snapshot_digest_before": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "control_snapshot_digest_after": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "current_release": {"$ref": "#/$defs/release"},
    "replacement_release": {"$ref": "#/$defs/release"},
    "governance_mode": {"enum": ["KEEP_PROJECT_APPENDICES", "RESET_GOVERNANCE_CLEAN"]},
    "governance_decision_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_root_ref": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "retention_root_ref": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "project_tree_touched": {"const": false},
    "rollback_available": {"const": true},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_commit", "source_tree", "release_digest"],
      "properties": {
        "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "release_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
