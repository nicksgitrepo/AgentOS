{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.memory.continuity_task.v1",
  "title": "AgentOS Memory M2 continuity task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "project_id", "task_id", "original_goal", "worktree", "opened_by", "checkpoint_max_interval_minutes", "created_at_utc", "task_digest"],
  "properties": {
    "schema": {"const": "agentos.memory.continuity_task.v1"},
    "version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "original_goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "success_criteria", "goal_digest"],
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "success_criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "goal_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "worktree": {"$ref": "#/$defs/worktree"},
    "opened_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "generation"],
      "properties": {
        "agent_id": {"$ref": "#/$defs/id"},
        "generation": {"type": "integer", "minimum": 1}
      }
    },
    "checkpoint_max_interval_minutes": {"type": "integer", "minimum": 1, "maximum": 1440},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "task_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-z2-7]{52}$"},
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worktree_id", "path", "branch", "head", "tree", "dirty_patch_digest"],
      "properties": {
        "worktree_id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty_patch_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
