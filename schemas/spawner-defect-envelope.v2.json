{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.spawner_defect_envelope.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "defect_id", "defect_kind", "owning_layer", "ownership_classification", "affected_digests", "required_repair", "owner_approval_required", "controller_approval_required", "next_action", "defect_sha256"],
  "properties": {
    "schema": {"const": "agentos.spawner_defect_envelope.v2"},
    "version": {"const": 2},
    "status": {"enum": ["AUTONOMOUS_REPAIR_STARTED", "REDISTRIBUTION_REQUIRED"]},
    "owning_layer": {"enum": ["GLOBAL", "PROJECT", "ROLE", "TECHNOLOGY_OR_STANDARD", "ENVIRONMENT", "TASK"]},
    "owner_approval_required": {"const": false},
    "controller_approval_required": {"const": false},
    "affected_digests": {"type": "array", "minItems": 1, "uniqueItems": true},
    "defect_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
