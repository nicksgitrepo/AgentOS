{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/object-scope-boundary-result.v1.json",
  "title": "Project-agnostic Object Scope Authorization boundary result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "disposition", "route", "analysis_allowed", "acceptance_allowed", "authorization_decision_allowed", "policy_mutation_allowed", "external_side_effects", "error_code", "input_sha256", "result_sha256"],
  "properties": {
    "schema": {"const": "agentos.object_scope_boundary_result.v1"},
    "version": {"const": 1},
    "disposition": {"enum": ["DENY", "ESCALATE", "ROUTE"]},
    "route": {"type": "string"},
    "analysis_allowed": {"type": "boolean"},
    "acceptance_allowed": {"const": false},
    "authorization_decision_allowed": {"const": false},
    "policy_mutation_allowed": {"const": false},
    "external_side_effects": {"type": "object", "additionalProperties": false},
    "error_code": {"type": "string"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selected_specialist": {"type": "string"},
    "handoff": {"type": "object"},
    "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
