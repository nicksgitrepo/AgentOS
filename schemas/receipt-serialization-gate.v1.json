{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.receipt_serialization_gate.v1",
  "title": "AgentOS Receipt Serialization Gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "gate_id",
    "status",
    "defect_id",
    "authority",
    "custody",
    "serialization_rule",
    "evidence_refs",
    "hostile_fixture_refs",
    "source_action",
    "next_action",
    "next_handler",
    "spawnable",
    "same_turn_dispatch",
    "gate_sha256"
  ],
  "properties": {
    "schema": {"const": "agentos.receipt_serialization_gate.v1"},
    "version": {"const": 1},
    "gate_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{0,191}$"},
    "status": {"const": "REPAIR_REQUIRED"},
    "defect_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{0,191}$"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "receipt_ref", "receipt_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "receipt_ref": {"type": "string", "pattern": "^(?:opaque:|ref:)[^\\s]+$"},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler_only",
        "controller_approval_required",
        "execution_owner",
        "direct_consumer",
        "product_mutation",
        "provider_access",
        "credential_access",
        "spend",
        "destructive_work",
        "worker_activation",
        "wave_activation"
      ],
      "properties": {
        "compiler_only": {"const": true},
        "controller_approval_required": {"const": false},
        "execution_owner": {"const": "LANE_AGENT"},
        "direct_consumer": {"const": "INDEPENDENT_PLATFORM_REVIEW"},
        "product_mutation": {"const": false},
        "provider_access": {"const": false},
        "credential_access": {"const": false},
        "spend": {"const": false},
        "destructive_work": {"const": false},
        "worker_activation": {"const": false},
        "wave_activation": {"const": false}
      }
    },
    "serialization_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parser",
        "terminal_byte",
        "terminal_lf_count",
        "reject_literal_escaped_lf",
        "reject_trailing_data",
        "canonical_digest_revalidation",
        "write_scope"
      ],
      "properties": {
        "parser": {"const": "JSON.parse"},
        "terminal_byte": {"const": 10},
        "terminal_lf_count": {"const": 1},
        "reject_literal_escaped_lf": {"const": true},
        "reject_trailing_data": {"const": true},
        "canonical_digest_revalidation": {"const": true},
        "write_scope": {"const": "CONTROL_PLANE_ONLY"}
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "reference", "sha256"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{0,191}$"},
          "reference": {"type": "string", "pattern": "^(?:opaque:|ref:)[^\\s]+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "hostile_fixture_refs": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 5,
      "items": {
        "type": "string",
        "enum": [
          "FIXTURE.RECEIPT_SERIALIZATION.DIGEST_DRIFT",
          "FIXTURE.RECEIPT_SERIALIZATION.DOUBLE_TERMINAL_LF",
          "FIXTURE.RECEIPT_SERIALIZATION.LITERAL_ESCAPED_LF",
          "FIXTURE.RECEIPT_SERIALIZATION.MISSING_TERMINAL_LF",
          "FIXTURE.RECEIPT_SERIALIZATION.TRAILING_DATA"
        ]
      }
    },
    "source_action": {"const": "COMPILE_BLOCK_PATCH"},
    "next_action": {"const": "REPAIR_BLOCKS"},
    "next_handler": {"const": "HANDLER.ORCHESTRATOR_BLOCK_REPAIR"},
    "spawnable": {"const": false},
    "same_turn_dispatch": {"const": true},
    "gate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
