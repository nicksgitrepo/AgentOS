{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/observability-router-boundary-result.v1.json",
  "title": "Project-agnostic Observability Router boundary result",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "version", "disposition", "route", "error_code", "routing_allowed", "acceptance_allowed", "external_side_effects", "input_sha256", "result_sha256"],
  "properties": {
    "schema": {"const": "agentos.observability_router_boundary_result.v1"}, "version": {"const": 1}, "disposition": {"enum": ["DENY", "ESCALATE", "ROUTE"]}, "route": {"type": "string"}, "error_code": {"type": "string"}, "routing_allowed": {"type": "boolean"}, "acceptance_allowed": {"const": false},
    "external_side_effects": {"type": "object", "additionalProperties": false, "required": ["specialist_invocations", "alert_reads", "production_writes", "incident_commands", "credential_accesses", "state_changes"], "properties": {"specialist_invocations": {"const": 0}, "alert_reads": {"const": 0}, "production_writes": {"const": 0}, "incident_commands": {"const": 0}, "credential_accesses": {"const": 0}, "state_changes": {"const": 0}}},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "missing_fields": {"type": "array", "items": {"type": "string"}}, "selected_specialist": {"type": "string"}, "handoff": {"type": "object"}, "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
