{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.release_policy_replay.v1",
  "title": "Release governance policy replay",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "subject_candidate_sha256", "before_policy_sha256", "after_policy_sha256", "cases", "changed_decision_case_ids", "changed_authority_case_ids", "owner_review_required", "independent_checker_sha256", "replayed_at_utc", "privacy", "replay_sha256"],
  "properties": {
    "schema": {"const": "agentos.release_policy_replay.v1"},
    "version": {"const": 1},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "subject_candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "before_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "after_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "input_sha256", "before_decision_sha256", "after_decision_sha256", "before_authority_sha256", "after_authority_sha256", "decision_changed", "authority_changed", "result", "evidence_sha256"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
          "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "before_decision_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "after_decision_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "before_authority_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "after_authority_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "decision_changed": {"type": "boolean"},
          "authority_changed": {"type": "boolean"},
          "result": {"enum": ["PASS", "FAIL", "PENDING"]},
          "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "changed_decision_case_ids": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}},
    "changed_authority_case_ids": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}},
    "owner_review_required": {"type": "boolean"},
    "independent_checker_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "replayed_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"},
    "privacy": {"$ref": "#/$defs/privacy"},
    "replay_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safe", "categories"],
      "properties": {
        "safe": {"const": true},
        "categories": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ABSOLUTE_PATH", "WORKTREE_PATH", "ENVIRONMENT_VALUE", "SECRET_LIKE_VALUE", "SESSION_OR_TASK_IDENTITY", "UNSAFE_PRIVATE_LINK"],
          "properties": {
            "ABSOLUTE_PATH": {"const": 0},
            "WORKTREE_PATH": {"const": 0},
            "ENVIRONMENT_VALUE": {"const": 0},
            "SECRET_LIKE_VALUE": {"const": 0},
            "SESSION_OR_TASK_IDENTITY": {"const": 0},
            "UNSAFE_PRIVATE_LINK": {"const": 0}
          }
        }
      }
    }
  }
}
