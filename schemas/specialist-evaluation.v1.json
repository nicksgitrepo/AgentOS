{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/specialist-evaluation.v1.json",
  "title": "AgentOS Specialist Block Evaluation Dossier",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "receipt_id", "block_id", "candidate_digest", "model_requirement", "harness", "cases", "results", "disposition", "independence_rule"],
  "properties": {
    "schema": {"const": "agentos.specialist_evaluation.v1"},
    "version": {"const": 1},
    "receipt_id": {"type": "string", "pattern": "^specialist-eval\\.[a-z0-9-]+\\.v[0-9]+$"},
    "block_id": {"type": "string", "pattern": "^specialist\\.[a-z0-9-]+\\.[a-z0-9-]+$"},
    "candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_requirement": {"const": "GLOBAL_MODEL_POLICY_SNAPSHOT/TASK_CLASS_ROUTE"},
    "harness": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "class", "expected", "observed"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "class": {"enum": ["narrowness", "routing", "missing_context", "stale_source", "authority_conflict", "tool_limit", "data_limit", "false_positive", "unsafe_action", "handoff", "umbrella_authority", "unrelated_scope", "silent_scope_expansion", "duplicate_sibling_authority", "router_self_accept", "broad_when_narrow_exists", "cross_provider_version_claim", "missing_approval", "missing_authority", "stale_authority", "unbound_custody", "missing_source_identity"]},
          "expected": {"enum": ["ROUTE", "DENY", "ESCALATE"]},
          "observed": {"enum": ["PASS", "FAIL", "PENDING"]}
        }
      },
      "minItems": 5
    },
    "results": {"type": "object", "additionalProperties": false, "required": ["passed", "failed", "pending"], "properties": {"passed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "pending": {"type": "integer", "minimum": 0}}},
    "disposition": {"enum": ["NOT_RUN", "STATIC_PASS_REVIEW_REQUIRED", "UTILITY_HARM_PENDING", "INTAKE_RECOMMENDED", "REJECTED", "SUSPENDED"]},
    "independence_rule": {"const": "AUTHOR_AND_EVALUATOR_MUST_BE_SEPARATE_CONTROLLED_IDENTITIES_BEFORE_ADMISSION"}
  }
}
