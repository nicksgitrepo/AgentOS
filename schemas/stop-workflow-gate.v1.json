{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/stop-workflow-gate.v1.json",
  "title": "AgentOS fail-closed stop-workflow decision tree",
  "description": "The Controller may stop only when cost, a project/scope change outside the admitted development scope, unbacked deletion, destruction, or a genuine owner-level decision is explicitly YES. Typed in-scope development evidence answers the project/scope question NO. UNKNOWN routes bounded evidence recovery instead of a stop.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "decision_id", "action_ref", "rollback_ref", "question_order", "answers", "outcome",
    "primary_trigger_question_id", "triggered_question_ids", "unknown_question_ids", "next_action", "stop",
    "owner_decision_required", "reason", "decision_sha256"
  ],
  "properties": {
    "schema": {"const": "agentos.stop_workflow_gate.v1"},
    "version": {"const": 1},
    "decision_id": {"$ref": "#/$defs/identifier"},
    "action_ref": {"$ref": "#/$defs/reference"},
    "rollback_ref": {"$ref": "#/$defs/reference"},
    "question_order": {
      "const": [
        "COSTS_MONEY",
        "CHANGES_PROTECTED_PROJECT_OR_SCOPE",
        "DELETES_UNSAVED_OR_UNBACKED_UP_WORK",
        "DESTROYS_OR_IRREVERSIBLY_MODIFIES",
        "OWNER_DECISION_REQUIRED"
      ]
    },
    "answers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/answer"}
    },
    "outcome": {"enum": ["CONTINUE_AUTONOMOUS", "EVIDENCE_REQUIRED", "STOP_OWNER_DECISION", "STOP_DESTRUCTIVE_BOUNDARY"]},
    "primary_trigger_question_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/questionId"}]},
    "triggered_question_ids": {"type": "array", "items": {"$ref": "#/$defs/questionId"}, "uniqueItems": true},
    "unknown_question_ids": {"type": "array", "items": {"$ref": "#/$defs/questionId"}, "uniqueItems": true},
    "next_action": {"enum": ["CONTINUE_NEXT_ACTION", "RUN_NEXT_BOUNDED_RECOVERY", "STOP_DEPENDENT_WORK_OWNER_REVIEW", "STOP_DEPENDENT_WORK_DESTRUCTIVE_REVIEW"]},
    "stop": {"type": "boolean"},
    "owner_decision_required": {"type": "boolean"},
    "reason": {"type": "string", "minLength": 24},
    "decision_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{0,191}$"},
    "reference": {"type": "string", "pattern": "^(?:opaque:|ref:)[A-Za-z0-9._:/-]+$"},
    "questionId": {"enum": ["COSTS_MONEY", "CHANGES_PROTECTED_PROJECT_OR_SCOPE", "DELETES_UNSAVED_OR_UNBACKED_UP_WORK", "DESTROYS_OR_IRREVERSIBLY_MODIFIES", "OWNER_DECISION_REQUIRED"]},
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "answer", "evidence_refs"],
      "properties": {
        "question_id": {"$ref": "#/$defs/questionId"},
        "answer": {"enum": ["YES", "NO", "UNKNOWN"]},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}}
      }
    }
  },
  "decision_rules": [
    "Evaluate the five questions in declared order.",
    "The first YES selects the corresponding stop outcome; all YES questions remain in triggered_question_ids.",
    "If there is no YES but any UNKNOWN, route RUN_NEXT_BOUNDED_RECOVERY and do not stop the workflow.",
    "Only five explicit NO answers select CONTINUE_NEXT_ACTION; an in-scope development NO must be backed by typed admitted-scope and rollback evidence.",
    "The Controller must not treat a timer, heartbeat, commentary, or missing work as a stop condition."
  ]
}
