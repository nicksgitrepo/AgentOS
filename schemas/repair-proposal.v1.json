{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.repair_proposal.v1",
  "title": "AgentOS repair proposal",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9._-]{0,95}$"},
    "opaque": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,31}:[0-9a-f]{64}$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["commit", "tree", "checkpoint_sha256", "clean", "pushed"], "properties": {"commit": {"$ref": "#/$defs/git"}, "tree": {"$ref": "#/$defs/git"}, "checkpoint_sha256": {"$ref": "#/$defs/sha"}, "clean": {"const": true}, "pushed": {"const": false}}},
    "checkpoint": {"$ref": "agentos.digest_bound_checkpoint.v1"},
    "scope": {"type": "object", "additionalProperties": false, "required": ["scope_ref", "affected_paths_sha256", "excluded_scope_sha256", "boundary_sha256", "source_root", "product_writes_allowed", "external_actions_allowed"], "properties": {"scope_ref": {"$ref": "#/$defs/id"}, "affected_paths_sha256": {"$ref": "#/$defs/sha"}, "excluded_scope_sha256": {"$ref": "#/$defs/sha"}, "boundary_sha256": {"$ref": "#/$defs/sha"}, "source_root": {"const": "CONTROL_GOVERNANCE"}, "product_writes_allowed": {"const": false}, "external_actions_allowed": {"const": false}}},
    "safety": {"type": "object", "additionalProperties": false, "required": ["hard_boundaries_immutable", "soft_boundary_review_required", "owner_approval_required", "product_writes_allowed", "external_actions_allowed", "activation_allowed", "deletion_allowed", "authority_change_allowed"], "properties": {"hard_boundaries_immutable": {"const": true}, "soft_boundary_review_required": {"const": true}, "owner_approval_required": {"const": true}, "product_writes_allowed": {"const": false}, "external_actions_allowed": {"const": false}, "activation_allowed": {"const": false}, "deletion_allowed": {"const": false}, "authority_change_allowed": {"const": false}}},
    "protected": {"type": "object", "additionalProperties": false, "required": ["acceptance", "activation", "deletion", "deployment", "external_release", "external_publish", "external_push", "merge", "product_writes", "secrets", "spend", "authority_change"], "properties": {"acceptance": {"const": false}, "activation": {"const": false}, "deletion": {"const": false}, "deployment": {"const": false}, "external_release": {"const": false}, "external_publish": {"const": false}, "external_push": {"const": false}, "merge": {"const": false}, "product_writes": {"const": false}, "secrets": {"const": false}, "spend": {"const": false}, "authority_change": {"const": false}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_attempts", "max_duration_minutes", "max_respawns", "cost_limit_ref"], "properties": {"max_attempts": {"type": "integer", "minimum": 1, "maximum": 2}, "max_duration_minutes": {"type": "integer", "minimum": 1, "maximum": 240}, "max_respawns": {"type": "integer", "minimum": 0, "maximum": 1}, "cost_limit_ref": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]} }},
    "change": {"type": "object", "additionalProperties": false, "required": ["kind", "summary", "change_sha256", "authority_change", "safety_floor_change", "external_actions"], "properties": {"kind": {"$ref": "#/$defs/id"}, "summary": {"type": "string", "minLength": 1, "maxLength": 512}, "change_sha256": {"$ref": "#/$defs/sha"}, "authority_change": {"const": false}, "safety_floor_change": {"const": false}, "external_actions": {"const": false}}},
    "verification": {"type": "object", "additionalProperties": false, "required": ["focused_checks_sha256", "independent_audit_required", "expected_checkpoint_sha256", "expected_safety_floor_sha256"], "properties": {"focused_checks_sha256": {"$ref": "#/$defs/sha"}, "independent_audit_required": {"const": true}, "expected_checkpoint_sha256": {"$ref": "#/$defs/sha"}, "expected_safety_floor_sha256": {"$ref": "#/$defs/sha"}}},
    "approval": {"type": "object", "additionalProperties": false, "required": ["schema", "version", "status", "decision_id", "decision", "actor_ref", "parent_digest", "decided_at_utc", "approval_sha256"], "properties": {"schema": {"const": "agentos.owner_repair_approval.v1"}, "version": {"const": 1}, "status": {"const": "APPROVED"}, "decision_id": {"$ref": "#/$defs/id"}, "decision": {"const": "APPROVE_REPAIR"}, "actor_ref": {"$ref": "#/$defs/opaque"}, "parent_digest": {"$ref": "#/$defs/sha"}, "decided_at_utc": {"type": "string", "format": "date-time"}, "approval_sha256": {"$ref": "#/$defs/sha"}}}
  },
  "required": ["schema", "version", "status", "proposal_id", "parent_rca_sha256", "source_before", "resume_checkpoint", "scope", "smallest_safe_change", "verification_plan", "limits", "safety_floor", "protected_actions", "predecessor_evidence_sha256", "owner_approval", "owner_approval_parent_sha256", "created_at_utc", "admitted_at_utc", "status_reason", "proposal_sha256"],
  "properties": {
    "schema": {"const": "agentos.repair_proposal.v1"},
    "version": {"const": 1},
    "status": {"enum": ["PROPOSED", "ADMITTED", "REJECTED"]},
    "proposal_id": {"$ref": "#/$defs/id"},
    "parent_rca_sha256": {"$ref": "#/$defs/sha"},
    "source_before": {"$ref": "#/$defs/source"},
    "resume_checkpoint": {"$ref": "#/$defs/checkpoint"},
    "scope": {"$ref": "#/$defs/scope"},
    "smallest_safe_change": {"$ref": "#/$defs/change"},
    "verification_plan": {"$ref": "#/$defs/verification"},
    "limits": {"$ref": "#/$defs/limits"},
    "safety_floor": {"$ref": "#/$defs/safety"},
    "protected_actions": {"$ref": "#/$defs/protected"},
    "predecessor_evidence_sha256": {"$ref": "#/$defs/sha"},
    "owner_approval": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/approval"}]},
    "owner_approval_parent_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "admitted_at_utc": {"anyOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]},
    "status_reason": {"type": "string", "minLength": 1, "maxLength": 512},
    "proposal_sha256": {"$ref": "#/$defs/sha"}
  }
}
