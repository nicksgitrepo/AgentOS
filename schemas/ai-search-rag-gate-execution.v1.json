{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/ai-search-rag-gate-execution.v1.json",
  "title": "Executable AI Search/RAG gate-tree readback",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "block_id", "evaluator_entrypoint", "ordered_gate_ids", "executions", "execution_sha256"],
  "properties": {
    "schema": {"const": "agentos.ai_search_rag_gate_execution.v1"},
    "version": {"const": 1},
    "block_id": {"const": "specialist.ai.search-rag"},
    "evaluator_entrypoint": {"const": "control/ai-search-rag-package-evaluator.mjs#evaluateAiSearchRagPackage"},
    "ordered_gate_ids": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": "string"}},
    "executions": {
      "type": "array", "minItems": 12, "maxItems": 12,
      "items": {"type": "object", "additionalProperties": false, "required": ["gate_id", "fixture_class", "expected"], "properties": {
        "gate_id": {"type": "string"},
        "fixture_class": {"type": "string"},
        "adversarial_flags": {"type": "object", "additionalProperties": {"type": "boolean"}},
        "expected": {"type": "object", "additionalProperties": false, "required": ["disposition", "route", "error_code"], "properties": {"disposition": {"enum": ["DENY", "ROUTE"]}, "route": {"type": "string"}, "error_code": {"type": "string"}}}
      }}
    },
    "execution_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
