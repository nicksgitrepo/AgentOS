{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.dynamic_lane_role_packet.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "project_id",
    "campaign_id",
    "goal_id",
    "source_commit",
    "source_tree",
    "bootstrap_plan_sha256",
    "project_governance_sha256",
    "lane_manifest_sha256",
    "dependency_graph_sha256",
    "role_governance_sha256",
    "role_id",
    "display_name",
    "lane_id",
    "lane_kind",
    "capability_id",
    "lane_version",
    "role_scope",
    "role_kind",
    "governance",
    "authority_profile",
    "allowed_authority",
    "prohibited_authority",
    "lease_policy",
    "scope",
    "dependencies",
    "packet_sha256"
  ],
  "properties": {
    "schema": {"const": "agentos.dynamic_lane_role_packet.v1"},
    "version": {"const": 1},
    "status": {"const": "PREPARED_NOT_ACTIVATED"},
    "project_id": {"type": "string"},
    "campaign_id": {"type": "string"},
    "goal_id": {"type": "string"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "bootstrap_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "project_governance_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lane_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dependency_graph_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "role_governance_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "role_id": {"type": "string", "pattern": "^WORKER_[A-Z][A-Z0-9._:-]{0,127}$"},
    "display_name": {"type": "string", "minLength": 1},
    "lane_id": {"type": "string", "pattern": "^(?:FEATURE|CAPABILITY)_[A-Z][A-Z0-9._:-]{0,127}$"},
    "lane_kind": {"enum": ["FEATURE", "CAPABILITY"]},
    "capability_id": {"type": "string"},
    "lane_version": {"type": "string", "pattern": "^v"},
    "role_scope": {"const": "CAMPAIGN"},
    "role_kind": {"const": "ONE_LANE_WORKER"},
    "governance": {"type": "object"},
    "authority_profile": {"type": "string"},
    "allowed_authority": {"type": "array"},
    "prohibited_authority": {"type": "array"},
    "lease_policy": {"enum": ["ONE_ACTIVE_ASSIGNMENT", "CAMPAIGN_LOCAL_SEQUENTIAL"]},
    "scope": {"type": "object"},
    "dependencies": {"type": "array"},
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "rules": [
    "The role ID must be derived from the admitted lane ID.",
    "Generic or unscoped worker identities are rejected.",
    "The packet selects an existing generated governance role; it does not create a second governance authority.",
    "The packet is valid only for its exact project, campaign, goal, source, manifest, and dependency graph."
  ]
}
