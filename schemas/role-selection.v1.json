{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.role_selection.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "general_graph_ids", "roles", "worker_template", "digest"],
  "properties": {
    "schema": { "const": "agentos.role_selection.v1" },
    "version": { "const": 1 },
    "status": { "const": "PREPARED_NOT_ACTIVATED" },
    "general_graph_ids": { "type": "array", "minItems": 1 },
    "roles": { "type": "array", "minItems": 4 },
    "worker_template": { "type": "object" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
