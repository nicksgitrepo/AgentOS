{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.delivery_choice.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "choice_id", "mode", "project_id", "campaign_id", "campaign_version", "goal_id", "accepted_result_digest", "final_audit_digest", "source_commit", "source_tree", "worktree_id", "environment_id", "owner_approval", "selected_at_utc", "digest"],
  "properties": {
    "schema": { "const": "agentos.delivery_choice.v1" },
    "version": { "const": 1 },
    "status": { "const": "PREPARED_NOT_ACTIVATED" },
    "choice_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9._-]*$" },
    "mode": { "enum": ["ACCEPTED_RESULT", "LOCAL_ONLY", "PUSH", "MERGE", "DEPLOY", "RELEASE"] },
    "project_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9._-]*$" },
    "campaign_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9._-]*$" },
    "campaign_version": { "type": "string", "pattern": "^[A-Z][A-Z0-9._-]*$" },
    "goal_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9._-]*$" },
    "accepted_result_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "final_audit_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "worktree_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9._-]*$" },
    "environment_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9._-]*$" },
    "owner_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "decision", "actor_digest", "accepted_result_digest", "final_audit_digest", "decided_at_utc", "digest"],
      "properties": {
        "decision_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9._-]*$" },
        "decision": { "const": "APPROVE" },
        "actor_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "accepted_result_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "final_audit_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "decided_at_utc": { "type": "string", "format": "date-time" },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "selected_at_utc": { "type": "string", "format": "date-time" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
