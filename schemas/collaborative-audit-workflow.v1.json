{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.collaborative_audit_workflow.v1",
  "title": "Six-at-a-time collaborative audit and repair workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "wave_id", "workflow", "status", "builder_id", "builder_spawn_receipt_sha256", "builder_worktree_ref", "auditors", "active_auditor_count", "roster_cursor", "individual_report_paths", "combined_report_path", "issue_directory", "issues", "escalation", "delivery_intent", "runtime_integration", "next_audit_group_may_start", "next_builder_may_take_worktree", "next_action", "wave_sha256"],
  "properties": {
    "schema": {"const": "agentos.collaborative_audit_workflow.v1"}, "version": {"const": 1}, "wave_id": {"type": "string"}, "workflow": {"const": "COLLABORATIVE_AUDIT"},
    "status": {"enum": ["SIX_AUDITORS_ACTIVE", "BULK_REPAIR_ACTIVE", "REAUDIT_REQUIRED", "ESCALATION_REQUIRED", "ESCALATION_REPAIR_ACTIVE", "WAVE_ACCEPTED", "RUNTIME_INTEGRATING", "WAVE_CLOSED"]},
    "builder_id": {"type": "string"}, "builder_spawn_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "builder_worktree_ref": {"type": "string", "pattern": "^opaque:worktree:"},
    "auditors": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["auditor_id", "standard_role_id", "read_only", "may_repair"], "properties": {"auditor_id": {"type": "string"}, "standard_role_id": {"type": "string"}, "read_only": {"const": true}, "may_repair": {"const": false}}}}, "active_auditor_count": {"type": "integer", "minimum": 0, "maximum": 6}, "roster_cursor": {"type": "integer", "minimum": 0},
    "individual_report_paths": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true}, "combined_report_path": {"type": "string"}, "issue_directory": {"type": "string"}, "issues": {"type": "array", "items": {"$ref": "standard-audit-finding.v1.json"}}, "escalation": {"type": ["object", "null"]},
    "delivery_intent": {"enum": ["REVIEW", "SAVE", "SHARE", "LIVE"]}, "runtime_integration": {"type": "string"}, "next_audit_group_may_start": {"type": "boolean"}, "next_builder_may_take_worktree": {"type": "boolean"}, "next_action": {"type": "string"}, "builder_despawn_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "escalation_despawn_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "wave_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
