{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.collaborative_audit_workflow.v1",
  "title": "Six-at-a-time collaborative audit and repair workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "wave_id", "workflow", "status", "builder_id", "builder_spawn_receipt_sha256", "builder_worktree_ref", "auditors", "active_auditor_count", "roster_cursor", "individual_report_paths", "combined_report_path", "issue_directory", "issues", "escalation", "delivery_intent", "runtime_integration", "next_audit_group_may_start", "next_builder_may_take_worktree", "next_action", "wave_sha256"],
  "properties": {
    "schema": {"const": "agentos.collaborative_audit_workflow.v1"}, "version": {"const": 1}, "wave_id": {"type": "string"}, "workflow": {"const": "COLLABORATIVE_AUDIT"},
    "status": {"enum": ["SIX_AUDITORS_ACTIVE", "BULK_REPAIR_ACTIVE", "REAUDIT_REQUIRED", "ESCALATION_REQUIRED", "ESCALATION_REPAIR_ACTIVE", "WAVE_ACCEPTED", "RUNTIME_INTEGRATING", "WAVE_CLOSED"]},
    "builder_id": {"type": "string"}, "builder_spawn_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "builder_worktree_ref": {"type": "string", "pattern": "^opaque:worktree:"},
    "auditors": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["auditor_id", "standard_role_id", "task_id", "round_ref", "round_sha256", "auditor_worktree_ref", "read_only", "may_repair"], "properties": {"auditor_id": {"type": "string"}, "standard_role_id": {"type": "string"}, "task_id": {"type": "string", "pattern": "^TASK\\.AUDITOR\\.[A-Z0-9._:-]{2,160}$"}, "round_ref": {"type": "string", "pattern": "^opaque:round:[A-Z0-9._:/-]{1,180}$"}, "round_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "auditor_worktree_ref": {"type": "string", "pattern": "^opaque:worktree:[A-Z0-9._:/-]{1,180}$"}, "read_only": {"const": true}, "may_repair": {"const": false}}}}, "active_auditor_count": {"type": "integer", "minimum": 0, "maximum": 6}, "roster_cursor": {"type": "integer", "minimum": 0},
    "individual_report_paths": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true}, "combined_report_path": {"type": "string"}, "issue_directory": {"type": "string"}, "issues": {"type": "array", "items": {"$ref": "standard-audit-finding.v1.json"}}, "escalation": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["agent_id", "cloned_chat_ref", "model_id", "reasoning_effort", "route_sha256", "capability_floor", "selected_capability_score", "model_policy_snapshot_sha256", "model_policy_projection_sha256", "spawn_receipt_sha256", "partner_auditor_ids", "combined_report_path", "worktree_ref"], "properties": {"agent_id": {"type": "string"}, "cloned_chat_ref": {"type": "string", "pattern": "^opaque:builder-chat:"}, "model_id": {"type": "string", "minLength": 3}, "reasoning_effort": {"type": "string", "minLength": 3}, "route_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "capability_floor": {"type": "number"}, "selected_capability_score": {"type": "number"}, "model_policy_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "model_policy_projection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "spawn_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "partner_auditor_ids": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "string"}}, "combined_report_path": {"type": "string"}, "worktree_ref": {"type": "string", "pattern": "^opaque:worktree:"}}}]},
    "delivery_intent": {"enum": ["REVIEW", "SAVE", "SHARE", "LIVE"]}, "runtime_integration": {"type": "string"}, "next_audit_group_may_start": {"type": "boolean"}, "next_builder_may_take_worktree": {"type": "boolean"}, "next_action": {"type": "string"}, "builder_despawn_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "escalation_despawn_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "wave_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
