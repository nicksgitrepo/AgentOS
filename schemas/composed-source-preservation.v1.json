{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/composed-source-preservation.v1.json",
  "title": "AgentOS composed source-preservation plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "governance_version", "status", "project_import_plan_sha256", "destination_root_ref", "external_preservation_root_ref", "repositories", "exclusions", "boundaries", "verification", "rollback", "execution", "observed_at_utc", "plan_sha256"],
  "properties": {
    "schema": {"const": "agentos.composed_source_preservation_plan.v1"},
    "version": {"const": 1},
    "governance_version": {"const": "2.1rc"},
    "status": {"enum": ["PLANNED", "VERIFIED_PLAN", "NOT_AUTHORIZED"]},
    "project_import_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "destination_root_ref": {"type": "string", "pattern": "^opaque:worktree:[0-9a-f]{64}$"},
    "external_preservation_root_ref": {"type": "string", "pattern": "^opaque:[a-z][a-z0-9._-]*:[0-9a-f]{64}$"},
    "repositories": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/repository"}},
    "exclusions": {"type": "object", "additionalProperties": false, "required": ["repositories"], "properties": {"repositories": {"type": "array", "items": {"$ref": "#/$defs/exclusion"}}}},
    "boundaries": {"type": "object", "additionalProperties": false, "required": ["source_mutation", "destination_mutation", "archive_creation", "zero_trace_consumer"], "properties": {"source_mutation": {"const": "DENY"}, "destination_mutation": {"const": "DENY"}, "archive_creation": {"const": "NOT_PERFORMED"}, "zero_trace_consumer": {"const": true}}},
    "verification": {"type": "object", "additionalProperties": false, "required": ["before_write", "after_creation", "independent_reviewer_required", "consumer_byte_for_byte_check", "no_archive_created_in_this_plan"], "properties": {"before_write": {"type": "array", "minItems": 5, "items": {"type": "string"}}, "after_creation": {"type": "array", "minItems": 5, "items": {"type": "string"}}, "independent_reviewer_required": {"const": true}, "consumer_byte_for_byte_check": {"const": true}, "no_archive_created_in_this_plan": {"const": true}}},
    "rollback": {"type": "object", "additionalProperties": false, "required": ["sources_retained", "cutover_reversible", "restore_rule"], "properties": {"sources_retained": {"const": true}, "cutover_reversible": {"const": true}, "restore_rule": {"type": "string", "minLength": 1}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["status", "mutation", "activation", "archive_creation"], "properties": {"status": {"const": "NOT_AUTHORIZED"}, "mutation": {"const": "NONE"}, "activation": {"const": "OFF"}, "archive_creation": {"const": "NOT_PERFORMED"}}},
    "observed_at_utc": {"type": "string", "format": "date-time"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "repository": {"type": "object", "additionalProperties": false, "required": ["repository_id", "source_root_ref", "commit", "tree", "branch", "remote_refs", "dirty_state", "worktree_evidence", "submodule_policy", "exclusions", "restore_procedure", "artifacts"], "properties": {"repository_id": {"type": "string"}, "source_root_ref": {"type": "string", "pattern": "^opaque:worktree:[0-9a-f]{64}$"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "branch": {"type": "string"}, "remote_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "dirty_state": {"type": "object"}, "worktree_evidence": {"type": "object"}, "submodule_policy": {"const": "RECORD_AND_VERIFY;_DO_NOT_TRAVERSE_UNBOUND_SUBMODULES"}, "exclusions": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "restore_procedure": {"type": "string", "minLength": 1}, "artifacts": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/artifact"}}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["artifact_name", "artifact_ref", "content_addressing", "planned_identity_sha256"], "properties": {"artifact_name": {"type": "string"}, "artifact_ref": {"type": "string", "pattern": "^opaque:[a-z][a-z0-9._-]*:[0-9a-f]{64}$"}, "content_addressing": {"const": "CONTENT_ADDRESS_AFTER_CREATION_AND_FULL_READBACK"}, "planned_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "exclusion": {"type": "object", "additionalProperties": false, "required": ["repository_id", "root_ref", "reason", "preserved_outside_product"], "properties": {"repository_id": {"type": "string"}, "root_ref": {"type": "string", "pattern": "^opaque:worktree:[0-9a-f]{64}$"}, "reason": {"type": "string", "minLength": 1}, "preserved_outside_product": {"const": true}}}
  }
}
