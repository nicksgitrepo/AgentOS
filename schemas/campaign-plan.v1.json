{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.campaign_plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "project_id", "campaign_id", "campaign_version", "goal_id", "goal_sha256", "source", "defaults", "persistent_roles", "campaign_roles", "phases", "role_library_digest", "digest"],
  "properties": {
    "schema": { "const": "agentos.campaign_plan.v1" },
    "version": { "const": 1 },
    "status": { "const": "PREPARED_NOT_ACTIVATED" },
    "project_id": { "type": "string" },
    "campaign_id": { "type": "string" },
    "campaign_version": { "type": "string" },
    "goal_id": { "type": "string" },
    "goal_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source": { "type": "object" },
    "defaults": { "type": "object" },
    "persistent_roles": { "const": ["INTENT_REGULATOR", "RUNTIME"] },
    "campaign_roles": { "const": ["CAMPAIGN_ORCHESTRATOR", "INDEPENDENT_AUDITOR"] },
    "phases": { "type": "array", "minItems": 1 },
    "role_library_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
