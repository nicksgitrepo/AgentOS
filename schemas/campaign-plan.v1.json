{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.campaign_plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "project_id", "campaign_id", "campaign_version", "goal_id", "goal_sha256", "source", "workspace_boundary", "defaults", "persistent_roles", "campaign_roles", "phases", "role_library_digest", "digest"],
  "properties": {
    "schema": { "const": "agentos.campaign_plan.v1" },
    "version": { "const": 1 },
    "status": { "const": "PREPARED_NOT_ACTIVATED" },
    "project_id": { "type": "string" },
    "campaign_id": { "type": "string" },
    "campaign_version": { "type": "string", "pattern": "^(?:v[0-9]+[.][0-9]+[.][0-9]+(?:-(?:tb|rc)-[0-9]+)?|[A-Z][A-Z0-9._-]*)$" },
    "goal_id": { "type": "string" },
    "goal_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source": { "type": "object" },
    "workspace_boundary": { "$ref": "workspace-boundary.v2.json" },
    "defaults": { "type": "object" },
    "persistent_roles": { "const": ["INTENT_REGULATOR", "RUNTIME"] },
    "campaign_roles": { "const": ["CAMPAIGN_ORCHESTRATOR", "INDEPENDENT_AUDITOR"] },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["phase_id", "purpose", "worker_assignments", "auditor"],
        "properties": {
          "phase_id": { "type": "string" },
          "purpose": { "type": "string" },
          "worker_assignments": { "type": "array", "minItems": 1 },
          "auditor": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role_id", "display_name", "lifetime", "task_name", "prompt", "audit_lane_ids", "status"],
            "properties": {
              "role_id": { "const": "INDEPENDENT_AUDITOR" },
              "display_name": { "type": "string", "pattern": "^.+ Auditor (?:v[0-9]+[.][0-9]+[.][0-9]+(?:-(?:tb|rc)-[0-9]+)?|[A-Z][A-Z0-9._-]*)$" },
              "lifetime": { "const": "CAMPAIGN_PHASE" },
              "task_name": { "type": "string", "pattern": "^task_ref_[0-9a-f]{64}$" },
              "prompt": { "type": "string" },
              "audit_lane_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "status": { "const": "NOT_STARTED" }
            }
          }
        }
      }
    },
    "role_library_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
