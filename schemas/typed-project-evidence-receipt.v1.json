{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/typed-project-evidence-receipt.v1.json",
  "title": "AgentOS typed project-evidence authority-exclusion receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "evidence",
    "excluded_paths",
    "portable_kernel_input",
    "mutation",
    "activation",
    "invalidation_rule",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "agentos.typed_project_evidence_binding.v1"},
    "version": {"const": 1},
    "status": {"const": "BOUND_EXCLUDED_FROM_PORTABLE_AUTHORITY"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      },
      "uniqueItems": true
    },
    "excluded_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "portable_kernel_input": {"const": false},
    "mutation": {"const": "NONE"},
    "activation": {"const": "OFF"},
    "invalidation_rule": {"type": "string", "minLength": 1},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
