{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/observed-dispatch-binding-gate.v1.json",
  "title": "AgentOS Observed Dispatch Successor Binding Gate",
  "description": "Project-agnostic binding that rejects same-turn progress claims unless the registry-bound handler invocation and canonical dispatch readback are present and cross-bound.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "binding_id", "status", "source_successor_sha256", "source_action", "source_handler",
    "execution_owner", "direct_consumer", "controller_approval_required", "same_turn_dispatch", "progress_claimed",
    "dispatch_readback", "dispatch_observation", "evidence_refs", "hostile_fixture_refs", "binding_sha256"
  ],
  "properties": {
    "schema": {"const": "agentos.observed_dispatch_successor_binding.v1"},
    "version": {"const": 1},
    "binding_id": {"$ref": "#/$defs/identifier"},
    "status": {"enum": ["DISPATCH_REQUIRED", "DISPATCH_PROVEN"]},
    "source_successor_sha256": {"$ref": "#/$defs/sha256"},
    "source_action": {"$ref": "#/$defs/identifier"},
    "source_handler": {"$ref": "#/$defs/identifier"},
    "execution_owner": {"const": "LANE_AGENT"},
    "direct_consumer": {"const": "INDEPENDENT_PLATFORM_REVIEW"},
    "controller_approval_required": {"const": false},
    "same_turn_dispatch": {"const": true},
    "progress_claimed": {"type": "boolean"},
    "dispatch_readback": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "description": "Canonical agentos.orchestrator_successor_dispatch.v1 readback validated by the executable dispatch gate."}
      ]
    },
    "dispatch_observation": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "handler_invoked", "handler", "dispatch_id", "readback_sha256"],
          "properties": {
            "status": {"const": "OBSERVED"},
            "handler_invoked": {"const": true},
            "handler": {"$ref": "#/$defs/identifier"},
            "dispatch_id": {"$ref": "#/$defs/identifier"},
            "readback_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "evidence_refs": {"$ref": "#/$defs/evidenceRefs"},
    "hostile_fixture_refs": {"$ref": "#/$defs/identifierArray"},
    "binding_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{0,191}$"},
    "reference": {"type": "string", "pattern": "^(opaque:|ref:)[^\\s]+$"},
    "identifierArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "reference", "sha256"],
        "properties": {
          "evidence_id": {"$ref": "#/$defs/identifier"},
          "reference": {"$ref": "#/$defs/reference"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  }
}
