{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/auditor-round-independent-review.v1.json",
  "title": "Sealed independent evaluator receipt for an auditor round",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "receipt_id", "issuer_id", "issuer_role", "result", "candidate_commit_sha1", "candidate_tree_sha1", "rollback_commit_sha1", "rollback_tree_sha1", "candidate_ref", "round_ref", "round_sha256", "package_sha256", "gate_inventory_sha256", "fixture_inventory_sha256", "context_sha256", "execution_sha256", "evaluator_admission_sha256", "authority_epoch", "issued_at_utc", "expires_at_utc", "signature_status", "receipt_sha256"],
  "properties": {
    "schema": {"const": "agentos.auditor_round_independent_review.v1"},
    "version": {"const": 1},
    "receipt_id": {"type": "string", "pattern": "^opaque:receipt:[A-Z0-9._:/-]{1,180}$"},
    "issuer_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{2,191}$"},
    "issuer_role": {"const": "AGENT.INDEPENDENT_EVALUATOR"},
    "result": {"enum": ["PASS", "NOT_APPLICABLE_WITH_EVIDENCE"]},
    "candidate_commit_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_tree_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "rollback_commit_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "rollback_tree_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_ref": {"type": "string", "pattern": "^opaque:candidate:[A-Z0-9._:/-]{1,180}$"},
    "round_ref": {"type": "string", "pattern": "^opaque:round:[A-Z0-9._:/-]{1,180}$"},
    "round_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gate_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fixture_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluator_admission_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_epoch": {"type": "integer", "minimum": 1},
    "issued_at_utc": {"type": "string", "format": "date-time"},
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "signature_status": {"const": "VERIFIED_BY_EXTERNAL_EVALUATOR"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
