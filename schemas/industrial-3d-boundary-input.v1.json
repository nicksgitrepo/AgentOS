            "authority_conflict": {"type": "boolean"}, "scope_expanded": {"type": "boolean"}, "protected_data": {"type": "boolean"}, "stale_source": {"type": "boolean"},
            "unsupported_tool": {"type": "boolean"}, "duplicate_authority": {"type": "boolean"}, "self_acceptance": {"type": "boolean"}, "unrelated_scope": {"type": "boolean"},
            "missing_context": {"type": "boolean"}, "unsafe_action": {"type": "boolean"}, "broad_claim": {"type": "boolean"}, "cross_provider": {"type": "boolean"},
            "false_positive": {"type": "boolean"}, "memory_stale": {"type": "boolean"}, "context_invalidated": {"type": "boolean"}, "model_policy_drift": {"type": "boolean"},
            "source_superseded": {"type": "boolean"}, "lifecycle_invalid": {"type": "boolean"}
          }
