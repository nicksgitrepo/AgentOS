        "authority_scope": {"type": "string"},
        "upstream_router_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "context_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "memory_readback_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "upstream_router_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "upstream_router_block_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "upstream_router_fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "upstream_router_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "upstream_router_expected_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "upstream_router_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "upstream_router_model_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "upstream_router_model_route_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "upstream_router_model_policy_claim": {"type": "string"},
        "upstream_router_model_binding_status": {"type": "string"},
        "context_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "agent_roster_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "specialist_roster_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "atomic_inventory_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "routing_index_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "registry_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "registry_agent_state": {"const": "CANDIDATE_READY_FOR_QUALIFICATION"},
        "agent_roster_status": {"const": "COMPILED_CANDIDATE"},
        "specialist_roster_status": {"const": "COMPILED_CANDIDATE"},
