{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.permanent_role_governed_admission.v1",
  "title": "Governed permanent-role admission receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "role_id", "role_class", "receipt_ref", "candidate_root_sha256", "package_block_sha256", "gate_inventory_sha256", "fixture_execution_sha256", "external_review_receipt_sha256", "evaluator_admission_receipt_sha256", "operational_context_sha256", "model_snapshot_sha256", "model_selection_sha256", "custody_receipt_sha256", "consumption_event_sha256", "receipt_sha256"],
  "properties": {
    "schema": {"const": "agentos.permanent_role_governed_admission.v1"},
    "version": {"const": 1},
    "status": {"const": "ADMITTED_ONE_USE"},
    "role_id": {"type": "string", "minLength": 3, "maxLength": 192},
    "role_class": {"enum": ["CONTROLLER", "PRODUCT_OWNER", "MEMORY", "RUNTIME", "SCHEDULER", "ORCHESTRATOR"]},
    "receipt_ref": {"type": "string", "pattern": "^(?:ref|opaque):[^\\s]{1,512}$"},
    "candidate_root_sha256": {"$ref": "#/$defs/sha256"},
    "package_block_sha256": {"$ref": "#/$defs/sha256"},
    "gate_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "fixture_execution_sha256": {"$ref": "#/$defs/sha256"},
    "external_review_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "evaluator_admission_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "operational_context_sha256": {"$ref": "#/$defs/sha256"},
    "model_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "model_selection_sha256": {"$ref": "#/$defs/sha256"},
    "custody_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "consumption_event_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
