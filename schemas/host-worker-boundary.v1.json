{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.host_worker_boundary.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "worker_id", "worker_scope", "workspace_mode", "source_root_kind", "host_project_id", "host_project_role", "campaign_project_id", "source_binding", "workspace_boundary", "product_action", "protected_actions", "workspace_path_ref", "digest"],
  "properties": {
    "schema": { "const": "agentos.host_worker_boundary.v1" },
    "version": { "const": 1 },
    "status": { "const": "PREPARED_NOT_ACTIVATED" },
    "worker_id": { "type": "string" },
    "worker_scope": { "enum": ["RELEASE_CONTROL", "PRODUCT"] },
    "workspace_mode": { "enum": ["HOST_MANAGED_VISIBLE", "CONTROL_ISOLATED"] },
    "source_root_kind": { "enum": ["RELEASE", "PRODUCT"] },
    "host_project_id": { "type": "string", "pattern": "^HOST_REF_[0-9a-f]{64}$" },
    "host_project_role": { "enum": ["RELEASE", "CONTROL", "PRODUCT"] },
    "campaign_project_id": { "type": "string" },
    "source_binding": { "type": "object" },
    "workspace_boundary": { "$ref": "workspace-boundary.v2.json" },
    "product_action": { "const": "LEAVE_PRODUCT_REPOSITORY_UNCHANGED" },
    "protected_actions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "workspace_path_ref": { "type": ["string", "null"] },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
