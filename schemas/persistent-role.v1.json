{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.persistent_role.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "role_id", "lifetime", "project_id", "environment_id", "host_session_id", "source_commit", "source_tree", "governance_digest", "model", "reasoning_effort", "created_at_utc", "digest"],
  "properties": {
    "schema": { "const": "agentos.persistent_role.v1" },
    "version": { "const": 1 },
    "status": { "const": "ACTIVE" },
    "role_id": { "enum": ["INTENT_REGULATOR", "RUNTIME"] },
    "lifetime": { "const": "PERSISTENT" },
    "project_id": { "type": "string" },
    "environment_id": { "type": "string" },
    "host_session_id": { "type": "string" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "governance_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "model": { "const": "gpt-5.6-luna" },
    "reasoning_effort": { "const": "max" },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
