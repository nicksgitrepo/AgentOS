{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/owasp-api-2023-api1-object-authorization-gate-execution.v1.json",
  "title": "Executable OWASP API API1 gate-tree readback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "block_id",
    "evaluator_entrypoint",
    "ordered_gate_ids",
    "executions"
  ],
  "properties": {
    "schema": {
      "const": "agentos.owasp_api_object_authorization_gate_execution.v1"
    },
    "version": {
      "const": 1
    },
    "block_id": {
      "const": "specialist.security.owasp-api-2023-api1-object-authorization"
    },
    "evaluator_entrypoint": {
      "const": "control/owasp-api-2023-api1-object-authorization-package-evaluator.mjs#evaluateOwaspApiObjectAuthorizationPackage"
    },
    "ordered_gate_ids": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "string"
      }
    },
    "executions": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "fixture_class"
        ],
        "properties": {
          "gate_id": {
            "type": "string"
          },
          "fixture_class": {
            "type": "string"
          },
          "adversarial_flags": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "disposition",
              "route",
              "error_code"
            ],
            "properties": {
              "disposition": {
                "enum": [
                  "DENY",
                  "ROUTE"
                ]
              },
              "route": {
                "type": "string"
              },
              "error_code": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
