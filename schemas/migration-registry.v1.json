{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.migration_registry.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "max_control_module_lines", "seams", "digest"],
  "properties": {
    "schema": { "const": "agentos.migration_registry.v1" },
    "version": { "const": 1 },
    "status": { "const": "PREPARED_NOT_ACTIVATED" },
    "max_control_module_lines": { "type": "integer", "minimum": 1 },
    "seams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seam_id", "replacement_paths", "evidence_test", "status"],
        "properties": {
          "seam_id": { "type": "string", "minLength": 1 },
          "replacement_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "evidence_test": { "type": "string", "minLength": 1 },
          "status": { "enum": ["MIGRATED", "PARTIAL", "EXTERNAL_HOST_REQUIRED"] }
        }
      }
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
