{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/orchestrator-successor-dispatch.v1.json",
  "title": "AgentOS Orchestrator same-turn successor dispatch",
  "description": "A typed Orchestrator successor is not considered dispatched until a registered handler is invoked and each resulting receipt is atomically persisted. A bounded local chain may end at its transition cap only after an executable next-lifecycle starter returns a content-addressed STARTED handoff; a receipt that merely names a future handler is a workflow defect. Ordinary work remains lane-owned: the successor must not require Controller approval and must route directly to independent platform review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "dispatch_id", "status", "source_successor_sha256", "source_action", "source_handler",
    "dispatched_count", "persisted_receipt_sha256s", "final_receipt_sha256", "final_next_action", "final_next_handler",
    "dispatch_observed", "next_lifecycle", "continuation", "scope", "evidence_refs", "hostile_fixture_refs", "readback_sha256"
  ],
  "properties": {
    "schema": {"const": "agentos.orchestrator_successor_dispatch.v1"},
    "version": {"const": 1},
    "dispatch_id": {"$ref": "#/$defs/identifier"},
    "status": {"enum": ["DISPATCHED_SAME_TURN", "DISPATCHED_TO_OWNER_REVIEW", "DISPATCHED_TO_PROTECTED_WAIT"]},
    "source_successor_sha256": {"$ref": "#/$defs/sha256"},
    "source_action": {"$ref": "#/$defs/dispatchableAction"},
    "source_handler": {"$ref": "#/$defs/identifier"},
    "dispatched_count": {"type": "integer", "minimum": 1},
    "persisted_receipt_sha256s": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}},
    "final_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "final_next_action": {"$ref": "#/$defs/identifier"},
    "final_next_handler": {"$ref": "#/$defs/identifier"},
    "dispatch_observed": {"const": true},
    "next_lifecycle": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "version", "status", "source_receipt_sha256", "next_action", "next_handler", "handoff_ref", "handoff_sha256", "started_same_turn"],
          "properties": {
            "schema": {"const": "agentos.controller_next_lifecycle_handoff.v1"},
            "version": {"const": 1},
            "status": {"const": "STARTED"},
            "source_receipt_sha256": {"$ref": "#/$defs/sha256"},
            "next_action": {"$ref": "#/$defs/identifier"},
            "next_handler": {"$ref": "#/$defs/identifier"},
            "handoff_ref": {"type": "string", "pattern": "^(opaque:|ref:)[^\\s]+$"},
            "handoff_sha256": {"$ref": "#/$defs/sha256"},
            "started_same_turn": {"const": true}
          }
        }
      ]
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "timer_deferral", "heartbeat_deferral", "same_turn_dispatch", "protected_event_id", "resume_condition"],
      "properties": {
        "mode": {"enum": ["IMMEDIATE_SAME_TURN", "EVENT_DRIVEN_PROTECTED_WAIT", "EXPLICIT_OWNER_REVIEW"]},
        "timer_deferral": {"const": false},
        "heartbeat_deferral": {"const": false},
        "same_turn_dispatch": {"type": "boolean"},
        "protected_event_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]},
        "resume_condition": {"type": "string", "minLength": 8}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_plane_only", "consumer_product_mutated", "provider_access", "credential_access", "spend", "destructive_work", "deployment_publication_merge", "protected_event_id"],
      "properties": {
        "control_plane_only": {"const": true},
        "consumer_product_mutated": {"const": false},
        "provider_access": {"const": false},
        "credential_access": {"const": false},
        "spend": {"const": false},
        "destructive_work": {"const": false},
        "deployment_publication_merge": {"const": false},
        "protected_event_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]}
      }
    },
    "evidence_refs": {"$ref": "#/$defs/evidenceRefs"},
    "hostile_fixture_refs": {"$ref": "#/$defs/identifierArray"},
    "readback_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{0,191}$"},
    "dispatchableAction": {"enum": ["MATERIALIZE_NEW_PROJECT_REPOSITORIES", "PREPARE_CANDIDATE_REVIEW", "PREPARE_PYRAMID_IMPORT_OUTPUT", "REPAIR_BLOCKS", "REQUEST_SPAWNER_QA", "RETRY_SPAWNER_QA", "RUN_LOCAL_CANDIDATE_PROOF", "START_CENTRAL_INTEGRATION", "START_INDEPENDENT_REAUDIT", "START_ISOLATED_AUDIT_LANES", "START_PLATFORM_REVIEW", "START_SPECIALIST_WAVE"]},
    "identifierArray": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "reference", "sha256"],
        "properties": {
          "evidence_id": {"$ref": "#/$defs/identifier"},
          "reference": {"type": "string", "pattern": "^(opaque:|ref:)[^\\s]+$"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "state_rules": {
    "dispatch": "A successor is dispatchable only after the executable adapter validates its action, handler, continuation, persistence, and lane-custody metadata; a hand-written receipt or claimed same-turn flag is never sufficient.",
    "custody": "The source successor result must declare controller_approval_required=false, execution_owner=LANE_AGENT, and direct_consumer=INDEPENDENT_PLATFORM_REVIEW. The Controller observes liveness and custody only; it is not an ordinary approval gate.",
    "continuation": "Every dispatched local successor is invoked in the same turn with timer_deferral=false and heartbeat_deferral=false. If the bounded local-chain cap is reached, an executable next-lifecycle starter must return a content-addressed STARTED handoff bound to the final receipt before the readback can close; naming a registry-bound action without starting it is a workflow defect. NONE, DONE, timer-only, heartbeat-only, and silent terminal states are invalid; protected or owner boundaries must be explicit typed continuations.",
    "failure": "Missing handlers, false persistence, unchanged semantic state, invalid custody metadata, or null/mismatched digests fail closed before the transition is accepted and must route to a typed repair or retry action."
  }
}
