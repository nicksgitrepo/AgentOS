{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.external_spawner_review_receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "receipt_id", "reviewer_id", "reviewer_role", "authority_epoch", "git_ancestry", "candidate_package_sha256", "candidate_package_file_sha256", "candidate_root_sha256", "gate_manifest_sha256", "fixture_manifest_sha256", "hostile_evaluation_sha256", "fixture_result_count", "fixture_inventory_sha256", "scope", "custody", "result", "issued_at_utc", "expires_at_utc", "nonce_sha256", "receipt_sha256", "signature_base64"],
  "properties": {
    "schema": {"const": "agentos.external_spawner_review_receipt.v1"}, "version": {"const": 1},
    "receipt_id": {"type": "string", "minLength": 1}, "reviewer_id": {"type": "string", "minLength": 1}, "reviewer_role": {"const": "AGENT.INDEPENDENT_EVALUATOR"}, "authority_epoch": {"type": "integer", "minimum": 1},
    "git_ancestry": {"type": "object", "additionalProperties": false, "required": ["schema", "version", "candidate_commit", "candidate_tree", "direct_parent_commits", "authorized_predecessor_commit", "merge_base_commit", "ancestry_path", "interposed_commits", "ancestry_sha256"], "properties": {"schema": {"const": "agentos.spawner_git_ancestry.v1"}, "version": {"const": 1}, "candidate_commit": {"$ref": "#/$defs/git"}, "candidate_tree": {"$ref": "#/$defs/git"}, "direct_parent_commits": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/git"}}, "authorized_predecessor_commit": {"$ref": "#/$defs/git"}, "merge_base_commit": {"$ref": "#/$defs/git"}, "ancestry_path": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/git"}}, "interposed_commits": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/git"}}, "ancestry_sha256": {"$ref": "#/$defs/sha"}}},
    "candidate_package_sha256": {"$ref": "#/$defs/sha"}, "candidate_package_file_sha256": {"$ref": "#/$defs/sha"}, "candidate_root_sha256": {"$ref": "#/$defs/sha"}, "gate_manifest_sha256": {"$ref": "#/$defs/sha"}, "fixture_manifest_sha256": {"$ref": "#/$defs/sha"}, "hostile_evaluation_sha256": {"$ref": "#/$defs/sha"}, "fixture_result_count": {"type": "integer", "minimum": 1}, "fixture_inventory_sha256": {"$ref": "#/$defs/sha"},
    "scope": {"const": ["CANDIDATE_COMPONENT_ROOT", "GATE_BYTES", "HOSTILE_FIXTURE_EXECUTION"]},
    "custody": {"type": "object", "additionalProperties": false, "required": ["read_only_candidate", "builder_separated", "governance_write_capability"], "properties": {"read_only_candidate": {"const": true}, "builder_separated": {"const": true}, "governance_write_capability": {"const": false}}},
    "result": {"const": "PASS"}, "issued_at_utc": {"type": "string"}, "expires_at_utc": {"type": "string"}, "nonce_sha256": {"$ref": "#/$defs/sha"}, "receipt_sha256": {"$ref": "#/$defs/sha"}, "signature_base64": {"type": "string", "minLength": 1}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "git": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}
}
