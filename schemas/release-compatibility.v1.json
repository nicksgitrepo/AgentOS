{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.release_compatibility_evidence.v1",
  "title": "Release compatibility evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "subject_candidate_sha256", "release_version", "migration_plan_sha256", "migration_journal_status", "migration_source_sha256", "load_bearing_fingerprints_sha256", "required_scenarios", "cases", "independent_checker_sha256", "checked_at_utc", "privacy", "compatibility_sha256"],
  "properties": {
    "schema": {"const": "agentos.release_compatibility_evidence.v1"},
    "version": {"const": 1},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "subject_candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "release_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "migration_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "migration_journal_status": {"enum": ["JOURNALED", "INTENTIONALLY_JOURNALLESS", "MISSING_OR_UNPROVEN"]},
    "migration_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "load_bearing_fingerprints_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "required_scenarios": {
      "const": ["OLD_STATE", "NEW_STATE", "MIXED_VERSION", "FAILED_MIGRATION", "INTERRUPTED_CUTOVER", "RECONCILIATION", "ROLLBACK"]
    },
    "cases": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "scenario", "source_state_sha256", "target_state_sha256", "observed_state_sha256", "rollback_state_sha256", "result", "evidence_sha256"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
          "scenario": {"enum": ["OLD_STATE", "NEW_STATE", "MIXED_VERSION", "FAILED_MIGRATION", "INTERRUPTED_CUTOVER", "RECONCILIATION", "ROLLBACK"]},
          "source_state_sha256": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
          "target_state_sha256": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
          "observed_state_sha256": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
          "rollback_state_sha256": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
          "result": {"enum": ["PASS", "FAIL", "PENDING"]},
          "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "independent_checker_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checked_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"},
    "privacy": {"$ref": "#/$defs/privacy"},
    "compatibility_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safe", "categories"],
      "properties": {
        "safe": {"const": true},
        "categories": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ABSOLUTE_PATH", "WORKTREE_PATH", "ENVIRONMENT_VALUE", "SECRET_LIKE_VALUE", "SESSION_OR_TASK_IDENTITY", "UNSAFE_PRIVATE_LINK"],
          "properties": {
            "ABSOLUTE_PATH": {"const": 0},
            "WORKTREE_PATH": {"const": 0},
            "ENVIRONMENT_VALUE": {"const": 0},
            "SECRET_LIKE_VALUE": {"const": 0},
            "SESSION_OR_TASK_IDENTITY": {"const": 0},
            "UNSAFE_PRIVATE_LINK": {"const": 0}
          }
        }
      }
    }
  }
}
